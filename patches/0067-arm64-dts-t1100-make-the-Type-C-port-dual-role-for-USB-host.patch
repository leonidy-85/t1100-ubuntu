 =?UTF-8?q?=D0=BA=D0=B8=D0=BD?= <py6on@yandex.ru>
Date: Sat, 14 Nov 2026 00:35:31 +0300
Subject: [PATCH] arm64: dts: t1100: make the Type-C port dual-role for USB host


Local T1100: makes the MT6370 TCPC dual-role and gives it the OTG VBUS
regulator, so Type-C switches CC to source/host when the user selects host.
With the xHCI unbind helper this lets a flash drive enumerate and returns to
device without a reboot (tested with a 7.4 GB Phison stick).

---
 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index 6eb433f..215a856 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -446,16 +446,20 @@
 			compatible = "mediatek,mt6370-tcpc";
 			interrupts-extended = <&pio 41 IRQ_TYPE_LEVEL_LOW>;
 			status = "okay";
+			vbus-supply = <&mt6370_otg_vbus>;
 
 			connector {
 				compatible = "usb-c-connector";
 				label = "USB-C";
 
-				power-role = "sink";
-				data-role = "device";
+				power-role = "dual";
+				data-role = "dual";
+				try-power-role = "sink";
 				typec-power-opmode = "default";
 				op-sink-microwatt = <18000000>;
 
+				source-pdos = <PDO_FIXED(5000, 3000,
+						 PDO_FIXED_USB_COMM)>;
 				sink-pdos = <PDO_FIXED(5000, 3000,
 						       PDO_FIXED_USB_COMM)
 					     PDO_FIXED(9000, 2000,
