 =?UTF-8?q?=D0=BA=D0=B8=D0=BD?= <py6on@yandex.ru>
Date: Fri, 13 Nov 2026 01:06:21 +0300
Subject: [PATCH 2/2] arm64: dts: t1100: enable GPU DVFS with a safe OPP subset

---
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 24 +++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index c4eff63..ad2635e 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -758,14 +758,27 @@
  * the rate the bootloader left. Revisit DVFS once VSRAM can be driven
  * together with VGPU (always-on coupling or a OPP table with both rails).
  */
+&gpu_opp_table {
+	/delete-node/ opp-300000000;
+	/delete-node/ opp-320000000;
+	/delete-node/ opp-340000000;
+	/delete-node/ opp-360000000;
+	/delete-node/ opp-380000000;
+	/delete-node/ opp-400000000;
+	/delete-node/ opp-420000000;
+	/delete-node/ opp-460000000;
+	/delete-node/ opp-500000000;
+	/delete-node/ opp-540000000;
+	/delete-node/ opp-580000000;
+	/delete-node/ opp-620000000;
+	/delete-node/ opp-653000000;
+};
+
 &gpu {
 	mali-supply = <&mt6358_vgpu_reg>;
-	/delete-property/ operating-points-v2;
 	status = "okay";
 };
 
-/* Only the GPU used it; leaving it behind would invite a DVFS enable by accident. */
-/delete-node/ &gpu_opp_table;
 
 /*
  * The two MFG power domains carry MTK_SCPD_DOMAIN_SUPPLY, and since 6.12
@@ -794,12 +807,15 @@
 &mt6358_vgpu_reg {
 	regulator-min-microvolt = <625000>;
 	regulator-max-microvolt = <900000>;
+	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
+	regulator-coupled-max-spread = <100000>;
 };
 
 &mt6358_vsram_gpu_reg {
 	regulator-min-microvolt = <850000>;
 	regulator-max-microvolt = <1000000>;
-	regulator-always-on;
+	regulator-coupled-with = <&mt6358_vgpu_reg>;
+	regulator-coupled-max-spread = <100000>;
 };
 
 /*
