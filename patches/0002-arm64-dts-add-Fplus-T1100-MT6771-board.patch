From e8d525f6a96adc2bddf9da2ef6d4ceb65f3e3b30 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Thu, 29 Oct 2026 03:23:35 +0300
Subject: [PATCH t1100 2/6] arm64: dts: add Fplus T1100 (MT6771) board

Board file for the Fplus T1100 tablet (MT6771/MT8788, 4 GiB, BOE
1600x2176 in-cell panel). Everything is taken from the live FDT of
the stock kernel with its DTBO overlays
(refs/device/fdt-live.dts.gz):

 - model/compatible: "Fplus T1100", "fplus,t1100"
 - chosen: console/earlycon/ramoops bootargs
 - LCM power/reset GPIOs (dvdd 55, rst 45, stby 44, bl 56,
   ext_pwr 175, touch 158/163) as an "elink,lcm" node
 - "mediatek,lcd-backlight" with led_mode = 5
 - Himax touch controller at 0x48 on i2c0

None of the board devices have a mainline driver yet, so every node
is disabled and only documents the wiring. i2c0 stays disabled too:
it needs the infracfg main/dma clocks from the (not yet written)
clk-mt6771 driver.

The DTB is enabled unconditionally for ARCH_MEDIATEK.
---
 arch/arm64/boot/dts/mediatek/Makefile         |  1 +
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 75 +++++++++++++++++++
 2 files changed, 76 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index 8fd7b2bb7..b40e56724 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6771-fplus-t1100.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6779-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
new file mode 100644
index 000000000..e78746342
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Fplus T1100 — 10.1" tablet, MediaTek MT6771 (sold as MT8788),
+ * 4 GiB DDR, BOE 1600x2176 panel, in-cell Himax touch.
+ *
+ * Board data (LCM power/reset GPIOs, backlight mode, touch controller) is
+ * taken from the live FDT of the stock kernel together with its DTBO
+ * overlays: refs/device/fdt-live.dts.gz. Vendor-specific node and property
+ * names are kept byte-identical to that overlay so the mapping stays
+ * traceable; they are placeholders for mainline drivers and stay disabled.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "mt6771.dtsi"
+
+/ {
+	model = "Fplus T1100";
+	compatible = "fplus,t1100", "mediatek,mt6771";
+
+	/*
+	 * Board nodes of the stock ODM overlay. Plain container: they have no
+	 * "simple-bus" compatible because nothing below is bound yet and the
+	 * nodes carry no reg property.
+	 */
+	odm {
+
+		/*
+		 * LCD power/reset sequencing as done by the stock ODM overlay:
+		 *   dvdd 55, rst 45, stby 44, bl 56, ext_pwr 175,
+		 *   touch reset 158, touch avdd 163.
+		 * No mainline driver yet (panel is driven by the LCM driver in
+		 * the stock boot image) — kept disabled.
+		 */
+		lcm {
+			compatible = "elink,lcm";
+			dvdd-gpios = <&pio 55 GPIO_ACTIVE_HIGH>;
+			rst-gpios = <&pio 45 GPIO_ACTIVE_HIGH>;
+			stby-gpios = <&pio 44 GPIO_ACTIVE_HIGH>;
+			bl-gpios = <&pio 56 GPIO_ACTIVE_HIGH>;
+			ext-pwr-gpios = <&pio 175 GPIO_ACTIVE_HIGH>;
+			ts-rst-gpios = <&pio 158 GPIO_ACTIVE_HIGH>;
+			ts-avdd-gpios = <&pio 163 GPIO_ACTIVE_HIGH>;
+			status = "disabled";
+		};
+
+		/* Stock overlay: led_mode = 5 (pwm_config = <4 0 0 0 0>). */
+		lcd-backlight {
+			compatible = "mediatek,lcd-backlight";
+			led_mode = <5>;
+			data = <1>;
+			pwm_config = <4 0 0 0 0>;
+			status = "disabled";
+		};
+	};
+};
+
+&chosen {
+	bootargs = "console=ttyS0,921600n8 earlycon=mtk8250,0x11002000 maxcpus=1 panic=10 pstore.backend=ramoops";
+};
+
+&i2c0 {
+	/* Needs the clk-mt6771 gates and a Himax touchscreen driver. */
+	status = "disabled";
+
+	himax_touch@48 {
+		compatible = "mediatek,himax_touch";
+		reg = <0x48>;
+		/* Stock EINT spec: <eint irq_type debounce 0>, EINT 1. */
+		interrupt-parent = <&pio>;
+		interrupts = <1 1 1 0>;
+		status = "disabled";
+	};
+};
