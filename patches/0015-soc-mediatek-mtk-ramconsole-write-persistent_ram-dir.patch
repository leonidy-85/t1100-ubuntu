+/* ------------------------------------------------------------------ */
+/* persistent_ram writes                                               */
+/* ------------------------------------------------------------------ */
+
+/* struct persistent_ram_buffer { u32 sig; atomic_t start; atomic_t size; } */
+static void mrc_kick(void)
+{
+	writel(mrc.start, mrc.base + 4);
+	writel(mrc.len, mrc.base + 8);
+}
 
-static void mrcm_kick(void)
+static void mrc_flush(void)
 {
-	writel(mrcm_start, mrcm_base + 4);
-	writel(mrcm_len, mrcm_base + 8);
+	if (!mrc.cached)
