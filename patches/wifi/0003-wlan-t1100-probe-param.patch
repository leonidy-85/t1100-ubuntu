 /*----------------------------------------------------------------------------*/
 /*!
+ * \brief T1100: power CONSYS on and bring the AHB Wi-Fi HIF up (M6 milestone).
+ *
+ * The vendor flow reaches HifAhbProbe() from WMT as the "wmt func on (WIFI)"
+ * callback, after opfunc_pwr_on() has powered the chip. That path runs through
+ * wmt_core_stp_init() and needs an STP transport (UART/SDIO/BTIF); on this
+ * mainline port all of them are stubs, so the callback is never reached and no
+ * netdev is created. AHB Wi-Fi itself does not use STP, so:
+ *   1) power the chip with wmt_plat_pwr_ctrl(FUNC_ON) -- the same per-chip
+ *      power-on opfunc_pwr_on() calls first, no STP involved;
+ *   2) do what HifAhbProbe() does before probing, but without the
+ *      pfWlanRemove() rollback, so a failed attempt leaves the module loaded
+ *      (and the box alive) instead of tearing down a half-initialized glue.
+ *
+ * initWlan() calls this when the module is inserted with t1100_probe=1;
+ * default (0) keeps the vendor behaviour untouched.
+ */
+extern int wmt_plat_pwr_ctrl(int state);	/* exported by wmt_drv (FUNC_ON = 0) */
+
+int t1100_wlan_probe(VOID)
+{
+	int ret;
+
+	DBGLOG(INIT, INFO, "t1100_wlan_probe: chip power on\n");
+	ret = wmt_plat_pwr_ctrl(0);	/* ENUM_FUNC_STATE: FUNC_ON */
+	DBGLOG(INIT, INFO, "t1100_wlan_probe: wmt_plat_pwr_ctrl(FUNC_ON) = %d\n", ret);
+	if (ret) {
+		DBGLOG(INIT, ERROR, "t1100_wlan_probe: chip power on failed\n");
+		return ret;
+	}
+
+	DBGLOG(INIT, INFO, "t1100_wlan_probe: paldo on + wlanProbe\n");
+	mtk_wcn_consys_hw_wifi_paldo_ctrl(1);	/* power on WiFi TX PA 3.3V */
+	ret = (int) pfWlanProbe((PVOID) &HifAhbPDev->dev);
+	DBGLOG(INIT, INFO, "t1100_wlan_probe: wlanProbe returned %d\n", ret);
+	return ret;
+}
