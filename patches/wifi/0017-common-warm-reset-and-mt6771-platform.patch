+	struct regmap *pmic = t1100_pmic_regmap();
+	void __iomem *pwrap;
+	UINT32 val;
+	INT32 ret;
+
+	if (!enable) {
+		/* Keep the buffer on: VCN33 is always-on in DT and a dangling
+		 * SRCLKEN request from a half-dead chip is worse than a few mA.
