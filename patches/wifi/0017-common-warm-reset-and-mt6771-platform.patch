+		ret = regmap_update_bits(pmic, T1100_MT6358_DCXO_CW00,
+					 T1100_XO_EXTBUF2_MODE_MASK <<
+					 T1100_XO_EXTBUF2_MODE_SHIFT,
+					 T1100_XO_EXTBUF2_WCN_EN_M <<
