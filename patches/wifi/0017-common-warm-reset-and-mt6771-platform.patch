+/*
+ * T1100 M54: warm CONSYS reset - only the AP_RGU CPU reset bit, without SPM
+ * isolation, SRAM power-down or power gating.  The MCU memory (and therefore
+ * the patch downloaded into it) is supposed to survive it.
+ */
+/*
+ * T1100 M59: SPM-partial reset - isolation + SW reset only, without SRAM_PD,
+ * CLK_DIS and without power-gating the domain, so MCU memory (and the
+ * downloaded image) is expected to survive.
+ *   0x1000632C[1] = conn_top1_iso_en (1 = isolated)
+ *   0x1000632C[0] = conn_ap_sw_rst_b (0 = reset asserted, 1 = released)
+ */
+INT32 consys_hw_spm_partial_reset(VOID)
+{
+	void __iomem *r = ioremap(0x1000632c, 4);
+	UINT32 v0, v1, v2, v3;
+
+	if (!r) {
+		WMT_PLAT_PR_ERR("t1100: spm partial: ioremap failed\n");
+		return -1;
+	}
+	v0 = readl(r);
+	WMT_PLAT_PR_INFO("t1100: spm partial: 0x1000632c before = 0x%08x\n", v0);
+	writel((v0 | CONSYS_SPM_PWR_ISO_S_BIT) & ~CONSYS_SPM_PWR_RST_BIT, r);
+	v1 = readl(r);
+	WMT_PLAT_PR_INFO("t1100: spm partial: iso+rst asserted = 0x%08x\n", v1);
+	mdelay(10);
+	writel((v1 | CONSYS_SPM_PWR_RST_BIT) & ~CONSYS_SPM_PWR_ISO_S_BIT, r);
+	v2 = readl(r);
+	WMT_PLAT_PR_INFO("t1100: spm partial: iso released, rst released = 0x%08x\n", v2);
+	mdelay(50);
+	v3 = readl(r);
+	WMT_PLAT_PR_INFO("t1100: spm partial: final = 0x%08x\n", v3);
+	iounmap(r);
+	return 0;
+}
