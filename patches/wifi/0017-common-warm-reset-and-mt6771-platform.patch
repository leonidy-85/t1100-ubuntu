+#define T1100_MT6358_DCXO_CW00		0x788
+#define T1100_MT6358_TOP_SPI_CON1	0x44e
+#define T1100_XO_EXTBUF2_MODE_MASK	0x3
+#define T1100_XO_EXTBUF2_MODE_SHIFT	3
+#define T1100_XO_EXTBUF2_WCN_EN_M	0x0
+#define T1100_RG_SRCLKEN_IN3_EN_MASK	0x1
+#define T1100_RG_SRCLKEN_IN3_EN_SHIFT	0
