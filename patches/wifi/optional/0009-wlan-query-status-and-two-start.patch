 extern int t1100_probe_stage;
 
+/* Read-only probe of the STP function register block (see t1100_stp_probe()). */
+int t1100_stp_probe_en = 1;
+module_param(t1100_stp_probe_en, int, 0444);
+MODULE_PARM_DESC(t1100_stp_probe_en, "T1100: dump the STP/function-0/1/2 HIF registers once after power on");
+
+/*
+ * T1100 M21: STP register block probe.
+ *
+ * The WMT/STP channel of the same chip is an SDIO *function* of its own
+ * (common_main/linux/include/stp_sdio.h):
+ *
+ *   CCIR 0x00  CHLPCR 0x04  CSDIOCSR 0x08  CHCR 0x0c
+ *   CHISR 0x10 CHIER 0x14   CTDR 0x18      CRDR 0x1c  CTFSR 0x20
+ *
+ * i.e. exactly the offsets of the WLAN HIF (WCIR/WHLPCR/WSDIOCSR/WHCR/
+ * WHISR/WHIER/... in include/nic/mt6630_reg.h), which is why the two are easy
+ * to confuse: same block, different function. The WLAN driver only ever talks
+ * to function 1 (SDIO_GEN3_FUNCTION_WIFI, sdio_bus_driver.c:sdio_open()), so
+ * this probe reads the same offsets through CMD53 with function 0/1/2 and
+ * prints what comes back. Read-only; the answer decides whether a minimal STP
+ * transport ("STP over the AHB command port") is possible at all.
+ */
+static UINT32 t1100_cmd53_read(UINT32 func, UINT32 addr)
+{
+	sdio_gen3_cmd53_info info;
+	UINT32 val;
+
+	info.word = 0;
+	info.field.rw_flag = SDIO_GEN3_READ;
+	info.field.func_num = func;
+	info.field.block_mode = SDIO_GEN3_BYTE_MODE;
+	info.field.op_mode = SDIO_GEN3_FIXED_PORT_MODE;
+	info.field.addr = addr;
+	info.field.count = 4;
+
+	writel(info.word, (void *)(*g_pHifRegBaseAddr + SDIO_GEN3_CMD_SETUP));
+	val = readl((void *)(*g_pHifRegBaseAddr + SDIO_GEN3_CMD53_DATA));
+	return val;
+}
+
+void t1100_stp_probe(void)
+{
+	static const UINT32 au4Off[7] = { 0x00, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c };
+	UINT32 f, i;
+
+	static int done;
+
+	if (done)
+		return;
+	if (!g_pHifRegBaseAddr || !*g_pHifRegBaseAddr) {
+		pr_info("t1100-stp: HIF base not set yet, probe skipped\n");
+		return;
+	}
+	done = 1;
+
+	for (f = 0; f <= 2; f++) {
+		pr_info("t1100-stp: func%u:", f);
+		for (i = 0; i < 7; i++) {
+			UINT32 v = t1100_cmd53_read(f, au4Off[i]);
+
+			pr_info(" %02x=%08x", au4Off[i], v);
+		}
+		pr_info("\n");
+	}
+	pr_info("t1100-stp: func2 CTFSR(0x20)=%08x CHISR(0x10)=%08x CCIR(0x0)=%08x\n",
+		t1100_cmd53_read(2, 0x20), t1100_cmd53_read(2, 0x10),
+		t1100_cmd53_read(2, 0x00));
+}
