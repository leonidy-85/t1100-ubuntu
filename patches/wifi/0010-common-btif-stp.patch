+static void t1100_btif_boot_work(struct work_struct *work)
+{
+	P_OSAL_OP pOp;
+	MTK_WCN_BOOL bRet;
+
+	WMT_INFO_FUNC("t1100: STP over BTIF: hif conf\n");
+	/*
+	 * wmt_lib_set_hif() also decodes the FM nibble and rejects a zero one
+	 * ("invalid fm mode"), so the argument is STP mode | FM mode << 4.
+	 */
+	if (wmt_lib_set_hif(STP_BTIF_FULL | (WMT_FM_COMM << 4))) {
+		WMT_ERR_FUNC("t1100: wmt_lib_set_hif(STP_BTIF_FULL) failed\n");
+		return;
+	}
