 struct stp_btif g_stp_btif;
+/*
+ * T1100 M50: STP frame / BTIF transport trace.  The vendor stack has no padding
+ * and no CRC over anything but the payload, so the only remaining difference on
+ * the wire can be shown here: full frame hex (STP header + payload + 2 CRC),
+ * the BTIF LSR/IIR before and after the write and the count actually written.
+ */
+#include <linux/io.h>
+#include <linux/module.h>
+
+#define T1100_BTIF_PA 0x1100c000
+#define T1100_BTIF_LSR 0x14
+#define T1100_BTIF_IIR 0x08
+
+static int t1100_stp_trace;
+module_param(t1100_stp_trace, int, 0444);
+MODULE_PARM_DESC(t1100_stp_trace, "T1100: trace STP frames and BTIF TX state");
+static int t1100_frame_hex = 1;
+module_param(t1100_frame_hex, int, 0444);
+MODULE_PARM_DESC(t1100_frame_hex, "T1100: full hex of every short frame + first long frame");
+/* only the ROMv4 patch download path may be re-sent (set in wmt_ctrl.c) */
+extern int t1100_patch_active;
+static int t1100_trace_all;
+module_param(t1100_trace_all, int, 0444);
+MODULE_PARM_DESC(t1100_trace_all, "T1100: trace every STP frame, not just short ones");
+static int t1100_tail_resend;
+module_param(t1100_tail_resend, int, 0444);
+MODULE_PARM_DESC(t1100_tail_resend, "T1100: resend short frames (100..199 B) N times");
+
+static void __iomem *t1100_btif;
+static int t1100_big_dumped;
+
+static u32 t1100_btif_reg(u32 off)
+{
+	if (!t1100_btif)
+		t1100_btif = ioremap(T1100_BTIF_PA, 0x1000);
+	return t1100_btif ? readl(t1100_btif + off) : 0;
+}
+
+static void t1100_stp_dump(const PUINT8 b, UINT32 len)
+{
+	UINT32 off;
+
+	for (off = 0; off < len; off += 32) {
+		UINT32 n = (len - off) > 32 ? 32 : (len - off);
+
+		WMT_INFO_FUNC("t1100: stpx %03u/%u %*phN\n", off, len, (int)n, b + off);
+	}
+}
+
