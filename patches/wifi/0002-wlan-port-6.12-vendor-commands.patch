From: bringup <bringup@t1100.local>
Subject: [PATCH] wlan: do not register vendor commands on 6.12

6.12 enforces a non-NULL policy for every wiphy vendor command
(WARN_ON(!rdev->wiphy.vendor_commands[i].policy) in wiphy_register()), and
initWlan() then fails with -1. mtk_*_vendor_ops[] has no .policy (4.14
allowed NULL) and only backs MTK private iwpriv ioctls; nl80211 and
wpa_supplicant do not use them. Register none instead of patching every
entry.

---
--- a/os/linux/gl_init.c
+++ b/os/linux/gl_init.c
@@ -1653,8 +1653,17 @@
 #endif
 	prWiphy->max_remain_on_channel_duration = 5000;
 	prWiphy->mgmt_stypes = mtk_cfg80211_ais_default_mgmt_stypes;
-	prWiphy->vendor_commands = mtk_wlan_vendor_ops;
-	prWiphy->n_vendor_commands = sizeof(mtk_wlan_vendor_ops) / sizeof(struct wiphy_vendor_command);
+	/*
+	 * 6.12 rejects a vendor command whose policy is NULL:
+	 *   WARN_ON(!rdev->wiphy.vendor_commands[i].policy) in
+	 *   net/wireless/core.c:wiphy_register() -> initWlan returns -1.
+	 * mtk_*_vendor_ops[] predates the mandatory policy (4.14 accepted
+	 * NULL); the commands only serve MTK's private iwpriv ioctls, which
+	 * nothing on Ubuntu uses (nl80211/wpa_supplicant need none of them).
+	 * Register no vendor commands rather than fixing every entry.
+	 */
+	prWiphy->vendor_commands = NULL;
+	prWiphy->n_vendor_commands = 0;
 	prWiphy->vendor_events = mtk_wlan_vendor_events;
 	prWiphy->n_vendor_events = ARRAY_SIZE(mtk_wlan_vendor_events);
 
--- a/os/linux/gl_p2p.c
+++ b/os/linux/gl_p2p.c
@@ -877,8 +877,17 @@
 	prWiphy->max_scan_ssids = MAX_SCAN_LIST_NUM;
 	prWiphy->max_scan_ie_len = MAX_SCAN_IE_LEN;
 	prWiphy->signal_type = CFG80211_SIGNAL_TYPE_MBM;
-	prWiphy->vendor_commands = mtk_p2p_vendor_ops;
-	prWiphy->n_vendor_commands = sizeof(mtk_p2p_vendor_ops) / sizeof(struct wiphy_vendor_command);
+	/*
+	 * 6.12 rejects a vendor command whose policy is NULL:
+	 *   WARN_ON(!rdev->wiphy.vendor_commands[i].policy) in
+	 *   net/wireless/core.c:wiphy_register() -> initWlan returns -1.
+	 * mtk_*_vendor_ops[] predates the mandatory policy (4.14 accepted
+	 * NULL); the commands only serve MTK's private iwpriv ioctls, which
+	 * nothing on Ubuntu uses (nl80211/wpa_supplicant need none of them).
+	 * Register no vendor commands rather than fixing every entry.
+	 */
+	prWiphy->vendor_commands = NULL;
+	prWiphy->n_vendor_commands = 0;
 
 #ifdef CONFIG_PM
 	prWiphy->wowlan = &mtk_p2p_wowlan_support;
