+/*
+ * T1100 port (mainline 6.12): the physical base/size of the CONNSYS shared RAM
+ * are a *reserved-memory* region now, not a pair of globals filled in by
+ * mtk_wcn_consys_hw (the vendor kernel got them from
+ * drivers/misc/mediatek/connectivity/wmt_plat). The stock MT6771 tree gives
+ * the region a size and an alloc window instead of a fixed address, so the
+ * kernel picks the address; read it back through the phandle:
+ *
+ *	consys@18070000 { memory-region = <&consys_reserve_memory>; };
+ *	reserved-memory { consys-reserve-memory { size = <0 0x200000>; ... }; };
+ *
+ * of_reserved_mem_lookup() returns the region the early OF code actually
+ * reserved (works for both fixed `reg' and alloc-ranges regions);
+ * of_address_to_resource() is the fallback for a plain `reg' node.
+ */
+static VOID mtk_wmt_consys_emi_from_dt(struct platform_device *pdev)
+{
+	struct device_node *mem_node;
+	struct reserved_mem *rmem;
+	struct resource res = { 0 };
+
+	if (gConEmiPhyBase)
+		return;
+
+	mem_node = of_parse_phandle(pdev->dev.of_node, "memory-region", 0);
+	if (!mem_node) {
+		WMT_PLAT_PR_ERR("no memory-region phandle in the CONSYS node\n");
+		return;
+	}
+
+	rmem = of_reserved_mem_lookup(mem_node);
+	if (rmem && rmem->size) {
+		gConEmiPhyBase = rmem->base;
+		gConEmiSize = rmem->size;
+	} else if (of_address_to_resource(mem_node, 0, &res) == 0 && res.end > res.start) {
+		gConEmiPhyBase = res.start;
+		gConEmiSize = resource_size(&res);
+	}
+	of_node_put(mem_node);
+
+	if (!gConEmiPhyBase || !gConEmiSize) {
+		WMT_PLAT_PR_ERR("CONNSYS EMI region unusable, EMI remap/MPU/coredump stay off\n");
+		return;
+	}
+
+	WMT_PLAT_PR_INFO("CONNSYS EMI from DT: phys 0x%pa size 0x%pa\n",
+			 &gConEmiPhyBase, &gConEmiSize);
+}
