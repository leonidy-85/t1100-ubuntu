diff -u -N -r a/include/t1100_stp_hif.h b/include/t1100_stp_hif.h
--- a/include/t1100_stp_hif.h	1970-01-01 03:00:00.000000000 +0300
+++ b/include/t1100_stp_hif.h	2026-11-16 00:23:55.225871378 +0300
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * t1100_stp_hif.h - optional STP/BTIF transport for the WLAN ROM init-cmd
+ *                   protocol (MT6771 / MT6631, Fplus T1100).
+ *
+ * Background (docs/wifi-port-log.md, M82/M83):
+ *
+ *   The ROMv4 patch set for chip id 0x0788 is delivered by wmt_drv over
+ *   BTIF/STP, and after that delivery the AHB/MCIF window at 0x180f0000 reads
+ *   all-zero from the WLAN driver, so the vendor init-cmd path
+ *   (nicTxInitCmd() -> MCR_WTDR1 + nicRxWaitResponse() -> MCR_WRPLR) times out
+ *   on the very first section-config.
+ *
+ *   The hypothesis "the patched MCU wants the init-cmd protocol over STP" is
+ *   what this transport tests.  It is *off by default*: with
+ *   t1100_hif=T1100_HIF_MCIF (0) the driver behaves exactly like the vendor
+ *   one.  With t1100_hif=T1100_HIF_STP (1) the four firmware-download commands
+ *   plus WIFI_START are framed byte for byte as before (INIT_HIF_TX_HEADER_T +
+ *   payload) and pushed through wmt_drv's STP API on channel
+ *   WIFI_TASK_INDX (3) instead of the MCIF rings; replies are taken from the
+ *   same STP channel.
+ *
+ *   Note that this can only ever be a probe, not a fix: the WLAN data path
+ *   (TX/RX descriptor rings, WFDMA, interrupts) and the "ready" indication
+ *   (WCIR_WLAN_READY) live in the MCIF block and have no STP equivalent, and
+ *   the stock 4.14 wlan_drv_gen3.ko imports no STP symbol at all.
+ */
+#ifndef _T1100_STP_HIF_H_
+#define _T1100_STP_HIF_H_
+
+#define T1100_HIF_MCIF	0	/* vendor AHB/MCIF path (default) */
+#define T1100_HIF_STP	1	/* STP/BTIF channel 3 (experiment) */
+
+/* t1100_hif module parameter, defined in os/linux/t1100_stp_hif.c */
+extern int t1100_hif;
+
+/* Per-frame reply timeout, ms (t1100_stp_timeout_ms module parameter). */
+extern int t1100_stp_timeout_ms;
+
+/*
+ * TRUE when the STP transport is selected *and* the STP link is up
+ * (mtk_wcn_stp_is_ready()).  Cheap enough to call per command.
+ */
+int t1100_stp_ready(void);
+
+/*
+ * Send one complete init-cmd frame (INIT_HIF_TX_HEADER_T + payload) on STP
+ * channel 3.  Returns the number of bytes accepted or a negative errno.
+ */
+int t1100_stp_send_frame(const unsigned char *pucFrame, unsigned int u4Len);
+
+/*
+ * Wait for one init-cmd frame on STP channel 3.  Returns the frame length
+ * (> 0) or a negative errno on timeout.
+ */
+int t1100_stp_wait_frame(unsigned char *pucBuf, unsigned int u4Len,
+			 unsigned int u4TimeoutMs);
+
+/* One-line + hex dump of a frame (tag is a short literal). */
+void t1100_stp_dump(const char *pcTag, const unsigned char *pucBuf,
+		    unsigned int u4Len);
+
+#endif /* _T1100_STP_HIF_H_ */
diff -u -N -r a/os/linux/t1100_stp_hif.c b/os/linux/t1100_stp_hif.c
--- a/os/linux/t1100_stp_hif.c	1970-01-01 03:00:00.000000000 +0300
+++ b/os/linux/t1100_stp_hif.c	2026-11-16 00:31:46.516796052 +0300
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * t1100_stp_hif.c - optional STP/BTIF transport for the WLAN ROM init-cmd
+ *                   protocol (MT6771 / MT6631, Fplus T1100).
+ *
+ * Part of the MT6771 port, phase 5 (docs/wifi-port-log.md, M82/M83).
+ *
+ * Why this file exists
+ * --------------------
+ * wmt_drv brings CONSYS up over BTIF/STP and delivers both stock ROMv4 patches
+ * (ROMv4_be_patch_1_1_hdr.bin, then ROMv4_be_patch_1_0_hdr.bin) on that link.
+ * After that the AHB/MCIF register window of the WLAN HIF (0x180f0000) reads
+ * back all-zero from wlan_drv_gen3, so the vendor init-cmd path
+ * (nicTxInitCmd() -> MCR_WTDR1, nicRxWaitResponse() -> MCR_WRPLR) times out on
+ * the first download-config and the probe fails.
+ *
+ * This transport is the *experiment* that answers "does the MCU accept the
+ * init-cmd frames on the STP WIFI channel instead": the frames are built
+ * exactly as before and handed to wmt_drv's exported STP API
+ * (mtk_wcn_stp_send_data(..., WIFI_TASK_INDX)), replies are taken from the
+ * same channel through mtk_wcn_stp_register_event_cb() +
+ * mtk_wcn_stp_receive_data().
+ *
+ * It is not enabled by default and must not become the default: the WLAN data
+ * path (TX/RX rings, WFDMA, MHISR/WHISR interrupts) and the firmware "ready"
+ * bit (WCIR_WLAN_READY) live in the MCIF block.  Even if the MCU answered
+ * every init-cmd on STP there is no STP equivalent for the rest, and the stock
+ * 4.14 wlan_drv_gen3.ko imports no STP symbol at all (only the WMT reset /
+ * registration helpers), i.e. the shipped driver never uses this path.
+ *
+ * Does not replace anything unless t1100_hif=1 is passed to insmod; see
+ * include/t1100_stp_hif.h for the API and wlan_lib.c for the call sites.
+ */
+#include "precomp.h"
+
+#include <linux/moduleparam.h>
+#include <linux/wait.h>
+#include <linux/jiffies.h>
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/printk.h>
+
+#include "t1100_stp_hif.h"
+
+/*
+ * Channel numbers of the STP protocol.  WIFI_TASK_INDX is 3 in the vendor
+ * header (common_main/include/stp_exp.h: BT=0, FM=1, GPS=2, WIFI=3, WMT=4).
+ * The value is repeated here because the wlan module does not compile against
+ * the common tree's headers (only its exported symbols).
+ */
+#define T1100_STP_WIFI_TASK	3
+
+/*
+ * STP API of wmt_drv (common_main/core/stp_core.c).  Declared locally for the
+ * same reason: stp_exp.h lives in the wmt_drv source tree.  All four are in
+ * wmt_drv's KSYMTAB_FUNC list, i.e. exported to modules.
+ *
+ *   The vendor prototypes use the WMT types (INT32/PUINT8/UINT8); this module
+ *   is compiled against the WLAN type set (INT_32/PUINT_8/UINT_8), and the two
+ *   are the same underlying C types on arm64, so the declarations below are
+ *   ABI-identical.  MTK_WCN_BOOL is an int-sized enum (FALSE == 0).
+ */
+extern INT_32 mtk_wcn_stp_send_data(const PUINT_8 buffer, const UINT_32 length,
+				    const UINT_8 type);
+extern INT_32 mtk_wcn_stp_receive_data(PUINT_8 buffer, UINT_32 length,
+				       UINT_8 type);
+extern INT_32 mtk_wcn_stp_is_ready(VOID);
+extern INT_32 mtk_wcn_stp_is_rxqueue_empty(UINT_8 type);
+extern INT_32 mtk_wcn_stp_register_event_cb(INT_32 type, void (*func)(void));
+
+/* 0 = vendor MCIF/AHB path, 1 = STP experiment.  See the file comment. */
+int t1100_hif = T1100_HIF_MCIF;
+module_param(t1100_hif, int, 0444);
+MODULE_PARM_DESC(t1100_hif,
+		 "T1100: init-cmd transport, 0 = MCIF/AHB (vendor, default), 1 = STP/BTIF channel 3");
+
+int t1100_stp_timeout_ms = 1000;
+module_param(t1100_stp_timeout_ms, int, 0444);
+MODULE_PARM_DESC(t1100_stp_timeout_ms,
+		 "T1100: reply timeout for one init-cmd frame on the STP channel (ms)");
+
+static DECLARE_WAIT_QUEUE_HEAD(t1100_stp_wq);
+static atomic_t t1100_stp_rx_events = ATOMIC_INIT(0);
+static unsigned int t1100_stp_tx_logs;	/* first few frames only, dmesg */
+static unsigned int t1100_stp_rx_logs;
+
+/*
+ * Called by the STP core (stp_exp.c:mtk_wcn_sys_event_set()) from the BTIF RX
+ * thread when a packet of channel 3 has been enqueued.  Only wake the waiter;
+ * the data is pulled with mtk_wcn_stp_receive_data().
+ */
+static void t1100_stp_rx_event(void)
+{
+	atomic_inc(&t1100_stp_rx_events);
+	wake_up_interruptible(&t1100_stp_wq);
+}
+
+void t1100_stp_dump(const char *pcTag, const unsigned char *pucBuf,
+		    unsigned int u4Len)
+{
+	if (!pucBuf || !u4Len)
+		return;
+	print_hex_dump(KERN_INFO, pcTag, DUMP_PREFIX_OFFSET, 16, 1, pucBuf,
+		       u4Len > 64 ? 64 : u4Len, true);
+}
+
+int t1100_stp_ready(void)
+{
+	static int t1100_stp_ready_logged;
+
+	if (t1100_hif != T1100_HIF_STP)
+		return 0;
+	if (mtk_wcn_stp_is_ready() == 0) {
+		if (!t1100_stp_ready_logged) {
+			t1100_stp_ready_logged = 1;
+			pr_warn("t1100-stp: transport selected but the STP link is not ready\n");
+		}
+		return 0;
+	}
+	return 1;
+}
+
+int t1100_stp_send_frame(const unsigned char *pucFrame, unsigned int u4Len)
+{
+	unsigned int u4Tries;
+	INT_32 i4Ret = 0;
+
+	static int t1100_stp_registered;
+
+	if (!t1100_stp_registered) {
+		/*
+		 * Register before the first TX: the STP core only enqueues RX
+		 * packets of a channel whose event callback is installed
+		 * (stp_exp.c:mtk_wcn_sys_check_function_status()), and the
+		 * registration also flushes the channel's stale RX ring.
+		 */
+		t1100_stp_registered = 1;
+		i4Ret = mtk_wcn_stp_register_event_cb(T1100_STP_WIFI_TASK,
+						     t1100_stp_rx_event);
+		pr_info("t1100-stp: register ch%u cb -> %d, link ready=%d\n",
+			T1100_STP_WIFI_TASK, i4Ret, mtk_wcn_stp_is_ready());
+	}
+
+	/*
+	 * mtk_wcn_stp_send_data() returns the accepted length, 0 when there is
+	 * no window space / no TX queue (the caller is expected to retry), or
+	 * the length when the link is closed / a coredump is in progress
+	 * (packet dropped).  Only a full-length return means "handed over".
+	 */
+	for (u4Tries = 0; u4Tries < 3; u4Tries++) {
+		i4Ret = mtk_wcn_stp_send_data((PUINT_8)pucFrame, u4Len,
+					      T1100_STP_WIFI_TASK);
+		if (i4Ret == (INT_32)u4Len)
+			break;
+		msleep(3);
+	}
+
+	if (t1100_stp_tx_logs++ < 4) {
+		pr_info("t1100-stp: tx len=%u -> %d (try %u) cid=0x%02x seq=%u\n",
+			u4Len, i4Ret, u4Tries + 1,
+			u4Len > 6 ? pucFrame[4] : 0, u4Len > 7 ? pucFrame[7] : 0);
+		t1100_stp_dump("t1100-stp-tx: ", pucFrame, u4Len);
+	}
+
+	return i4Ret == (INT_32)u4Len ? (int)u4Len : -EIO;
+}
+
+int t1100_stp_wait_frame(unsigned char *pucBuf, unsigned int u4Len,
+			 unsigned int u4TimeoutMs)
+{
+	unsigned int u4Elapsed = 0;
+	INT_32 i4Ret;
+
+	if (!pucBuf || !u4Len)
+		return -EINVAL;
+
+	while (u4Elapsed <= u4TimeoutMs) {
+		if (mtk_wcn_stp_is_rxqueue_empty(T1100_STP_WIFI_TASK) == 0) {
+			i4Ret = mtk_wcn_stp_receive_data(pucBuf, u4Len,
+							T1100_STP_WIFI_TASK);
+			if (i4Ret > 0) {
+				if (t1100_stp_rx_logs++ < 4) {
+					pr_info("t1100-stp: rx len=%d eid=%u seq=%u\n",
+						i4Ret, u4Len > 4 ? pucBuf[4] : 0,
+						i4Ret > 7 ? pucBuf[7] : 0);
+					t1100_stp_dump("t1100-stp-rx: ", pucBuf,
+						       i4Ret);
+				}
+				return i4Ret;
+			}
+		}
+		/* the callback wakes us early; the poll keeps it simple */
+		wait_event_interruptible_timeout(t1100_stp_wq,
+						 atomic_read(&t1100_stp_rx_events),
+						 msecs_to_jiffies(20));
+		atomic_set(&t1100_stp_rx_events, 0);
+		u4Elapsed += 20;
+	}
+
+	pr_info("t1100-stp: rx timeout after %u ms\n", u4TimeoutMs);
+	return -ETIMEDOUT;
+}
