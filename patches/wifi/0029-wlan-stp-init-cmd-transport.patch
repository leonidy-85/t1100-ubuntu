 /* Generic single init command with a payload; returns the MCU CMD_RESULT. */
+/*
+ * T1100 M83: the two HIF primitives of the firmware-download command set,
+ * behind a transport switch.
+ *
+ * The vendor code sends every init-cmd by handing the finished
+ * INIT_HIF_TX_HEADER_T frame to nicTxInitCmd() (-> MCR_WTDR1 / WFDMA) and
+ * reads the reply with nicRxWaitResponse() (-> MCR_WRPLR / MCR_WRDR0).  With
+ * t1100_hif=T1100_HIF_STP both are replaced by the STP channel-3 calls of
+ * os/linux/t1100_stp_hif.c; with the default (T1100_HIF_MCIF) they are exactly
+ * the vendor functions, so nothing changes unless the module parameter is
+ * passed to insmod.
+ *
+ * Only the firmware-download commands (download-config, scatter download,
+ * query-pending-error, cmd-result, WIFI_START) use these helpers.  The
+ * runtime command path keeps using nicTxInitCmd()/nicRxWaitResponse()
+ * directly: STP has no equivalent for the TX/RX descriptor rings.
+ */
+static WLAN_STATUS
+t1100_tx_init_cmd(P_ADAPTER_T prAdapter, P_CMD_INFO_T prCmdInfo)
+{
+	if (t1100_hif == T1100_HIF_STP && t1100_stp_ready()) {
+		int i4Ret = t1100_stp_send_frame(prCmdInfo->pucInfoBuffer,
+						 prCmdInfo->u2InfoBufLen);
+
+		return i4Ret == (int)prCmdInfo->u2InfoBufLen ?
+		       WLAN_STATUS_SUCCESS : WLAN_STATUS_FAILURE;
+	}
+	return nicTxInitCmd(prAdapter, prCmdInfo);
+}
+
+static WLAN_STATUS
+t1100_rx_wait_response(P_ADAPTER_T prAdapter, UINT_8 ucPortIdx,
+		       PUINT_8 pucRspBuffer, UINT_32 u4MaxRespBufferLen,
+		       PUINT_32 pu4Length)
+{
+	if (t1100_hif == T1100_HIF_STP && t1100_stp_ready()) {
+		int i4Ret = t1100_stp_wait_frame(pucRspBuffer, u4MaxRespBufferLen,
+						t1100_stp_timeout_ms);
+
+		if (i4Ret <= 0)
+			return WLAN_STATUS_FAILURE;
+		*pu4Length = (UINT_32)i4Ret;
+		return WLAN_STATUS_SUCCESS;
+	}
+	return nicRxWaitResponse(prAdapter, ucPortIdx, pucRspBuffer,
+				 u4MaxRespBufferLen, pu4Length);
+}
+
+/*
+ * T1100 M83: the same for the MCIF TX page accounting.  nicTxAcquireResource()
+ * asks the MCU-side TX ring (MCR_WTQCR / WHISR) how many pages are free; over
+ * STP there is no ring at all and, with the MCIF block dead, the poll would
+ * only burn its timeout.  The STP branch therefore reports "resource
+ * available" unconditionally - the STP link does its own flow control
+ * (window space, mtk_wcn_stp_send_data() returns 0 and we retry).
+ */
+static WLAN_STATUS
+t1100_tx_acquire(P_ADAPTER_T prAdapter, UINT_8 ucTC, UINT_16 u2PageCount)
+{
+	if (t1100_hif == T1100_HIF_STP && t1100_stp_ready())
+		return WLAN_STATUS_SUCCESS;
+	return nicTxAcquireResource(prAdapter, ucTC, u2PageCount);
+}
