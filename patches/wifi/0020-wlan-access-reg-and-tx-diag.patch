+/*
+ * T1100 M81: the TX/completion state the HIF actually maintains.
+ *
+ * WHISR is the host interrupt status: TX_DONE (BIT0) is set when the HIF/WFDMA
+ * has accepted a packet from the host port; WTQCR0..7 are the released TX page
+ * counts the driver's own HAL_READ_TX_RELEASED_COUNT() uses. They are the
+ * instruments for "did the chip consume the packet", unlike WTMCR/WSR.
+ */
+static void t1100_tx_state(P_ADAPTER_T prAdapter, const char *tag)
+{
+	UINT_32 u4Whisr = 0, u4Wasr = 0, u4Wrplr = 0;
+	UINT_32 au4Q[4] = { 0, 0, 0, 0 };
+	int k;
+
+	HAL_READ_INTR_STATUS(prAdapter, 4, (PUINT_8)&u4Whisr);
+	HAL_MCR_RD(prAdapter, MCR_WASR, &u4Wasr);
+	HAL_MCR_RD(prAdapter, MCR_WRPLR, &u4Wrplr);
+	for (k = 0; k < 4; k++)
+		HAL_MCR_RD(prAdapter, MCR_WTQCR0 + 4 * k, &au4Q[k]);
+
+	pr_info("t1100-tx[%s]: WHISR=0x%08x txdone=%u rx0=%u rx1=%u abnorm=%u WASR=0x%08x WRPLR=0x%08x WTQCR0..7=0x%08x 0x%08x 0x%08x 0x%08x\n",
+		tag, u4Whisr, !!(u4Whisr & WHISR_TX_DONE_INT),
+		!!(u4Whisr & WHISR_RX0_DONE_INT), !!(u4Whisr & WHISR_RX1_DONE_INT),
+		!!(u4Whisr & WHISR_ABNORMAL_INT), u4Wasr, u4Wrplr,
+		au4Q[0], au4Q[1], au4Q[2], au4Q[3]);
 }
 
