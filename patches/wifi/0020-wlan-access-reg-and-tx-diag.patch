+/*
+ * T1100 M81: read the MCU address space through the ROM's own
+ * INIT_CMD_ID_ACCESS_REG (CID 3).
+ *
+ * Why this exists. Until M80 the conclusion "the image did not land in MCU
+ * memory" rested on two reads that cannot see MCU memory at all:
+ *
+ *  - HAL_MCR_RD(prAdapter, 0x000a5800 + n, &v) is kalDevRegRead() ->
+ *    sdio_cr_readl(HifRegBaseAddr, addr): a CMD53 word whose address field is
+ *    17 bits wide (sdio_gen3_cmd53_info.addr in ahb_sdioLike/include/sdio.h).
+ *    0x000a5800 does not fit and is truncated to 0x25800, so what comes back
+ *    is HIF register window + 0x25800, never MCU SRAM. The all-zero "t1100-rb"
+ *    dumps of M73/M76 are an artefact of that, not evidence about the image.
+ *  - MCR_WTMCR (0x00b4) and MCR_WSR (0x00d8) are the "test mode control" and
+ *    "WLAN snapshot" registers (include/nic/mt6630_reg.h), not TX descriptors,
+ *    so M77's "TX descriptors do not move" measured nothing either.
+ *
+ * The ROM does serve CID 3: its init-command table ends at CID 4 (M43: CID 5+
+ * are not answered), and gen4m drives exactly this command in
+ * wlanAccessRegister() -- haretic/android-kernel-mt6765-rabbitr1,
+ * drivers/staging/mtk-connectivity/gen4m/common/wlan_lib.c. A read is answered
+ * with INIT_EVENT_ID_ACCESS_REG (EID 2, seq + {u4Address,u4Data}) instead of
+ * INIT_EVENT_ID_CMD_RESULT (EID 1), which is what the ucSetQuery=0 path checks.
+ *
+ * So this is the only valid way to answer "did the payload reach 0x000a5800":
+ * ask the MCU's own boot ROM to read that address back.
+ */
+static WLAN_STATUS t1100_mem_read(P_ADAPTER_T prAdapter, UINT_32 u4Addr, UINT_32 *pu4Val)
+{
+	P_CMD_INFO_T prCmdInfo;
+	P_INIT_HIF_TX_HEADER_T prHdr;
+	P_INIT_CMD_ACCESS_REG prReq;
+	P_INIT_HIF_RX_HEADER_T prRsp;
+	P_INIT_EVENT_ACCESS_REG prEvt;
+	UINT_8 aucBuf[sizeof(INIT_HIF_RX_HEADER_T) + sizeof(INIT_EVENT_ACCESS_REG)];
+	UINT_32 u4Len = 0;
+	UINT_8 ucSeq;
+	WLAN_STATUS u4Status;
+
+	*pu4Val = 0;
+
+	prCmdInfo = cmdBufAllocateCmdInfo(prAdapter,
+					  sizeof(INIT_HIF_TX_HEADER_T) + sizeof(INIT_CMD_ACCESS_REG));
+	if (!prCmdInfo)
+		return WLAN_STATUS_FAILURE;
+	kalMemZero(prCmdInfo->pucInfoBuffer,
+		   sizeof(INIT_HIF_TX_HEADER_T) + sizeof(INIT_CMD_ACCESS_REG));
+	prCmdInfo->u2InfoBufLen = sizeof(INIT_HIF_TX_HEADER_T) + sizeof(INIT_CMD_ACCESS_REG);
+
+	ucSeq = nicIncreaseCmdSeqNum(prAdapter);
+	prHdr = (P_INIT_HIF_TX_HEADER_T)prCmdInfo->pucInfoBuffer;
+	prHdr->u2TxByteCount = prCmdInfo->u2InfoBufLen;
+	prHdr->u2PQ_ID = INIT_CMD_PQ_ID;
+	prHdr->rInitWifiCmd.ucCID = INIT_CMD_ID_ACCESS_REG;
+	prHdr->rInitWifiCmd.ucPktTypeID = INIT_CMD_PACKET_TYPE_ID;
+	prHdr->rInitWifiCmd.ucSeqNum = ucSeq;
+
+	prReq = (P_INIT_CMD_ACCESS_REG)prHdr->rInitWifiCmd.aucBuffer;
+	prReq->ucSetQuery = 0;	/* 0 = read (query), 1 = write (set) */
+	prReq->u4Address = u4Addr;
+	prReq->u4Data = 0;
+
+	while (1) {
+		if (nicTxAcquireResource(prAdapter, TC0_INDEX,
+					 nicTxGetPageCount(prCmdInfo->u2InfoBufLen, TRUE)) ==
+		    WLAN_STATUS_RESOURCES) {
+			if (nicTxPollingResource(prAdapter, TC0_INDEX) != WLAN_STATUS_SUCCESS) {
+				pr_info("t1100-mem[0x%08x]: no TX resource\n", u4Addr);
+				cmdBufFreeCmdInfo(prAdapter, prCmdInfo);
+				return WLAN_STATUS_FAILURE;
+			}
+			continue;
+		}
+		break;
+	}
+	if (nicTxInitCmd(prAdapter, prCmdInfo) != WLAN_STATUS_SUCCESS) {
+		cmdBufFreeCmdInfo(prAdapter, prCmdInfo);
+		return WLAN_STATUS_FAILURE;
+	}
+	cmdBufFreeCmdInfo(prAdapter, prCmdInfo);
+
+	u4Status = nicRxWaitResponse(prAdapter, 0, aucBuf, sizeof(aucBuf), &u4Len);
+	if (u4Status != WLAN_STATUS_SUCCESS)
+		return u4Status;
+
+	prRsp = (P_INIT_HIF_RX_HEADER_T)aucBuf;
+	if (prRsp->rInitWifiEvent.ucEID != INIT_EVENT_ID_ACCESS_REG) {
+		pr_info("t1100-mem[0x%08x]: unexpected EID %u (want %u)\n", u4Addr,
+			prRsp->rInitWifiEvent.ucEID, INIT_EVENT_ID_ACCESS_REG);
+		return WLAN_STATUS_FAILURE;
+	}
+	if (prRsp->rInitWifiEvent.ucSeqNum != ucSeq) {
+		pr_info("t1100-mem[0x%08x]: seq %u, want %u\n", u4Addr,
+			prRsp->rInitWifiEvent.ucSeqNum, ucSeq);
+		return WLAN_STATUS_FAILURE;
+	}
+
+	prEvt = (P_INIT_EVENT_ACCESS_REG)prRsp->rInitWifiEvent.aucBuffer;
+	if (prEvt->u4Address != u4Addr) {
+		pr_info("t1100-mem[0x%08x]: event reports 0x%08x\n", u4Addr, prEvt->u4Address);
+		return WLAN_STATUS_FAILURE;
+	}
+	*pu4Val = prEvt->u4Data;
+	return WLAN_STATUS_SUCCESS;
+}
+
+/* Dump u4Words MCU words; stops at the first read the ROM refuses (a silent
+ * chip would otherwise cost RX_RESPONSE_TIMEOUT = 1 s per word). */
+static void t1100_mem_dump(P_ADAPTER_T prAdapter, UINT_32 u4Addr, UINT_32 u4Words,
+			   const char *tag)
+{
+	UINT_32 n, u4Val = 0;
+	WLAN_STATUS rc;
+
+	for (n = 0; n < u4Words; n++) {
+		rc = t1100_mem_read(prAdapter, u4Addr + n * 4, &u4Val);
+		pr_info("t1100-mem[%s] 0x%08x = 0x%08x (rc %d)\n",
+			tag, u4Addr + n * 4, u4Val, (int)rc);
+		if (rc != WLAN_STATUS_SUCCESS) {
+			pr_info("t1100-mem[%s]: ROM does not serve ACCESS_REG here, stop\n", tag);
+			break;
+		}
+	}
+}
