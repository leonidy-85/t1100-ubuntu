 module_param(t1100_probe, int, 0444);
 MODULE_PARM_DESC(t1100_probe, "T1100: power CONSYS on and call the wlan HIF probe at module init");
 
+/*
+ * T1100 (mainline): how far t1100_wlan_probe() may go. A run can then be
+ * stopped before the step under debug, without reflashing or reloading:
+ *   1 - power the chip on only (CONSYS stays powered for register pokes)
+ *   2 - power on and run the whole wlan HIF probe (default)
+ */
+int t1100_probe_stage = 2;
+module_param(t1100_probe_stage, int, 0444);
+MODULE_PARM_DESC(t1100_probe_stage, "T1100: 1 = power CONSYS on only, 2 = power on + wlan HIF probe");
+
+/*
+ * T1100 (mainline): the ready-bit timeout path calls GL_RESET_TRIGGER(), which
+ * schedules a whole-chip reset with a core-dump assert through WMT. This port
+ * has no STP transport and no core-dump backend, so the request cannot work;
+ * with t1100_no_reset=1 the chip is simply left as it is.
+ */
+int t1100_no_reset;
+module_param(t1100_no_reset, int, 0444);
+MODULE_PARM_DESC(t1100_no_reset, "T1100: do not schedule a whole-chip reset when the probe fails");
+
