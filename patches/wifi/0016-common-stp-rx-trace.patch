diff -u -r a/common_main/core/stp_core.c b/common_main/core/stp_core.c
--- a/common_main/core/stp_core.c	2026-11-13 13:32:24.941039904 +0000
+++ b/common_main/core/stp_core.c	2026-11-13 13:32:24.942131082 +0000
@@ -44,6 +44,18 @@
 
 static INT32 fgEnableNak;	/* 0=enable NAK; 1=disable NAK */
 static INT32 fgEnableDelimiter;	/* 0=disable Delimiter; 1=enable Delimiter */
+
+/*
+ * T1100 M52: the chip's ARC exception dump (type 5) is picked up by the
+ * firmware-assert detector below, which switches STP into coredump mode: from
+ * then on tx retries are skipped and every WMT command fails with -2, so the
+ * post-patch WMT_RESET never reaches the chip.  With this knob the detector
+ * only logs and STP keeps serving WMT.
+ */
+static int t1100_no_assert_mode;
+static int t1100_dump_started;	/* T1100 M53: one-shot paged-dump trigger */
+module_param(t1100_no_assert_mode, int, 0444);
+MODULE_PARM_DESC(t1100_no_assert_mode, "T1100: do not switch STP into f/w assert (coredump) mode");
 /* common interface */
 static IF_TX sys_if_tx;
 static RX_HAS_PENDING_DATA sys_rx_has_pending_data;
@@ -2252,9 +2264,21 @@
 				osal_assert(0);
 			}
 
-			if (mtk_wcn_stp_coredump_start_get() == 0 && stp_core_ctx.rx_counter == 0 &&
-			    STP_IS_ENABLE_DBG(stp_core_ctx) && (stp_core_ctx.parser.type == STP_TASK_INDX)) {
-				mtk_wcn_stp_coredump_start_ctrl(1);
+			if (stp_core_ctx.rx_counter == 0 && STP_IS_ENABLE_DBG(stp_core_ctx) &&
+			    (stp_core_ctx.parser.type == STP_TASK_INDX) &&
+			    (t1100_no_assert_mode ? (t1100_dump_started == 0)
+						  : (mtk_wcn_stp_coredump_start_get() == 0))) {
+				/* T1100 M53: in no_assert_mode we do not switch STP
+				 * into the blocking assert mode, but the paged dump
+				 * must still be read - once. */
+				if (t1100_no_assert_mode) {
+					t1100_dump_started = 1;
+					STP_INFO_FUNC("t1100: would set f/w assert (no_assert_mode), type=%d len=%d\n",
+						      stp_core_ctx.parser.type,
+						      stp_core_ctx.parser.length);
+				} else {
+					mtk_wcn_stp_coredump_start_ctrl(1);
+				}
 				mtk_wcn_stp_ctx_save();
 				STP_INFO_FUNC("++ start to read paged dump and paged trace ++\n");
 				stp_btm_notify_wmt_dmp_wq(stp_core_ctx.btm);
@@ -2331,6 +2355,9 @@
 INT32 mtk_wcn_stp_parser_data(PUINT8 buffer, UINT32 length)
 #endif
 {
+	extern int t1100_rx_trace;
+	extern int t1100_rx_bytes;
+
     /*----------------------------------------------------------------*/
 	/* Local Variables                                                */
     /*----------------------------------------------------------------*/
@@ -2343,6 +2370,18 @@
 	STP_TRACE_FUNC("++, rx (cnt=%d,len=%d)\n", ++counter, length);
 #endif
 
+	if (t1100_rx_trace && buffer && length) {
+		UINT32 t1100_off;
+
+		t1100_rx_bytes += (int)length;
+		for (t1100_off = 0; t1100_off < length; t1100_off += 32) {
+			UINT32 n = (length - t1100_off) > 32 ? 32 : (length - t1100_off);
+
+			STP_INFO_FUNC("t1100: rpx %03u/%u %*phN\n", t1100_off, length,
+				      (int)n, buffer + t1100_off);
+		}
+	}
+
 	i = length;
 	p_data = (PUINT8) buffer;
 
