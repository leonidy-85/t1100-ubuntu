+extern INT32 consys_hw_warm_reset(VOID);
+extern INT32 consys_hw_spm_partial_reset(VOID);
+extern VOID mtk_wcn_stp_reset_seq_state(VOID);
+
+/*
+ * T1100 M56: warm CONSYS reset as a wmt_drv operation - AP_RGU CPU reset bit
+ * (MCU memory survives, WLAN RAM image does not) followed by the STP bring-up
+ * the driver needs after it.  Exported so wlan_drv_gen3 can use it instead of
+ * poking 0x10007018 itself and leaving STP stale.
+ */
+/*
+ * T1100 M60: "reset -> patches -> start".  After a reset the MCU lost the
+ * ROMv4 patch set, so the whole set has to be delivered again before anything
+ * else talks to the MCU.  Exported for wlan_drv_gen3.
+ */
+INT32 mtk_wcn_consys_warm_reset(VOID);
+
+/*
+ * T1100 M67: deliver a single ROMv4 patch of the set (0-based index) without
+ * any reset.  Used by wlan_drv_gen3 after the HIF is up and MCR is alive.
+ */
+INT32 mtk_wcn_wmt_send_patch_index(INT32 index)
+{
+	INT32 ret;
+	UINT32 hw = 0, hw2 = 0;
+	INT32 r1, r2;
+
+	r1 = wmt_core_reg_rw_raw(0, 0x80000008, &hw, 0xffffffff);
+	WMT_INFO_FUNC("t1100: send_patch_index(%d): hwcode before 0x%08x (ret %d)\n",
+		      index, hw, r1);
+	if (index < 0 || index >= t1100_patch_scan())
+		return -1;
+	t1100_patch_active = 1;
+	ret = mtk_wcn_soc_patch_dwn((UINT32)index);
+	t1100_patch_active = 0;
+	r2 = wmt_core_reg_rw_raw(0, 0x80000008, &hw2, 0xffffffff);
+	WMT_INFO_FUNC("t1100: send_patch_index(%d) -> %d, hwcode after 0x%08x (ret %d)\n",
+		      index, ret, hw2, r2);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_wcn_wmt_send_patch_index);
