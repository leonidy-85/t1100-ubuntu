+INT32 mtk_wcn_wmt_redownload_patch_set(VOID)
+{
+	INT32 i, cnt, ret = 0;
+
+	WMT_INFO_FUNC("t1100: redownload_patch_set: reset first\n");
+	if (t1100_spm_partial)
+		consys_hw_spm_partial_reset();
+	else
+		consys_hw_warm_reset();
+	ret = mtk_wcn_consys_warm_reset();	/* stp reinit + hwcode poll */
+	WMT_INFO_FUNC("t1100: redownload_patch_set: after reset hwcode ret %d\n", ret);
+	if (ret)
+		return ret;
+	cnt = t1100_patch_scan();
+	if (cnt <= 0) {
+		WMT_INFO_FUNC("t1100: redownload_patch_set: no patch files configured\n");
+		return -1;
+	}
+	for (i = 0; i < cnt; i++) {
+		ret = mtk_wcn_soc_patch_dwn((UINT32)i);
+		WMT_INFO_FUNC("t1100: redownload_patch_set: patch %d/%d -> %d\n", i, cnt, ret);
+		if (ret)
+			break;
+		if (t1100_spm_partial || t1100_op_between_spm) {
+			/* T1100 M61: the tail of a patch leaves the MCU in its
+			 * assert/dump state; only the SPM-partial reset brings it
+			 * back, so use it between the patches. */
+			ret = mtk_wcn_consys_warm_reset();
+			WMT_INFO_FUNC("t1100: redownload_patch_set: spm-partial after patch %d, hwcode ret %d\n",
+				      i, ret);
+			ret = 0;
+		} else {
+			UINT32 hb = 0, ha = 0;
+			INT32 rb, ra;
+
+			rb = wmt_core_reg_rw_raw(0, 0x80000008, &hb, 0xffffffff);
+			ret = wmt_core_init_script(init_table_3, osal_array_size(init_table_3));
+			ra = wmt_core_reg_rw_raw(0, 0x80000008, &ha, 0xffffffff);
+			WMT_INFO_FUNC("t1100: between patches (WMT_RESET only): patch %d reset %d, hwcode 0x%08x/%d -> 0x%08x/%d\n",
+				      i, ret, hb, rb, ha, ra);
+			ret = 0;	/* best effort, as in sw_init */
+		}
+	}
+	return ret;
+}
+EXPORT_SYMBOL(mtk_wcn_wmt_redownload_patch_set);
+
+INT32 mtk_wcn_consys_warm_reset(VOID)
+{
+	ULONG p1 = 0, p2 = 0;
+	INT32 r1, r2, r3, r4, r5 = 0;
+	int i;
+	UINT32 hw = 0;
+
+	if (t1100_op_no_first_reset) {
+		/* T1100 M65: the caller just powered the domain on, only the STP
+		 * bring-up is needed before the patches. */
+		mtk_wcn_stp_reset_seq_state();
+	} else if (t1100_spm_partial) {
+		consys_hw_spm_partial_reset();
+	} else if (t1100_warm_reset) {
+		consys_hw_warm_reset();
+	}
+	/*
+	 * T1100 M57: order matters - reset_seq_state and the STP bring-up must
+	 * happen BEFORE any register read, otherwise wmt_core_reg_rw_raw()
+	 * returns -2 ("STP is not enabled") immediately and the poll proves
+	 * nothing.  Only then poll GEN_HCR until the MCU answers again.
+	 */
+	mtk_wcn_stp_reset_seq_state();
+	r1 = wmt_core_ctrl(WMT_CTRL_STP_CLOSE, &p1, &p2);
+	r2 = wmt_core_ctrl(WMT_CTRL_STP_OPEN, &p1, &p2);
+	p1 = WMT_STP_CONF_MODE; p2 = MTKSTP_BTIF_MAND_MODE;
+	r3 = wmt_core_ctrl(WMT_CTRL_STP_CONF, &p1, &p2);
+	p1 = WMT_STP_CONF_EN; p2 = 1;
+	r4 = wmt_core_ctrl(WMT_CTRL_STP_CONF, &p1, &p2);
+	WMT_INFO_FUNC("t1100: warm reset: stp close/open/mode/en = %d/%d/%d/%d\n",
+		      r1, r2, r3, r4);
+	/* T1100 M69: after a fresh power-on the MCU needs a while before it
+	 * serves GEN_HCR - poll 40 x 100 ms and fail only on timeout. */
+	for (i = 0; i < 40; i++) {
+		hw = 0;
+		r5 = wmt_core_reg_rw_raw(0, 0x80000008, &hw, 0xffffffff);
+		if (!r5 && hw)
+			break;
+		osal_sleep_ms(100);
+	}
+	WMT_INFO_FUNC("t1100: hwcode poll: 0x%08x after %d tries (ret %d)\n", hw, i + 1, r5);
+	WMT_INFO_FUNC("t1100: warm reset from wmt_drv: stp %d/%d/%d/%d hwcode 0x%08x (ret %d)\n",
+		      r1, r2, r3, r4, hw, r5);
+	if (!r5 && hw) {
+		UINT32 pm = 0;
+		INT32 pr;
+
+		pr = wmt_core_reg_rw_raw(0, 0x80000000 | 0xf0078000u, &pm, 0xffffffff);
+		WMT_INFO_FUNC("t1100: warm reset: patchmark[0xf0078000] = 0x%08x (ret %d)\n", pm, pr);
+		pm = 0;
+		pr = wmt_core_reg_rw_raw(0, 0x80098020, &pm, 0xffffffff);
+		WMT_INFO_FUNC("t1100: warm reset: patchmark[0x80098020] = 0x%08x (ret %d)\n", pm, pr);
+	}
+	return r5;
+}
+EXPORT_SYMBOL(mtk_wcn_consys_warm_reset);
