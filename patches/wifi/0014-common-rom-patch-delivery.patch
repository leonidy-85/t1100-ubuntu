+/* ---- T1100 M43: ROMv4 patch *set* (num/seq from the header field at 24) ---- */
+#define T1100_MAX_PATCHES 4
+struct t1100_patch {
+	UINT8 seq;
+	UINT8 num;
+	UINT8 addr[4];
+	char name[64];
+};
+static struct t1100_patch t1100_patches[T1100_MAX_PATCHES];
+static int t1100_patch_cnt = -1;
+
+static int t1100_patch_scan(void)
+{
+	char list[sizeof(t1100_rom_patch)];
+	char *tok, *save = NULL, *p = list;
+	int n = 0, i, j;
+	struct t1100_patch t;
+	const struct firmware *fw;
+	struct t1100_patch *e;
+	UINT8 b;
+
+	if (t1100_patch_cnt >= 0)
+		return t1100_patch_cnt;
+	t1100_patch_cnt = 0;
+	if (!t1100_rom_patch[0])
+		return 0;
+	osal_memcpy(list, t1100_rom_patch, sizeof(list));
+	while ((tok = strsep(&p, " ,")) != NULL && n < T1100_MAX_PATCHES) {
+		if (!tok[0])
+			continue;
+		if (request_firmware(&fw, tok, NULL) || fw->size <= 32) {
+			WMT_ERR_FUNC("t1100: cannot load %s\n", tok);
+			continue;
+		}
+		e = &t1100_patches[n];
+		osal_memset(e, 0, sizeof(*e));
