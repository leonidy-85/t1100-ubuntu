 	for (i = 0; i < prFwHead->u4NumOfEntries && i < ENTRY_DIRECTLY_TO_CHIP; i++) {
@@ -2708,6 +2743,10 @@
 		/* 7. Wait for INIT_EVENT_ID_CMD_RESULT */
 		u4Status = wlanImageSectionDownloadStatus(prAdapter, ucCmdSeqNum);
 #endif
+		pr_info("t1100-mcif: section-config dst=0x%08x len=%u reset=%u -> status=%u (0=ok)\n",
