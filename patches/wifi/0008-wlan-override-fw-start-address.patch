--- a/include/config.h
+++ b/include/config.h
@@ -566,7 +566,17 @@
 /* Vary between projects, already replaced by device tree */
 /* default value is for MT6630 */
 #define CFG_FW_LOAD_ADDRESS                     0x00091400
-#define CFG_OVERRIDE_FW_START_ADDRESS           0
+/*
+ * T1100 (mainline): without PATCH the WIFI_START command is sent with
+ * override = FALSE and address 0, i.e. the chip is asked to use its own
+ * default entry point. That only works when the ROM has been patched by
+ * wmt_loader over STP first - on this port there is no STP, so the MCU stayed
+ * in its ROM loop (cpupcr 0x15730) and never asserted WLAN_READY.
+ * With 1 the driver sends override = TRUE and DT "hardware-values"[2]
+ * (= 0xa5800 here, the destination of section 1) as the start address, which
+ * is exactly the image just downloaded.
+ */
+#define CFG_OVERRIDE_FW_START_ADDRESS           1
 #define CFG_FW_START_ADDRESS                    0x00091400
 
 /*------------------------------------------------------------------------------
--- a/common/wlan_lib.c
+++ b/common/wlan_lib.c
@@ -144,6 +144,23 @@
 		      IN UINT_32 u4FwLoadAddr,
 		      IN UINT_32 u4FwImageFileLength);
 
+/* T1100 debug: dump the whole MCR page of the AHB HIF (0x180f0000..+0x100),
+ * which is where WCIR/WASR/WSR/mailboxes live (include/nic/mt6630_reg.h).
+ */
+static void t1100_dump_mcr(P_ADAPTER_T prAdapter, const char *tag)
+{
+	UINT_32 r[64];
+	INT_32 i;
+
+	for (i = 0; i < 64; i++)
+		HAL_MCR_RD(prAdapter, (UINT_32)(i * 4), &r[i]);
+	pr_info("t1100-mcr[%s]:\n", tag);
+	for (i = 0; i < 64; i += 8)
+		pr_info("t1100-mcr[%s] %02x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			tag, i * 4, r[i], r[i + 1], r[i + 2], r[i + 3],
+			r[i + 4], r[i + 5], r[i + 6], r[i + 7]);
+}
+
 #if CFG_ENABLE_FW_DIVIDED_DOWNLOAD
 static WLAN_STATUS
 wlanImageDividDownloadByEntry(IN P_ADAPTER_T prAdapter,
@@ -958,6 +975,24 @@
 	UINT_8 __iomem *prWifiEmiBaseAddr;
