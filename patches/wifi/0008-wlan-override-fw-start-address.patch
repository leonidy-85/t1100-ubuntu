+	/*
+	 * T1100 debug: the download itself is otherwise invisible, and the
+	 * sections are addressed by their own u4DestAddr (entries >= 2 go to
+	 * EMI through ioremap(gConEmiPhyBase)), *not* to the DT load address
+	 * "hardware-values[1]". Print the table so EMI can be checked at the
+	 * real destinations. Deliberately no EMI read-back here: an out-of-range
+	 * destination would fault inside the driver (the ioremap window is
+	 * WIFI_EMI_AVAILABLE_MEM_SIZE, the bound check uses WIFI_EMI_MEM_SIZE).
+	 */
+	pr_info("t1100-fw: entries=%u secsz=%zu\n",
