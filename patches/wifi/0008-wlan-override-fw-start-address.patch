+			i, prFwHead->arSection[i].u4DestAddr,
+			prFwHead->arSection[i].u4Length,
+			prFwHead->arSection[i].u4Offset,
+			prFwHead->arSection[i].ucEnc);
+
 	/* engage divided firmware downloading */
