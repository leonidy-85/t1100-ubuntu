diff --git a/sound/soc/mediatek/Kconfig b/sound/soc/mediatek/Kconfig
index 224746e76..792b81a88 100644
--- a/sound/soc/mediatek/Kconfig
+++ b/sound/soc/mediatek/Kconfig
@@ -393,4 +393,13 @@ config SND_SOC_MT8196_NAU8825
 	  Select Y if you have such device.
 	  If unsure select "N".
 
+config SND_SOC_MT6771_MT6358
+	tristate "ASoC Audio driver for MT6771 with MT6358 codec"
+	depends on SND_SOC_MT8183 && SND_SOC_MT6358
+	help
+	  This adds ASoC driver support for MediaTek MT6771 sound cards
+	  with the MT6358 PMIC codec (Fplus T1100 tablet).
+	  The MT6771 audio block is register compatible with the MT8183 one,
+	  so the mt8183 AFE platform driver drives it.
+
 endmenu
