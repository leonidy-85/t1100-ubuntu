diff --git a/sound/soc/mediatek/mt6771/mt6771-mt6358.c b/sound/soc/mediatek/mt6771/mt6771-mt6358.c
new file mode 100644
index 000000000..a153e1459
--- /dev/null
+++ b/sound/soc/mediatek/mt6771/mt6771-mt6358.c
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fplus T1100 (MT6771) sound card: MTKF AFE <-> MT6358 codec.
+ *
+ * The board has no external I2S codec: the speaker is driven by the MT6358
+ * DAC through an analog amplifier whose enable line is a GPIO, and the
+ * headset is wired to the MT6358 as well.  This is the minimal machine driver
+ * for that wiring (playback through DL1/ADDA, capture through UL1/ADDA).
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <sound/soc.h>
+
+#define DRV_NAME "mt6771-mt6358"
+
+struct mt6771_mt6358_priv {
+	struct gpio_desc *amp_gpio;
+};
+
+static int mt6771_mt6358_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_card *card = rtd->card;
+	struct mt6771_mt6358_priv *priv = snd_soc_card_get_drvdata(card);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK && priv->amp_gpio)
+		gpiod_set_value_cansleep(priv->amp_gpio, 1);
+
+	return 0;
+}
+
+static void mt6771_mt6358_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_card *card = rtd->card;
+	struct mt6771_mt6358_priv *priv = snd_soc_card_get_drvdata(card);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK && priv->amp_gpio)
+		gpiod_set_value_cansleep(priv->amp_gpio, 0);
+}
+
+static const struct snd_soc_ops mt6771_mt6358_ops = {
+	.startup = mt6771_mt6358_startup,
+	.shutdown = mt6771_mt6358_shutdown,
+};
+
+/* FE */
+SND_SOC_DAILINK_DEFS(playback1,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(capture1,
+	DAILINK_COMP_ARRAY(COMP_CPU("UL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+/* BE */
+SND_SOC_DAILINK_DEFS(primary_codec,
+	DAILINK_COMP_ARRAY(COMP_CPU("ADDA")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("mt6358-sound", "mt6358-snd-codec-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+
+/*
+ * 6.12 DPCM only sends SND_SOC_DAPM_STREAM_START to the front end, so the
+ * backend widgets (codec AIF, DAC and its supplies) never get active and the
+ * whole DAPM path stays off.  Flip them on explicitly for the backend.
+ */
+static int mt6771_mt6358_be_prepare(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	snd_soc_dapm_stream_event(rtd, substream->stream,
+				  SND_SOC_DAPM_STREAM_START);
+
+	return 0;
+}
+
+static void mt6771_mt6358_be_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	snd_soc_dapm_stream_event(rtd, substream->stream,
+				  SND_SOC_DAPM_STREAM_STOP);
+}
+
+static const struct snd_soc_ops mt6771_mt6358_be_ops = {
+	.prepare = mt6771_mt6358_be_prepare,
+	.shutdown = mt6771_mt6358_be_shutdown,
+};
+
+static struct snd_soc_dai_link mt6771_mt6358_dai_links[] = {
+	{
+		.name = "Playback_1",
+		.stream_name = "Playback_1",
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE,
+			     SND_SOC_DPCM_TRIGGER_PRE },
+		.dynamic = 1,
+		.playback_only = 1,
+		.ops = &mt6771_mt6358_ops,
+		SND_SOC_DAILINK_REG(playback1),
+	},
+	{
+		.name = "Capture_1",
+		.stream_name = "Capture_1",
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE,
+			     SND_SOC_DPCM_TRIGGER_PRE },
+		.dynamic = 1,
+		.capture_only = 1,
+		SND_SOC_DAILINK_REG(capture1),
+	},
+	{
+		.name = "Primary Codec",
+		.no_pcm = 1,
+		.ignore_suspend = 1,
+		.ops = &mt6771_mt6358_be_ops,
+		SND_SOC_DAILINK_REG(primary_codec),
+	},
+};
+
+static struct snd_soc_card mt6771_mt6358_card = {
+	.name = "mt6771-mt6358",
+	.owner = THIS_MODULE,
+	.dai_link = mt6771_mt6358_dai_links,
+	.num_links = ARRAY_SIZE(mt6771_mt6358_dai_links),
+};
+
+static int mt6771_mt6358_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &mt6771_mt6358_card;
+	struct mt6771_mt6358_priv *priv;
+	struct device_node *np;
+	int ret;
+	int i;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->amp_gpio = devm_gpiod_get_optional(&pdev->dev, "amp",
+						 GPIOD_OUT_LOW);
+	if (IS_ERR(priv->amp_gpio))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->amp_gpio),
+				     "failed to get the amplifier GPIO\n");
+
+	/*
+	 * The card is built in and probes before the AFE does (the AFE itself
+	 * defers until its clocks are available).  Wait for it, otherwise the
+	 * FE links have no CPU DAI and registration fails with -EINVAL.
+	 */
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt8183-audio");
+	if (np) {
+		struct platform_device *afe = of_find_device_by_node(np);
+
+		if (afe) {
+			bool bound = afe->dev.driver != NULL;
+
+			put_device(&afe->dev);
+			if (!bound) {
+				of_node_put(np);
+				return -EPROBE_DEFER;
+			}
+		}
+	}
+
+	card->dev = &pdev->dev;
+	snd_soc_card_set_drvdata(card, priv);
+	platform_set_drvdata(pdev, card);
+
+	/*
+	 * Since 6.16 the AFE node is a child of the audiosys syscon and has no
+	 * unit address of its own, so there is no stable platform name to match
+	 * on.  Bind the platform components by of_node, like the mt8183 machine
+	 * drivers do.
+	 */
+	for (i = 0; i < card->num_links; i++) {
+		struct snd_soc_dai_link *link = &card->dai_link[i];
+
+		if (!link->platforms->name)
+			link->platforms->of_node = np;
+	}
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	of_node_put(np);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to register card\n");
+
+	return 0;
+}
+
+static const struct of_device_id mt6771_mt6358_of_match[] = {
+	{ .compatible = "mediatek,mt6771-mt6358" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6771_mt6358_of_match);
+
+static struct platform_driver mt6771_mt6358_driver = {
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = mt6771_mt6358_of_match,
+		.pm = &snd_soc_pm_ops,
+	},
+	.probe = mt6771_mt6358_probe,
+};
+module_platform_driver(mt6771_mt6358_driver);
+
+MODULE_DESCRIPTION("Fplus T1100 (MT6771) MT6358 sound card");
+MODULE_LICENSE("GPL");
