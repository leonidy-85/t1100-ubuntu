From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Thu, 29 Oct 2026 15:15:06 +0300
Subject: [PATCH] arm64: dts: t1100: bootloader framebuffer console + MTK
 watchdog

There is no UART access on this board. LK leaves a 1600x2176 XRGB8888
buffer at 0x7cd80000, so expose it as simple-framebuffer and use
console=tty0 with panic=10 instead of the (gated-clock) UART console.
Also describe the MTK watchdog, which LK leaves running.
---
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index e78746342..ad0f25843 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -57,7 +57,24 @@ lcd-backlight {
 };
 
 &chosen {
-	bootargs = "console=ttyS0,921600n8 earlycon=mtk8250,0x11002000 maxcpus=1 panic=10 pstore.backend=ramoops";
+	/*
+	 * No UART on this board: the log channel is the bootloader framebuffer
+	 * (LK leaves a 1600x2176 XRGB8888 buffer at 0x7cd80000) plus
+	 * ramoops/pstore. panic=10 makes a crash reboot instead of hanging.
+	 */
+	bootargs = "console=tty0 maxcpus=1 panic=10 pstore.backend=ramoops loglevel=7";
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	/* Keep the display alive from the bootloader until real KMS exists. */
+	framebuffer@7cd80000 {
+		compatible = "simple-framebuffer";
+		reg = <0 0x7cd80000 0 0xd48000>;	/* 1600 * 2176 * 4 */
+		width = <1600>;
+		height = <2176>;
+		stride = <6400>;
+		format = "a8r8g8b8";
+	};
 };
 
 &i2c0 {
