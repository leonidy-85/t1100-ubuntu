From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Tue, 3 Nov 2026 14:44:11 +0300
Subject: [PATCH] drm/panel: it6112: take the mode timings and power sequence
 from the LK

The 6.16 WIP driver's mode timings (109/34/10 h, 220/28/8 v) were never
verified against hardware, and the power-up order was a guess as well.
Re-read both out of the panel driver the stock LK hands to mt6771's DSI
host (lk-verified.img: lcm_get_params at 0x31094 and 0x31b90, panel init
at 0x31a40, it611x_power_ldo_on at 0x1f0a0).

Timings, as disp_lcm.c's own dump prints them for this panel:

  vact 8, vbp 28, vfp 220, vact_line 2176,
  hact 14, hbp 44, hfp 44, hblank 0, hactive 1600

i.e. the sync pulse and front porch were swapped in v, and hsa/hbp/hfp
were wrong by a wide margin. The stock 4.14 kernel reports the same porch
set (28/220/44/44) and runs the panel at 60.00 fps
(atag,videolfb-fps = 6000), so htotal 1702 * vtotal 2432 * 60 gives
248355 kHz instead of the previous 255797 kHz.

Power-up/reset, verbatim from the LK:

  all panel GPIOs inactive -> 30 ms -> EXT_PWR high -> 200 ms ->
  DVDD/DSV rails -> 2 ms; then rst high 5 ms, low 20 ms, high, 165 ms
  settle before the first I2C access.

Note the vendor never asserts STBY: LK drives it low and leaves it there,
so stop driving it high (that is at worst a standby request, at best a
no-op). Power-down mirrors the LK: rails off, 23 ms, EXT_PWR low.

Signed-off-by: bringup <bringup@t1100.local>
---
 .../drm/panel/panel-it6112-boe-tv110xum-lb2.c | 113 +++++++++++++-----
 1 file changed, 83 insertions(+), 30 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-it6112-boe-tv110xum-lb2.c b/drivers/gpu/drm/panel/panel-it6112-boe-tv110xum-lb2.c
index 2bdb7b3a6..a44075b25 100644
--- a/drivers/gpu/drm/panel/panel-it6112-boe-tv110xum-lb2.c
+++ b/drivers/gpu/drm/panel/panel-it6112-boe-tv110xum-lb2.c
@@ -29,6 +29,10 @@
  *    programmed the way the stock LK does it, not the way the 6.16 original
  *    guessed it: see it6112_tv110xum_lb2_init_tx() and
  *    it6112_tx_calc_clk().
+ *  - the mode timings (and therefore the pixel clock) and the power/reset
+ *    sequence come from the stock LK's lcm_get_params and panel init, not
+ *    from the 6.16 original: see boe_tv110xum_lb2_mode,
+ *    it6112_power_up() and it6112_reset_pulse().
  */
 
 #include <linux/backlight.h>
@@ -143,6 +147,53 @@ static void it6112_mipi_rx_set_bits(struct it6112_ctx *ctx, u8 reg,
 	it6112_mipi_rx_write(ctx, reg, temp);
 }
 
+/*
+ * Vendor power-up order, from the stock LK (lk-verified.img):
+ *
+ *   it611x_power_ldo_on()   (0x1f0a0): every panel GPIO inactive,
+ *                           30 ms, EXT_PWR asserted, 200 ms, DVDD
+ *                           asserted, 2 ms.
+ *   lcm init                (0x31a40): touch reset, then the reset pulse
+ *                           below, then the bridge register init.
+ *
+ * STBY is *not* asserted by the vendor: LK drives it low in
+ * it611x_power_ldo_on() and never touches it again, so a high level here
+ * is not what the vendor hardware runs with.
+ */
+static int it6112_power_up(struct it6112_ctx *ctx)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(ctx->stby_gpio, 0);
+	gpiod_set_value_cansleep(ctx->ext_pwr_gpio, 1);
+	msleep(200);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->regulators),
+				    ctx->regulators);
+	if (ret)
+		return ret;
+
+	usleep_range(2000, 2500);
+
+	return 0;
+}
+
+/*
+ * Reset pulse, straight from the stock LK (0x31a40): drive the line high,
+ * wait 5 ms, pull it low for 20 ms, release it and give the bridge 165 ms
+ * before the first I2C access. The 165 ms settle is the part the previous
+ * revision got wrong (12 ms), and the bridge needs it after power-on.
+ */
+static void it6112_reset_pulse(struct it6112_ctx *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(165);
+}
+
 static int it6112_get_pid(struct it6112_ctx *ctx)
 {
 	int revid, chipid;
@@ -503,24 +554,14 @@ static int boe_tv110xum_lb2_prepare(struct drm_panel *panel)
 	struct it6112_ctx *ctx = panel_to_it6112(panel);
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->regulators),
-				    ctx->regulators);
+	ret = it6112_power_up(ctx);
 	if (ret) {
 		dev_err(&ctx->dsi->dev,
-			"failed to enable regulators: %d\n", ret);
+			"failed to power the bridge up: %d\n", ret);
 		return ret;
 	}
 
-	gpiod_set_value_cansleep(ctx->stby_gpio, 1);
-	gpiod_set_value_cansleep(ctx->ext_pwr_gpio, 1);
-	msleep(20);
-
-	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	usleep_range(12000, 13000);
-	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
-	usleep_range(12000, 13000);
-	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	usleep_range(12000, 13000);
+	it6112_reset_pulse(ctx);
 
 	it6112_bridge_init(ctx);
 
@@ -543,19 +584,34 @@ static int boe_tv110xum_lb2_unprepare(struct drm_panel *panel)
 	regulator_bulk_disable(ARRAY_SIZE(ctx->regulators),
 			       ctx->regulators);
 
+	/* LK powers down the other way round: DVDD first, 23 ms, EXT_PWR. */
+	msleep(23);
+	gpiod_set_value_cansleep(ctx->ext_pwr_gpio, 0);
+
 	return 0;
 }
 
+/*
+ * Timings as the vendor programs them, not the 6.16 WIP guess.
+ *
+ * Read out of the panel driver the stock LK hands to mt6771's DSI host
+ * (lk-verified.img, lcm_get_params at 0x31094/0x31b90, values printed by
+ * disp_lcm.c's dump: "vact: 8, vbp: 28, vfp: 220, vact_line: 2176,
+ * hact: 14, hbp: 44, hfp: 44, hblank: 0, hactive: 1600"). The stock 4.14
+ * kernel reports the same set (28/220/44/44) and 1600x2176 @ 60.00 fps
+ * (atag,videolfb-fps = 6000), hence 1702 x 2432 x 60 = 248355840 Hz.
+ */
 static const struct drm_display_mode boe_tv110xum_lb2_mode = {
-	.clock = (1600 + 109 + 34 + 10) * (2176 + 220 + 28 + 8) * 60 / 1000,
+	/* 1702 x 2432 x 60.00 Hz = 248355840 Hz */
+	.clock = 248356,
 	.hdisplay = 1600,
-	.hsync_start = 1600 + 109,
-	.hsync_end = 1600 + 109 + 34,
-	.htotal = 1600 + 109 + 34 + 10,
+	.hsync_start = 1600 + 14,
+	.hsync_end = 1600 + 14 + 44,
+	.htotal = 1600 + 14 + 44 + 44,
 	.vdisplay = 2176,
-	.vsync_start = 2176 + 220,
-	.vsync_end = 2176 + 220 + 28,
-	.vtotal = 2176 + 220 + 28 + 8,
+	.vsync_start = 2176 + 8,
+	.vsync_end = 2176 + 8 + 28,
+	.vtotal = 2176 + 8 + 28 + 220,
 	.width_mm = 166,
 	.height_mm = 226,
 };
@@ -653,24 +709,21 @@ static int it6112_bridge_probe(struct i2c_client *i2c)
 
 	/*
 	 * The IT6112 only answers on I2C while DVDD and the DSV rails are up.
-	 * LK usually leaves them on, but do not depend on that: power them for
-	 * the product-id probe and switch them off again. ->prepare() does the
-	 * real, sequenced power-up.
+	 * LK usually leaves them on, but do not depend on that: run the
+	 * vendor power-up and reset sequence for the product-id probe and
+	 * switch the rails off again. ->prepare() repeats it.
 	 */
-	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->regulators),
-				    ctx->regulators);
+	ret = it6112_power_up(ctx);
 	if (ret)
-		return dev_err_probe(dev, ret, "failed to enable regulators\n");
+		return dev_err_probe(dev, ret, "failed to power the bridge up\n");
 
-	/* Same order as the vendor LCM driver: rails, then STBY/EXT_PWR. */
-	gpiod_set_value_cansleep(ctx->stby_gpio, 1);
-	gpiod_set_value_cansleep(ctx->ext_pwr_gpio, 1);
-	msleep(20);
+	it6112_reset_pulse(ctx);
 
 	pid = it6112_get_pid(ctx);
 
 	regulator_bulk_disable(ARRAY_SIZE(ctx->regulators),
 			       ctx->regulators);
+	gpiod_set_value_cansleep(ctx->ext_pwr_gpio, 0);
 
 	if (pid < 0)
 		return dev_err_probe(dev, -ENODEV, "read product id failed: %d\n",
