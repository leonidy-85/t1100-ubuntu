  * I2C6: SGM41513 battery charger (ti,bq25601 compatible). Not needed for
  * bring-up, and a wrong charge profile on an unknown pack is a risk.
  */
+/*
+ * i2c1 (0x11011000): the sensor bus.  The light/proximity sensor (STK3x3x)
+ * sits at 0x57 and the IMU (ICM-42607) at 0x68; the vendor kernel drives both
+ * through mediatek-sensor hub nodes.  Enable the bus first so the chips can be
+ * probed from userspace before the mainline drivers are wired in.
+ */
+&pio {
+	/*
+	 * ALS/PS interrupt line: GPIO6, the stock pinctrl keeps it pulled up
+	 * (alspspincfg: pinmux 0x600, bias-pull-up).
+	 */
+	alsps_irq_pins: alsps-irq-pins {
+		pins-eint {
+			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
+			bias-pull-up;
+		};
+	};
+};
+
+&i2c1 {
+	vbus-supply = <&i2c_vbus>;
+	/* the vendor bus runs in fast/high-speed mode */
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* InvenSense ICM-42607: accelerometer + gyroscope. INT1 is not routed
+	 * on this board, so the driver polls the FIFO from a timer. */
+	imu@68 {
+		compatible = "invensense,icm42607p";
+		reg = <0x68>;
+		vdd-supply = <&reg_sensor_vdd>;
+		vddio-supply = <&reg_sensor_vdd>;
+		/*
+		 * The chip is mounted rotated by 180 degrees against the panel.
+		 * The vendor DT claims direction 0, but with the identity matrix
+		 * the desktop comes up upside down in every rotation, so flip
+		 * X and Y here.
+		 */
+		mount-matrix = "-1", "0", "0",
+			       "0", "-1", "0",
+			       "0", "0", "1";
+	};
+
+	/* Sensortek STK3338 light + proximity sensor (PID 0x5B at reg 0x3E) */
+	light-sensor@57 {
+		compatible = "sensortek,stk3338";
+		reg = <0x57>;
+		interrupt-parent = <&pio>;
+		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&alsps_irq_pins>;
+	};
+};
+
 &i2c6 {
 	vbus-supply = <&i2c_vbus>;
 	status = "okay";
