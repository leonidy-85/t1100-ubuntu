 		 * Type-C port controller, sink only.
 		 *
@@ -372,33 +419,51 @@ charger {
 		 * switch nobody registers. Neither is needed to charge: the
 		 * charger above is an independent BC1.2 engine.
 		 *
-		 * pd-disable keeps the PD state machine out of the picture
-		 * for the first bring-up; sink-pdos documents the single 5 V
-		 * contract the port accepts.
+		 * PD is on: pd-disable is gone, so tcpm runs the PD state
+		 * machine. Two things matter for our USB network. First, the
+		 * role-switch paragraph above still holds and the connector
+		 * must not grow graph endpoints now that PD is enabled:
+		 * otherwise tcpm would drive mtu3's role on a power-role
+		 * change and the RNDIS gadget, our only SSH channel, would
+		 * die. Second, sink-pdos has to list every voltage we want to
+		 * accept: the contract is picked by matching the sink PDOs
+		 * against the source PDOs (tcpm_pd_select_pdo), so a single
+		 * 5 V entry keeps the port at 5 V no matter what the charger
+		 * offers. 9 V/2 A plus op-sink-microwatt = 18 W is what makes
+		 * an 18 W PD charger switch to 9 V.
+		 *
+		 * typec-power-opmode is only read on the non-PD path
+		 * (tcpm_fw_get_caps requires it when pd-disable is set), so it
+		 * stays as a guard in case PD gets disabled again: without it
+		 * probe fails with -EINVAL and -22.
+		 *
+		 * PD does not raise the charge current by itself: mt6370-tcpc
+		 * has no set_current_limit() callback, so tcpm only records
+		 * the contract in tcpm-source-psy-* and the charger keeps its
+		 * IAICR. Userspace applies the contract
+		 * (usr/local/bin/t1100-charge.sh pd).
 		 */
 		tcpc {
 			compatible = "mediatek,mt6370-tcpc";
 			interrupts-extended = <&pio 41 IRQ_TYPE_LEVEL_LOW>;
+			status = "okay";
+			vbus-supply = <&mt6370_otg_vbus>;
 
 			connector {
 				compatible = "usb-c-connector";
 				label = "USB-C";
 
-				power-role = "sink";
-				data-role = "device";
-				pd-disable;
-				/*
-				 * tcpm_fw_get_caps() only reads this when PD is off,
-				 * but then it *requires* it: without the property
-				 * fwnode_property_read_string() fails and
-				 * tcpm_register_port() returns -EINVAL, which is what
-				 * kept mt6370-tcpc from probing ("Failed to register
-				 * tcpci port"). "default" = Rp 500 mA advertisement.
-				 */
+				power-role = "dual";
+				data-role = "dual";
+				try-power-role = "sink";
 				typec-power-opmode = "default";
-				op-sink-microwatt = <15000000>;
+				op-sink-microwatt = <18000000>;
 
