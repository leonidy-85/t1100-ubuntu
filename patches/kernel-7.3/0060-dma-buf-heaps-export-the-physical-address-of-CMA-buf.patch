From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonid <leonidy.1985@yandex.ru>
Date: Wed, 25 Nov 2026 12:38:48 +0300
Subject: [PATCH] dma-buf: heaps: export the physical address of CMA buffers

Project series 0079. The 32-bit MediaTek vcodec HAL allocates through
/dev/ion and needs the physical address to program the decoder; pagemap
refuses VM_PFNMAP, so the exporter has to report it. Adds the optional
heap ioctl hook, DMA_HEAP_IOCTL_PHYS and a root-only CMA implementation
that verifies the range is contiguous.
---
 drivers/dma-buf/dma-heap.c       | 11 ++++++
 drivers/dma-buf/heaps/cma_heap.c | 66 ++++++++++++++++++++++++++++++++
 include/linux/dma-heap.h         |  7 ++++
 include/uapi/linux/dma-heap.h    | 33 ++++++++++++++++
 4 files changed, 117 insertions(+)

diff --git a/drivers/dma-buf/dma-heap.c b/drivers/dma-buf/dma-heap.c
index 8a6c2b6e0..33a7287f0 100644
--- a/drivers/dma-buf/dma-heap.c
+++ b/drivers/dma-buf/dma-heap.c
@@ -113,6 +113,7 @@ static struct dma_buf *dma_heap_ioctl_allocate(struct file *file, void *data)
 
 static unsigned int dma_heap_ioctl_cmds[] = {
 	DMA_HEAP_IOCTL_ALLOC,
+	DMA_HEAP_IOCTL_PHYS,
 };
 
 static long dma_heap_ioctl(struct file *file, unsigned int ucmd,
@@ -122,6 +123,7 @@ static long dma_heap_ioctl(struct file *file, unsigned int ucmd,
 	char *kdata = stack_kdata;
 	unsigned int kcmd;
 	unsigned int in_size, out_size, drv_size, ksize;
+	struct dma_heap *heap = file->private_data;
 	int nr = _IOC_NR(ucmd);
 	int ret = 0;
 	int fd;
@@ -179,6 +181,15 @@ static long dma_heap_ioctl(struct file *file, unsigned int ucmd,
 		}
 
 		break;
+	case DMA_HEAP_IOCTL_PHYS:
+		if (!heap->ops->ioctl) {
+			ret = -ENOTTY;
+			break;
+		}
+		ret = heap->ops->ioctl(heap, kcmd, kdata);
+		if (!ret && copy_to_user((void __user *)arg, kdata, out_size))
+			ret = -EFAULT;
+		break;
 	default:
 		ret = -ENOTTY;
 		goto err;
diff --git a/drivers/dma-buf/heaps/cma_heap.c b/drivers/dma-buf/heaps/cma_heap.c
index 3fb4b946c..f721bcb05 100644
--- a/drivers/dma-buf/heaps/cma_heap.c
+++ b/drivers/dma-buf/heaps/cma_heap.c
@@ -13,6 +13,7 @@
 #define pr_fmt(fmt) "cma_heap: " fmt
 
 #include <linux/cma.h>
+#include <linux/capability.h>
 #include <linux/dma-buf.h>
 #include <linux/dma-heap.h>
 #include <linux/dma-map-ops.h>
@@ -26,6 +27,7 @@
 #include <linux/scatterlist.h>
 #include <linux/slab.h>
 #include <linux/vmalloc.h>
+#include <uapi/linux/dma-heap.h>
 
 #define DEFAULT_CMA_NAME "default_cma_region"
 
@@ -278,6 +280,69 @@ static const struct dma_buf_ops cma_heap_buf_ops = {
 	.release = cma_heap_dma_buf_release,
 };
 
+/*
+ * Root-only physical address export for CMA-heap dma-bufs.
+ *
+ * T1100 vendor-compat: the 32-bit MediaTek Vcodec HAL (libvcodecdrv.so)
+ * allocates through /dev/ion and needs the physical address of the buffer to
+ * program the decoder.  The generic pagemap interface refuses VM_PFNMAP
+ * mappings, so the address has to come from the exporter.  The CMA heap is a
+ * single cma_alloc() range, hence physically contiguous by construction; the
+ * contiguity check below is a safety net, and a non-contiguous range is
+ * reported as -ENOTSUPP instead of a bogus address.
+ */
+static long cma_heap_ioctl(struct dma_heap *heap, unsigned int cmd, void *data)
+{
+	struct dma_heap_phys_data *phys = data;
+	struct cma_heap_buffer *buffer;
+	struct dma_buf *dmabuf;
+	unsigned long first_pfn;
+	int fd;
+
+	if (cmd != DMA_HEAP_IOCTL_PHYS)
+		return -ENOTTY;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	fd = (int)phys->fd;
+	if (fd < 0)
+		return -EBADF;
+
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	if (dmabuf->ops != &cma_heap_buf_ops) {
+		dma_buf_put(dmabuf);
+		return -EINVAL;
+	}
+
+	buffer = dmabuf->priv;
+	mutex_lock(&buffer->lock);
+	if (!buffer->pages || !buffer->pagecount) {
+		mutex_unlock(&buffer->lock);
+		dma_buf_put(dmabuf);
+		return -ENODEV;
+	}
+
+	first_pfn = page_to_pfn(buffer->pages[0]);
+	if (page_to_pfn(buffer->pages[buffer->pagecount - 1]) !=
+	    first_pfn + buffer->pagecount - 1) {
+		mutex_unlock(&buffer->lock);
+		dma_buf_put(dmabuf);
+		return -ENOTSUPP;
+	}
+
+	phys->pa = PFN_PHYS(first_pfn);
+	phys->size = buffer->len;
+	phys->flags = DMA_HEAP_PHYS_F_CONTIG | DMA_HEAP_PHYS_F_CMA;
+
+	mutex_unlock(&buffer->lock);
+	dma_buf_put(dmabuf);
+	return 0;
+}
+
 static struct dma_buf *cma_heap_allocate(struct dma_heap *heap,
 					 unsigned long len,
 					 u32 fd_flags,
@@ -367,6 +432,7 @@ static struct dma_buf *cma_heap_allocate(struct dma_heap *heap,
 
 static const struct dma_heap_ops cma_heap_ops = {
 	.allocate = cma_heap_allocate,
+	.ioctl = cma_heap_ioctl,
 };
 
 static int __init __add_cma_heap(struct cma *cma, const char *name)
diff --git a/include/linux/dma-heap.h b/include/linux/dma-heap.h
index 648328a64..319dc26ad 100644
--- a/include/linux/dma-heap.h
+++ b/include/linux/dma-heap.h
@@ -24,6 +24,13 @@ struct dma_heap_ops {
 				    unsigned long len,
 				    u32 fd_flags,
 				    u64 heap_flags);
+
+	/*
+	 * Optional heap-private ioctls.  @data points at a kernel copy of the
+	 * ioctl argument (already sized/zeroed by dma_heap_ioctl) and is copied
+	 * back to userspace on success.  Return -ENOTTY for unknown commands.
+	 */
+	long (*ioctl)(struct dma_heap *heap, unsigned int cmd, void *data);
 };
 
 /**
diff --git a/include/uapi/linux/dma-heap.h b/include/uapi/linux/dma-heap.h
index a4cf716a4..14a1e5eb2 100644
--- a/include/uapi/linux/dma-heap.h
+++ b/include/uapi/linux/dma-heap.h
@@ -50,4 +50,37 @@ struct dma_heap_allocation_data {
 #define DMA_HEAP_IOCTL_ALLOC	_IOWR(DMA_HEAP_IOC_MAGIC, 0x0,\
 				      struct dma_heap_allocation_data)
 
+/**
+ * struct dma_heap_phys_data - physical address of a heap buffer
+ * @fd:		[in] dma-buf fd, must belong to the calling process
+ * @flags:	[out] DMA_HEAP_PHYS_F_* flags
+ * @pa:		[out] physical address of the first byte
+ * @size:	[out] buffer size in bytes
+ *
+ * Passed to DMA_HEAP_IOCTL_PHYS.  The heaps that implement it must be able
+ * to guarantee that the whole range is physically contiguous; currently this
+ * is the CMA ("reserved") heap.  The ioctl is root-only: a physical address
+ * bypasses the IOMMU, so it is a debug/vendor-compat facility, not something
+ * a normal application may use.
+ */
+struct dma_heap_phys_data {
+	__u32 fd;
+	__u32 flags;
+	__u64 pa;
+	__u64 size;
+};
+
+#define DMA_HEAP_PHYS_F_CONTIG		(1U << 0)
+#define DMA_HEAP_PHYS_F_CMA		(1U << 1)
+
+/**
+ * DOC: DMA_HEAP_IOCTL_PHYS - get the physical address of a heap buffer
+ *
+ * Takes a dma_heap_phys_data struct.  Returns -EPERM for non-root callers,
+ * -EINVAL if the fd is not a buffer from this heap, -ENOTTY if the heap has
+ * no physical-address support.
+ */
+#define DMA_HEAP_IOCTL_PHYS	_IOWR(DMA_HEAP_IOC_MAGIC, 0x1,\
+				      struct dma_heap_phys_data)
+
 #endif /* _UAPI_LINUX_DMABUF_POOL_H */
