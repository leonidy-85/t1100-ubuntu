From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonid <leonidy.1985@yandex.ru>
Date: Wed, 25 Nov 2026 10:10:01 +0300
Subject: [PATCH] arm64: dts: add the Fplus T800 (MT6771) board

A second MT6771/MT8788 tablet next to the T1100: 1200x1920 DSI0 HX8279
panel, Silead gslX680 touch, MT6358 + MT6370 (charger, Type-C TCPC). The
file starts as a copy of the T1100 description - the SoC side and the
shared eMMC/SD, USB, PMIC/MT6370, GPU and UART are the same - and the
board facts were cross-checked against the stock T800 DTS, its DTBO and
the live FDT.

P1 scope is booting to console/SSH over USB RNDIS, with eMMC and
microSD working and the GPU/SMI/IOMMU ready for panfrost; display,
touch, sensors, HDMI and audio are left out until their T800 wiring is
proven.

Notable board bits:
- USB is forced to peripheral/high-speed (u2port0 force-device-mode),
  so the RNDIS gadget provides the only interactive channel; the port
  has no SuperSpeed pairs.
- MT6370 on i2c5 carries the charger and the TCPC in PD sink mode
  (5 V/9 V PDOs). No role-switch graph: tcpm would otherwise drive
  mtu3's role and kill the gadget.
- eMMC (MSDC0) gets its pinctrl states because mtk-sd refuses to probe
  without them; microSD is MSDC1 with card detect on GPIO3.
- The GPU stays at the bootloader rate: no OPP table, VSRAM_GPU is
  always-on.
- Own non-nomap ramoops region at 0x70000000, as LK's pstore block is
  nomap and cannot be memremapped.
---
 arch/arm64/boot/dts/mediatek/Makefile         |   1 +
 .../boot/dts/mediatek/mt6771-fplus-t800.dts   | 797 ++++++++++++++++++
 2 files changed, 798 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6771-fplus-t800.dts

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index 485fdfaa1..0e5770ca1 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -2,6 +2,7 @@
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6771-fplus-t1100.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6771-fplus-t800.dtb
 # The MTK LK compatibility layer (-lk-compat.dtsi) needs a __symbols__ entry
 # literally called "gpio" for the vendor dtbo overlay; dtc's gpios_property
 # check mistakes that string for a GPIO specifier.
diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t800.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t800.dts
new file mode 100644
index 000000000..ae1dda2a2
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t800.dts
@@ -0,0 +1,797 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Fplus T800 - MediaTek MT6771V/C (MT8788, Helio P60), ~4 GiB LPDDR4X,
+ * direct MIPI-DSI0 panel Himax HX8279 1200x1920, Silead gslX680 touch,
+ * MT6358 PMIC + MT6370 sub-PMIC (charger, Type-C TCPC).
+ *
+ * P1 board description: boot to console/SSH over USB-RNDIS, eMMC and SD
+ * visible, GPU/SMI/IOMMU ready for panfrost. Display, touch, sensors, HDMI
+ * and audio are deliberately left out - their T800 wiring and drivers are
+ * not proven yet (docs/t800-inventory.md).
+ *
+ * The file is a copy of the T1100 board DTS: the SoC side (mt6771.dtsi =
+ * mt8183.dtsi + MT6771 deltas) and everything that the two tablets share
+ * (eMMC/SD, USB, PMIC/MT6370, GPU, UART) is identical. Board facts below
+ * were cross-checked against the T800 stock DTS and live FDT:
+ *
+ *   /tmp/opencode/t800-adaptation/t800-vendor.dts
+ *   /tmp/opencode/t800-inventory/live-t800.dts
+ *   docs/t800-inventory.md
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/adc/mediatek,mt6370_adc.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/usb/pd.h>
+
+#include "mt6771.dtsi"
+#include "mt6358.dtsi"
+
+/ {
+	model = "Fplus T800";
+	compatible = "fplus,t800", "mediatek,mt6771";
+	chassis-type = "tablet";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+	};
+
+	chosen {
+
+		/*
+		 * No UART is routed to anything accessible on this tablet, so the
+		 * kernel log goes to the screen (once DRM works) and to ramoops in
+		 * RAM. The ramoops window and its geometry are the ones the stock
+		 * kernel used (refs/device/cmdline.txt); the region itself is reserved
+		 * by LK, which is why it must not be declared in /reserved-memory.
+		 *
+		 * maxcpus=1: PSCI is present (stock dmesg: "PSCIv1.0 detected in
+		 * firmware"), but secondary-core bring-up is unrelated to this step and
+		 * a hang there would be invisible. Drop it to get 8 CPUs.
+		 *
+		 * Bring-up switches, both temporary:
+		 *   initcall_debug          - print every initcall with its duration, so
+		 *                             the last line in the RAM log names the
+		 *                             initcall that never returned;
+		 *   regulator_ignore_unused - do not run
+		 *                             regulator_late_cleanup(), which disables
+		 *                             every rail that is on in hardware but has no
+		 *                             consumer in DT (drivers/regulator/core.c
+		 *                             "disabling"). On this board that is VDRAM2 /
+		 *                             VBIF28 - cutting them kills the SoC
+		 *                             silently. The rails the vendor kernel itself
+		 *                             refuses to disable are marked always-on
+		 *                             below, so this switch can go once the
+		 *                             regulator_summary shows them all claimed.
+		 */
+		bootargs = "console=tty0 maxcpus=1 panic=10 loglevel=7 initcall_debug regulator_ignore_unused pstore.backend=ramoops ramoops.mem_address=0x54410000 ramoops.mem_size=0xe0000 ramoops.record_size=0x10000 ramoops.console_size=0x40000 ramoops.pmsg_size=0x10000";
+	};
+
+	/* LK rewrites reg; the tablet has 4 GiB. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 1 0>;
+	};
+
+	/*
+	 * No backlight node in P1. The T800 backlight is DISP_PWM channel 0
+	 * with the enable on GPIO53 (stock ODM: bl-gpios = <&pio 53>), but
+	 * without a panel driver there is nothing to light up, and the LK
+	 * overlay's own /odm/lcd-backlight stays inert anyway.
+	 */
+
+	/* Single-cell Li-ion pack: 7.45 Ah, 4.35 V full (stock T800 gauge). */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		voltage-min-design-microvolt = <3300000>;
+		voltage-max-design-microvolt = <4350000>;
+		energy-full-design-microwatt-hours = <28310000>;
+		charge-full-design-microamp-hours = <7450000>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		key-volume-down {
+			/* stock: gpio-keys with the EINT pad on GPIO93 */
+			gpios = <&pio 93 GPIO_ACTIVE_LOW>;
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <100>;
+		};
+	};
+
+	/*
+	 * I2C level shifter rail. The vendor tree powers it unconditionally;
+	 * nothing on i2c0..6 enumerates without it.
+	 */
+	i2c_vbus: regulator-i2c-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "i2c-vbus";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+	};
+
+	/*
+	 * No panel power switch in P1. The T800 LCM takes its analog rail from
+	 * GPIO69 (avdd) and reset/standby from GPIO45/44; the stale es6311
+	 * "panel@0" node in the stock DT also mentions GPIO55, but the real
+	 * HX8279 panel node does not, so the line is left to LK and to the
+	 * panel driver added in P2.
+	 */
+
+	/* Main rail feeding the MT6358 bucks on this board. */
+	reg_vsys: regulator-vsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vsys";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Stock ODM overlay nodes, kept for traceability. Nothing binds to them
+	 * in mainline and LK merges its own T800 overlay into /odm at boot.
+	 * T800 wiring (t800-vendor-dtbo.dts, fragment@0):
+	 *   lcm avdd 69, rst 45, stby 44, bl 53 (PWM ch0),
+	 *   touch reset 158, touch analog rail = MT6358 VLDO28.
+	 */
+	odm {
+		lcm {
+			compatible = "elink,lcm";
+			avdd-gpios = <&pio 69 GPIO_ACTIVE_HIGH>;
+			rst-gpios = <&pio 45 GPIO_ACTIVE_HIGH>;
+			stby-gpios = <&pio 44 GPIO_ACTIVE_HIGH>;
+			bl-gpios = <&pio 53 GPIO_ACTIVE_HIGH>;
+			ts-rst-gpios = <&pio 158 GPIO_ACTIVE_HIGH>;
+			status = "disabled";
+		};
+
+		lcd-backlight {
+			compatible = "mediatek,lcd-backlight";
+			led_mode = <5>;
+			data = <1>;
+			pwm_config = <4 0 0 0 0>;
+			status = "disabled";
+		};
+	};
+};
+
+
+/*
+ * UART0 is wired to test pads only; enabled so that the clock gate and the
+ * driver are exercised, but not on the command line. With a probe attached,
+ * add "console=ttyS0,921600n8 earlycon=mtk8250,0x11002000".
+ */
+&uart0 {
+	status = "okay";
+};
+
+/*
+ * I2C0: touch controller. This is the *only* bus with a Silead chip:
+ * stock sysfs (inventory/sys/i2c-clean.txt) has
+ *   0-0040 name=silead_touch driver=mtk-tpd of=/i2c@11007000/silead_touch@40
+ *   6-0040 name=MicArray_0  driver=es7210    of=/i2c@11005000/es7210_mic@40
+ * so the vendor DTBO "fragment@8" touch child lands here and 0x40 on i2c6 is
+ * the ES7210 audio codec, not the touch. The earlier "touch on i2c6" DTS was
+ * wrong: every firmware write went to the codec, which is why the load
+ * "failed at record ~4000..4553" and why IRQ 1 (TOUCH_PANEL-eint) stayed 0.
+ *
+ * Wiring (t800-vendor-dtbo.dts: fragment@8/@21, live DT node "touch"):
+ *   EINT GPIO1 (level, active low), reset GPIO158 (LK leaves it low,
+ *   vendor driver pulses it and parks it high), analog rail VLDO28.
+ *
+ * Status: probe still fails with "Chip ID read error -6" on this board even
+ * though the pads are right (vendor pin table: GPIO82=SDA0, GPIO83=SCL0 and
+ * they are the only pads with those functions). Verified by bit-banging the
+ * pads from userspace with a harness that does see i2c1 (0x30/0x57/0x68) and
+ * i2c5 (0x34/0x4e): nothing answers at 0x40 on 82/83 with any reset polarity,
+ * with vcn28/vldo28 both on, and with every free GPIO toggled. So this is not
+ * a DT/mux problem any more; see docs/touch-bringup-log.md.
+ */
+&i2c0 {
+	vbus-supply = <&i2c_vbus>;
+	status = "okay";
+
+	touchscreen@40 {
+		compatible = "silead,gsl1680";
+		reg = <0x40>;
+
+		interrupt-parent = <&pio>;
+		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
+
+		/* vendor DTBO: rst-gpio = <&pio 158 0>; parked high = released */
+		power-gpios = <&pio 158 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&mt6358_vcn18_reg>;
+		avdd-supply = <&mt6358_vldo28_reg>;
+
+		touchscreen-size-x = <1200>;
+		touchscreen-size-y = <1920>;
+		silead,max-fingers = <5>;
+
+		status = "okay";
+	};
+};
+
+/*
+ * I2C3: on T1100 this was the IT6112 DSI bridge plus IT66121 HDMI. On T800
+ * the panel is on DSI0 directly (no bridge) and the HDMI bridge (IT66121
+ * @0x4c, power GPIO54/176) has no mainline driver. The bus stays up, but no
+ * panel/HDMI children are described in P1; the T800 stock DTBO adds its own
+ * i2c3 devices (including IT66121) at boot.
+ */
+&i2c3 {
+	vbus-supply = <&i2c_vbus>;
+	status = "okay";
+};
+
+/*
+ * I2C5: MT6370 sub-PMIC: DSV rails for the panel (vpos/vneg), the battery
+ * charger and (see &i2c5 below the regulators) the Type-C port controller.
+ *
+ * mt6370_probe() instantiates one platform device per MFD_CELL_OF
+ * (drivers/mfd/mt6370.c:133) and only for children that exist in DT, so a
+ * child node is the on/off switch for a sub-driver. The flashlight and
+ * indicator children of the vendor description are still absent on purpose.
+ */
+&i2c5 {
+	vbus-supply = <&i2c_vbus>;
+	status = "okay";
+
+	pmic@34 {
+		compatible = "mediatek,mt6370";
+		reg = <0x34>;
+		wakeup-source;
+
+		interrupts-extended = <&pio 10 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		mt6370_adc: adc {
+			compatible = "mediatek,mt6370-adc";
+			#io-channel-cells = <1>;
+		};
+
+		/*
+		 * Battery charger. The three IRQs are hw numbers inside the
+		 * MT6370 irqchip above (drivers/mfd/mt6370.h: 68 =
+		 * MT6370_IRQ_OVPCTRL_UVP_D "cable plugged", 48 =
+		 * MT6370_IRQ_ATTACH "BC1.2 done", 6 = MT6370_IRQ_CHG_MIVR);
+		 * regmap-irq uses the ID as the array index, so the numbers
+		 * are stable ABI and not register offsets. Same set as the
+		 * mt6771-next port of this board.
+		 *
+		 * io-channels order must match the driver's index, it reads
+		 * priv->iio_adcs[MT6370_ADC_CHAN_IBUS] = entry #5
+		 * (mt6370-charger.c:345,376), so "ibus" may not move and the
+		 * list may not be shortened below 6. The ADC channels are
+		 * only used for the MIVR workaround, charging itself does not
+		 * need them.
+		 */
+		charger {
+			compatible = "mediatek,mt6370-charger";
+			interrupts = <68>, <48>, <6>;
+			interrupt-names = "uvp_d_evt", "attach_i", "mivr";
+
+			io-channels = <&mt6370_adc MT6370_CHAN_VBUSDIV5>,
+				      <&mt6370_adc MT6370_CHAN_VBUSDIV2>,
+				      <&mt6370_adc MT6370_CHAN_VSYS>,
+				      <&mt6370_adc MT6370_CHAN_VBAT>,
+				      <&mt6370_adc MT6370_CHAN_TS_BAT>,
+				      <&mt6370_adc MT6370_CHAN_IBUS>,
+				      <&mt6370_adc MT6370_CHAN_IBAT>;
+		};
+
+		/*
+		 * Type-C port controller, sink only.
+		 *
+		 * The alert pad is GPIO41 (stock DT: mt6370_pd_eint,
+		 * interrupts = <0x29 ...>; mt6771-next: <&pio 41>), and it is
+		 * a different pad from the PMIC interrupt on GPIO10 above.
+		 * interrupts-extended is mandatory here: the node's parent is
+		 * the MT6370 irqchip, so plain "interrupts" would be decoded
+		 * as an MT6370 hw number.
+		 *
+		 * The connector child is mandatory, tcpci_parse_config() fails
+		 * with "Can't find connector node." without a child named
+		 * exactly "connector" (drivers/usb/typec/tcpm/tcpci.c:
+		 * tcpci_parse_config), and tcpci_mt6370 then hands that
+		 * fwnode to tcpm_register_port(). power-role is mandatory
+		 * there (typec_get_fw_cap(), drivers/usb/typec/class.c:2233);
+		 * with power-role = "sink" tcpm never reads source-pdos and
+		 * never tries to source VBUS (tcpm.c:7287), while sink-pdos
+		 * is required for a sink port (tcpm.c:7315).
+		 *
+		 * Deliberately no ports/endpoint graph to &ssusb and no
+		 * usb-role-switch on &ssusb: tcpm finds a role switch through
+		 * the connector's graph endpoints (fwnode_connection_find_
+		 * match -> fwnode_graph_devcon_matches, drivers/base/
+		 * property.c:1293) and would then drive mtu3's role. mtu3
+		 * only registers that switch when its node has
+		 * "usb-role-switch" and dr_mode != peripheral
+		 * (mtu3_plat.c:275/302), and its default role is host unless
+		 * role-switch-default-mode says otherwise (mtu3_dr.c:287).
+		 * So the graph link would either flip our RNDIS port to host
+		 * or - in peripheral mode - make tcpm defer forever on a role
+		 * switch nobody registers. Neither is needed to charge: the
+		 * charger above is an independent BC1.2 engine.
+		 *
+		 * PD is on: pd-disable is gone, so tcpm runs the PD state
+		 * machine. Two things matter for our USB network. First, the
+		 * role-switch paragraph above still holds and the connector
+		 * must not grow graph endpoints now that PD is enabled:
+		 * otherwise tcpm would drive mtu3's role on a power-role
+		 * change and the RNDIS gadget, our only SSH channel, would
+		 * die. Second, sink-pdos has to list every voltage we want to
+		 * accept: the contract is picked by matching the sink PDOs
+		 * against the source PDOs (tcpm_pd_select_pdo), so a single
+		 * 5 V entry keeps the port at 5 V no matter what the charger
+		 * offers. 9 V/2 A plus op-sink-microwatt = 18 W is what makes
+		 * an 18 W PD charger switch to 9 V.
+		 *
+		 * typec-power-opmode is only read on the non-PD path
+		 * (tcpm_fw_get_caps requires it when pd-disable is set), so it
+		 * stays as a guard in case PD gets disabled again: without it
+		 * probe fails with -EINVAL and -22.
+		 *
+		 * PD does not raise the charge current by itself: mt6370-tcpc
+		 * has no set_current_limit() callback, so tcpm only records
+		 * the contract in tcpm-source-psy-* and the charger keeps its
+		 * IAICR. Userspace applies the contract
+		 * (usr/local/bin/t1100-charge.sh pd).
+		 */
+		tcpc {
+			compatible = "mediatek,mt6370-tcpc";
+			interrupts-extended = <&pio 41 IRQ_TYPE_LEVEL_LOW>;
+			status = "okay";
+
+			connector {
+				compatible = "usb-c-connector";
+				label = "USB-C";
+
+				power-role = "sink";
+				data-role = "device";
+				typec-power-opmode = "default";
+				op-sink-microwatt = <18000000>;
+
+				sink-pdos = <PDO_FIXED(5000, 3000,
+						       PDO_FIXED_USB_COMM)
+					     PDO_FIXED(9000, 2000,
+						       PDO_FIXED_USB_COMM)>;
+			};
+		};
+
+		regulators {
+			dsvbst {
+				regulator-name = "mt6370-dsv-vbst";
+				regulator-min-microvolt = <4000000>;
+				regulator-max-microvolt = <6200000>;
+			};
+
+			mt6370_dsvpos: dsvpos {
+				regulator-name = "mt6370-dsv-vpos";
+				regulator-min-microvolt = <4000000>;
+				regulator-max-microvolt = <6000000>;
+			};
+
+			mt6370_dsvneg: dsvneg {
+				regulator-name = "mt6370-dsv-vneg";
+				regulator-min-microvolt = <4000000>;
+				regulator-max-microvolt = <6000000>;
+			};
+
+			vibldo {
+				regulator-name = "mt6370-vib-ldo";
+				regulator-min-microvolt = <1600000>;
+				regulator-max-microvolt = <4000000>;
+			};
+		};
+	};
+};
+
+/*
+ * I2C6: T800 has ES7210 mic array (@0x40) and two charger candidates
+ * (SGM41513 @0x1a, BQ25601 @0x6b). Audio is out of P1 scope and a wrong
+ * charge profile on an unknown pack is a risk, so only the disabled
+ * SGM41513 node is kept from the shared description.
+ */
+&i2c6 {
+	vbus-supply = <&i2c_vbus>;
+	status = "okay";
+
+	charger@1a {
+		compatible = "sgmicro,sgm41513", "ti,bq25601";
+		reg = <0x1a>;
+		status = "disabled";
+
+		monitored-battery = <&battery>;
+		ti,watchdog-timeout-ms = <0>;
+		ti,no-thermistor;
+		input-current-limit-microamp = <3000000>;
+	};
+};
+
+/*
+ * eMMC: MSDC0, HS400, 8 bit, on MT6358 VEMC/VIO18.
+ *
+ * mtk-sd refuses to probe without pinctrl states ("Cannot find pinctrl",
+ * drivers/mmc/host/mtk-sd.c: devm_pinctrl_get() + pinctrl_lookup_state()
+ * for "default" and "state_uhs"), so both states must exist even though LK
+ * has already muxed MSDC0 to load the kernel. The pin numbers/functions come
+ * from refs/mt6771-next/mt8788-fplus-t1100.dts (same board, mt8183 pin table)
+ * and, for every pin used here, exist in mt8183-pinfunc.h with the MSDC0
+ * function at the same pin number. Electrical settings (drive strength, pull)
+ * are deliberately left to LK: this state only re-asserts the mux so that the
+ * driver can select it; if MT6771's pad map ever turns out to differ from
+ * MT8183's, the symptom is a dead eMMC in the kernel (no mmcblk0), not a
+ * brick - LK re-muxes the pads on every boot.
+ */
+&mmc0 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc0_pins_default>;
+	pinctrl-1 = <&mmc0_pins_uhs>;
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	cap-mmc-highspeed;
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+	cap-mmc-hw-reset;
+	no-sdio;
+	no-sd;
+	hs400-ds-delay = <0x12814>;
+	vmmc-supply = <&mt6358_vemc_reg>;
+	vqmmc-supply = <&mt6358_vio18_reg>;
+	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC50_0>;
+	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_CK>;
+	non-removable;
+};
+
+/* microSD slot: MSDC1, card detect on GPIO3. */
+&mmc1 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc1_pins_default>;
+	pinctrl-1 = <&mmc1_pins_uhs>;
+	bus-width = <4>;
+	max-frequency = <200000000>;
+	cap-sd-highspeed;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	sd-uhs-ddr50;
+	vmmc-supply = <&mt6358_vmch_reg>;
+	vqmmc-supply = <&mt6358_vmc_reg>;
+	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC30_1>;
+	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_D2>;
+	cd-debounce-delay-ms = <0>;
+	cd-gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
+};
+
+/*
+ * Pad states for the two MMC controllers. Only the mux function (and
+ * input-enable on the data/cmd lines) is set: LK has already programmed drive
+ * strength and pulls for eMMC boot, and keeping that untouched is the least
+ * invasive way to find out whether MT6771's pads really follow the MT8183
+ * table. Pin numbers/functions: refs/mt6771-next/mt8788-fplus-t1100.dts
+ * (mmc0_pins_default/uhs, mmc1_pins_default) - see the comment at &mmc0.
+ */
+&pio {
+	mmc0_pins_default: mmc0-pins-default {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO122__FUNC_MSDC0_CMD>,
+				 <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
+				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
+				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
+				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
+				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
+				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
+				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
+				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>;
+			input-enable;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
+		};
+
+		pins-rst {
+			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
+		};
+	};
+
+	mmc0_pins_uhs: mmc0-pins-uhs {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO122__FUNC_MSDC0_CMD>,
+				 <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
+				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
+				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
+				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
+				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
+				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
+				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
+				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>;
+			input-enable;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
+		};
+
+		pins-rst {
+			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
+		};
+	};
+
+	mmc1_pins_default: mmc1-pins-default {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
+				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
+				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
+				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
+				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
+			input-enable;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
+		};
+	};
+
+	mmc1_pins_uhs: mmc1-pins-uhs {
+		pins-cmd-dat {
+			pinmux = <PINMUX_GPIO31__FUNC_MSDC1_CMD>,
+				 <PINMUX_GPIO32__FUNC_MSDC1_DAT0>,
+				 <PINMUX_GPIO34__FUNC_MSDC1_DAT1>,
+				 <PINMUX_GPIO33__FUNC_MSDC1_DAT2>,
+				 <PINMUX_GPIO30__FUNC_MSDC1_DAT3>;
+			input-enable;
+		};
+
+		pins-clk {
+			pinmux = <PINMUX_GPIO29__FUNC_MSDC1_CLK>;
+		};
+	};
+};
+
+/*
+ * USB: the port is USB 2.0 only on this board (no SuperSpeed pairs), and the
+ * data role is fixed to peripheral so that the kernel exposes a UDC and the
+ * userspace can bring up an RNDIS/CDC-Ether gadget - the only interactive
+ * channel we have until a rootfs boots on its own. Host mode needs the
+ * MT6370 TCPC and role switching in phy-mtk-tphy
+ * (refs/mt6771-next/patches/96fe48bed8), neither of which is in 6.12.
+ */
+&ssusb {
+	status = "okay";
+	dr_mode = "peripheral";
+	vusb33-supply = <&mt6358_vusb_reg>;
+	maximum-speed = "high-speed";
+	mediatek,u3p-dis-msk = <1>;
+	wakeup-source;
+};
+
+&usb_host {
+	vusb33-supply = <&mt6358_vusb_reg>;
+	status = "okay";
+};
+
+&u2port0 {
+	mediatek,pre-emphasis = <3>;
+	/*
+	 * MT6771 does not bring its U2 PHY out of host mode on its own and the
+	 * Type-C role/VBUS inputs run through the (currently disabled) MT6370,
+	 * so the PHY never sees a valid device session and the MAC's SOFTCONN
+	 * pull-up stays off the wire. Force device mode in the T-PHY.
+	 */
+	mediatek,force-device-mode;
+	status = "okay";
+};
+
+/*
+ * GPU: Mali-G72 MP3, the same Bifrost core as MT8183, so panfrost binds
+ * through "mediatek,mt8183b-mali" inherited from mt8183.dtsi. That variant
+ * consumes a single supply, "mali" (VGPU), and expects the three MFG power
+ * domains ("core0", "core1", "core2", with MFG_ASYNC and MFG as their
+ * parents). VSRAM_GPU is the SRAM rail of the same block: it is *not*
+ * requested by the driver, so it is kept on with regulator-always-on below -
+ * drop that and regulator_late_cleanup() kills the GPU SRAM.
+ *
+ * Regulator coupling is deliberately not used: the generic coupler only
+ * accepts *always-on* regulators (drivers/regulator/core.c, "Coupling of a
+ * non always-on regulator is unimplemented") and mt6358_regulator_probe()
+ * aborts on the first rail it cannot register, so one -ENOTSUPP for VGPU
+ * removed *every* MT6358 rail and kept eMMC, USB and the whole MM stack in
+ * deferred probe (docs/bringup-log.md, 30.10).
+ *
+ * DVFS is off for the first bring-up: without operating-points-v2 panfrost
+ * skips devfreq/OPP entirely (panfrost_devfreq_init() -> -ENODEV -> "continue
+ * without devfreq") and only enables VGPU through panfrost_regulator_init(),
+ * leaving both rails at the boot values the bootloader and the vendor
+ * gpufreq driver leave behind. The stock 4.14 log (refs/device/dmesg-stock)
+ * prints those values and the reason they must not be moved independently:
+ *
+ *   VGPU is enabled = 1 (900 mV), VSRAM_GPU is enabled = 1 (1000 mV)
+ *   current freq = 800000 KHz, current volt = 825000 uV
+ *        g_cur_opp_volt = 82500, g_cur_opp_vsram_volt = 92500
+ *
+ * i.e. the vendor keeps VSRAM exactly 100 mV above VGPU (the limit
+ * mt8183-kukui encodes as regulator-coupled-max-spread = <100000>) and moves
+ * both rails together. We cannot: one supply per driver + no coupler, so an
+ * OPP-driven VGPU drop to 625-825 mV would leave VSRAM at 1000 mV, i.e. up to
+ * 375 mV apart. At probe the mfg mux reads 512 MHz (the vendor driver read
+ * 512001 kHz before it raised the rate to 800 MHz), which is a perfectly
+ * usable GPU clock, so nothing is lost by not touching it: the GPU runs at
+ * the rate the bootloader left. Revisit DVFS once VSRAM can be driven
+ * together with VGPU (always-on coupling or a OPP table with both rails).
+ */
+&gpu {
+	mali-supply = <&mt6358_vgpu_reg>;
+	/delete-property/ operating-points-v2;
+	status = "okay";
+};
+
+/* Only the GPU used it; leaving it behind would invite a DVFS enable by accident. */
+/delete-node/ &gpu_opp_table;
+
+/*
+ * The two MFG power domains carry MTK_SCPD_DOMAIN_SUPPLY, and since 6.12
+ * mtk-pm-domains looks the regulator up in the *domain* node itself
+ * (drivers/pmdomain/mediatek/mtk-pm-domains.c, "Find regulator in current
+ * power domain node"). Without the property the lookup fails and
+ * scpsys_probe() returns an error, so the power-controller never registers -
+ * and then mutex, ovl, rdma, dsi, larb*, smi, pwm and mfgcfg all defer
+ * forever. mt8183-kukui.dtsi uses exactly this assignment on the same PMIC.
+ */
+&mfg_async {
+	domain-supply = <&mt6358_vsram_gpu_reg>;
+};
+
+&mfg {
+	domain-supply = <&mt6358_vgpu_reg>;
+};
+
+/*
+ * Bounds from the vendor tables: the GPU OPPs top out at 800 MHz / 825 mV
+ * VGPU, the bootloader hands the kernel 900 mV VGPU and 1000 mV VSRAM_GPU
+ * (both printed by the stock gpufreq probe, see &gpu above). Nothing in the
+ * mainline tree writes these rails today - panfrost only enables VGPU - but
+ * the limits keep a future DVFS table from going outside the PMIC's range.
+ */
+&mt6358_vgpu_reg {
+	regulator-min-microvolt = <625000>;
+	regulator-max-microvolt = <900000>;
+};
+
+&mt6358_vsram_gpu_reg {
+	regulator-min-microvolt = <850000>;
+	regulator-max-microvolt = <1000000>;
+	regulator-always-on;
+};
+
+/*
+ * Rails the bootloader leaves enabled and that must never be switched off by
+ * the kernel. The evidence is the vendor driver itself: in the stock 4.14 boot
+ * log (refs/stock-mt6771.dts era) mt6358 refuses to disable VDRAM1, VCORE,
+ * VPROC12, VS2, VMODEM, VS1, VDRAM2, VIO18, VSRAM_OTHERS, VXO22, VAUX18,
+ * VBIF28, VSRAM_PROC12, VIO28, VA12 and VAUD28
+ * ("mt6358_regulator_disable:VDRAM2 should not be disable.(use_count=0)").
+ * mt6358.dtsi in mainline already marks most of them always-on; the five
+ * missing ones are listed here. VDRAM2 is the LPDDR4X 1.1 V rail and VBIF28
+ * the DRAM interface bias - mainline's regulator_late_cleanup() disables any
+ * enabled rail that has no consumer in DT, and cutting either of those two
+ * freezes the SoC before anything can be printed.
+ */
+&mt6358_vdram2_reg {
+	regulator-always-on;
+};
+
+&mt6358_vbif28_reg {
+	regulator-always-on;
+};
+
+&mt6358_vaux18_reg {
+	regulator-always-on;
+};
+
+&mt6358_vio28_reg {
+	regulator-always-on;
+};
+
+&mt6358_vaud28_reg {
+	regulator-always-on;
+};
+
+/*
+ * VCN28 (2.8 V) is enabled in the stock boot but has no consumer in the
+ * vendor DT at all (checked all of live-t800.dts for phandle 0x7d), so some
+ * vendor code turns it on. On T1100 the equivalent rail feeds the I2C level
+ * shifters; on T800 it is the last 2.8 V rail that differs between the stock
+ * boot and ours, hence always-on here as well.
+ */
+&mt6358_vcn28_reg {
+	regulator-always-on;
+};
+
+&mt6358regulator {
+	vsys-ldo1-supply = <&reg_vsys>;
+	vsys-ldo2-supply = <&reg_vsys>;
+	vsys-ldo3-supply = <&reg_vsys>;
+	vsys-vcore-supply = <&reg_vsys>;
+	vsys-vdram1-supply = <&reg_vsys>;
+	vsys-vgpu-supply = <&reg_vsys>;
+	vsys-vmodem-supply = <&reg_vsys>;
+	vsys-vpa-supply = <&reg_vsys>;
+	vsys-vproc11-supply = <&reg_vsys>;
+	vsys-vproc12-supply = <&reg_vsys>;
+	vsys-vs1-supply = <&reg_vsys>;
+	vsys-vs2-supply = <&reg_vsys>;
+	vs1-ldo1-supply = <&mt6358_vs1_reg>;
+	vs2-ldo1-supply = <&mt6358_vs2_reg>;
+	vs2-ldo2-supply = <&mt6358_vs2_reg>;
+	vs2-ldo3-supply = <&mt6358_vs2_reg>;
+	vs2-ldo4-supply = <&mt6358_vs2_reg>;
+};
+
+/* PMIC interrupt is EINT 182 (stock: mt6358-pmic, interrupts = <0xb6 4 ...>). */
+&pmic {
+	interrupts-extended = <&pio 182 IRQ_TYPE_LEVEL_HIGH>;
+};
+
+/* PMIC keys: power on PWRKEY, volume up on HOMEKEY. */
+&mt6358keys {
+	power-off-time-sec = <10>;
+	mediatek,long-press-mode = <1>;
+
+	home {
+		linux,keycodes = <KEY_VOLUMEUP>;
+		label = "Volume Up";
+	};
+};
+
+/*
+ * Display: deliberately off in P1. mmsys/ovl/rdma/color/ccorr/aal/gamma/
+ * dither/dsi/mipi_tx0 are all described by mt8183.dtsi and dsi0 is disabled
+ * there; with no panel attached mediatek-drm has no connector and creates no
+ * CRTC. The T800 panel is a direct DSI0 HX8279 (1200x1920, reset 45, stby 44,
+ * avdd 69, backlight PWM ch0 + GPIO53) and will be wired here in P2, once
+ * the board is proven to boot. The matching driver is already built in:
+ * CONFIG_DRM_PANEL_BOE_HIMAX8279D ("boe,himax8279d8p").
+ */
+
+/*
+ * LK compatibility layer: must be included last (docs/lk-dtb-rules.md).
+ */
+#include "mt6771-fplus-t1100-lk-compat.dtsi"
+
+/*
+ * Own pstore/ramoops region. LK reserves its ram_console/pstore blocks as
+ * `nomap` (T800: pstore 0x54410000+0xe0000, ram_console 0x54400000+0x10000,
+ * ATF 0x54600000, minirdump 0x544f0000), and mainline ramoops cannot
+ * memremap() a nomap region, so /sys/fs/pstore stays empty. This 1 MiB block
+ * at 0x70000000 sits inside System RAM and overlaps no T800 LK reservation
+ * (the gap between ATF/minirdump at 0x546xxxxx and the framebuffer starting
+ * at 0x7dce0000 is free), so pstore works and survives a warm reboot.
+ */
+&{/reserved-memory} {
+	#address-cells = <2>;
+	#size-cells = <2>;
+	ranges;
+
+	ramoops@70000000 {
+		compatible = "ramoops";
+		reg = <0 0x70000000 0 0x100000>;
+		record-size  = <0x20000>;
+		console-size = <0x80000>;
+		pmsg-size    = <0x20000>;
+	};
+};
