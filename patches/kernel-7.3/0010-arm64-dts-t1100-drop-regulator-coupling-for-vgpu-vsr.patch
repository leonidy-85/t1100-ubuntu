From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Fri, 30 Oct 2026 16:54:41 +0300
Subject: [PATCH] arm64: dts: t1100: drop regulator coupling for vgpu/vsram_gpu

mt6358-regulator fails to probe ('vgpu: failed to get coupler: -ENOTSUPP'),
which leaves every PMIC rail unregistered; mtk-pm-domains then fails with
'failed to get power supply' and mmc/usb/gpu/display all defer forever.
---
 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index cebc5fd36..a75445bd6 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -386,15 +386,11 @@ &mfg {
 &mt6358_vgpu_reg {
 	regulator-min-microvolt = <625000>;
 	regulator-max-microvolt = <900000>;
-	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
-	regulator-coupled-max-spread = <100000>;
 };
 
 &mt6358_vsram_gpu_reg {
 	regulator-min-microvolt = <850000>;
 	regulator-max-microvolt = <1000000>;
-	regulator-coupled-with = <&mt6358_vgpu_reg>;
-	regulator-coupled-max-spread = <100000>;
 	regulator-always-on;
 };
 
