From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Fri, 30 Oct 2026 17:47:18 +0300
Subject: [PATCH] soc: mediatek: mtk-ramconsole: actually write the log into
 LK's ramoops zone

The driver added for bring-up never wrote a single byte. It located the
zone with of_find_compatible_node(NULL, NULL, "ramoops"), but this board
has no ramoops device tree node at all - ramoops is instantiated from
kernel parameters ("ramoops: using module parameters" in dmesg) - so
mrcm_locate_zone() bailed out immediately, nzones stayed 0 and
mrcm_init() returned -ENODEV. That is why a boot which hangs before
postcore_initcall leaves nothing behind: the only console in that window
is the one this driver was supposed to provide.

Rework it around the two things that are actually guaranteed to be there:

 * zone discovery from the reserved-memory children the bootloader
   creates itself (mblock-N-pstore) or from the ramoops.mem_*/ramoops.
   console_size parameters, with a real "ramoops" node still preferred
   when someone adds one later;
 * snapshots instead of a permanent console: register a console with
   CON_PRINTBUFFER (printk replays the whole ring buffer, from
   "[0.000000] Linux version" on), then unregister it again. Done at
   early_initcall and at postcore_initcall_sync, so the window before
   ramoops registers is covered without a second writer fighting
   persistent_ram over the same header. After that ramoops owns the ring
   and keeps appending to exactly the same zone.

The TOPRGU watchdog is still stopped first, so a hang stays a hang instead
of a reset loop.

Signed-off-by: bringup <bringup@t1100.local>
---
 drivers/soc/mediatek/mtk-ramconsole.c | 282 +++++++++++++++++---------
 1 file changed, 184 insertions(+), 98 deletions(-)

diff --git a/drivers/soc/mediatek/mtk-ramconsole.c b/drivers/soc/mediatek/mtk-ramconsole.c
index bad8232e4..60f6982d6 100644
--- a/drivers/soc/mediatek/mtk-ramconsole.c
+++ b/drivers/soc/mediatek/mtk-ramconsole.c
@@ -1,31 +1,57 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Minimal early RAM console for MediaTek bring-up.
+ * Early RAM console ("black box") for the Fplus T1100 (MT6771) bring-up.
  *
- * The FPlus T1100 has no accessible UART and no display stack yet, so an early
- * boot failure is invisible: the first test boot just resets in a loop. The
- * vendor recovery exposes /proc/last_kmsg, and with CONFIG_PSTORE_CONSOLE its
- * content comes from the *ramoops console zone* in RAM, which survives a warm
- * reset. So this driver registers a console at early_initcall time and writes
- * printk straight into that zone using the standard persistent_ram layout:
+ * The tablet has no accessible UART and no display stack yet, so an early
+ * boot failure is otherwise invisible: the board just sits there and any
+ * driver that cuts a rail takes the DRAM contents with it. The vendor
+ * recovery exposes /proc/last_kmsg, and its contents come from the ramoops
+ * console zone in DRAM, which survives a warm reset.
  *
- *   u32 sig = 0x43474244 ("DBGC"), u32 start, u32 size, then a ring of text
+ * The kernel already has a working path into that zone: ramoops itself
+ * (CONFIG_PSTORE_CONSOLE) registers a console and, because the console is
+ * registered with CON_PRINTBUFFER, replays the whole printk ring buffer -
+ * that is why the log of a successful boot starts at "[0.000000] Linux
+ * version". The problem is that ramoops only comes up at postcore_initcall
+ * time; everything before that (setup_arch, early_initcall, core_initcall,
+ * and any bus hang caused by a driver) is invisible.
  *
- * The zone is located from the "ramoops" DT node exactly like
- * ramoops_init_prz() does: it starts after the dmesg records and is
- * console-size bytes long.
+ * This driver closes that window without ever competing with ramoops:
  *
- * With this the failing boot is readable from recovery:
- *   head -c 4096 /proc/last_kmsg | strings
+ *   1. it stops the TOPRGU watchdog as the very first thing, so a hang stays
+ *      a hang instead of a silent reset loop;
+ *   2. at early_initcall and at postcore_initcall_sync it takes a *snapshot*
+ *      of the printk ring buffer into the same console zone ramoops will use:
+ *      register a console with CON_PRINTBUFFER, let printk replay the ring,
+ *      unregister it again. No second writer, no bookkeeping to keep in sync
+ *      with persistent_ram, and after the second snapshot ramoops takes over
+ *      and appends to the same ring.
  *
- * Bring-up aid only; disable once a real console exists.
+ * Zone discovery, in order:
+ *   a) a "ramoops" device tree node, if one is ever added (mainline layout:
+ *      console zone starts after the record area);
+ *   b) the reserved-memory children the bootloader creates itself
+ *      (mblock-N-pstore, mblock-N-ram_console, ...). They cannot be declared
+ *      in our DTS - MTK LK spins forever if a static region overlaps one of
+ *      its own reservations (docs/lk-dtb-rules.md) - but they *are* present
+ *      in the device tree LK hands over, so they can be re-used;
+ *   c) the ramoops.* kernel parameters, which is how this board configures
+ *      ramoops ("ramoops: using module parameters" in the log).
+ *
+ * The first version of this driver only looked for (a) and therefore did
+ * nothing at all on this board: of_find_compatible_node(NULL, NULL, "ramoops")
+ * returned NULL, nzones stayed 0 and the driver bailed out with -ENODEV.
+ *
+ * Bring-up aid only; remove once a real console exists.
  */
 
-#define pr_fmt(fmt) "mtk-ramconsole: " fmt
+#define pr_fmt(fmt) "mrcm: " fmt
 
 #include <linux/console.h>
 #include <linux/init.h>
 #include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/string.h>
@@ -33,119 +59,171 @@
 #define PERSISTENT_RAM_SIG	0x43474244u	/* "DBGC" */
 #define PR_HEADER_SIZE		12		/* sig, start, size */
 
-struct mrcm_zone {
-	u8 __iomem *base;	/* first byte of the zone */
-	u32 size;		/* including the 12-byte header */
-	u32 start;
-	u32 len;
-};
-
-/*
- * Two candidates: the zone computed the mainline way (after the dmesg
- * records) and the very start of the reserved region. The vendor ramoops
- * layout is expected to match the first one; the second is written in case
- * this firmware orders the zones differently. A bogus sig in an unused zone
- * is ignored by pstore.
- */
+static u8 __iomem *mrcm_base;
+static u32 mrcm_size;		/* whole zone, including the header */
+static u32 mrcm_start;
+static u32 mrcm_len;
 static bool mrcm_wdt_was_on;
-static struct mrcm_zone zones[3];
-static unsigned int nzones;
 
-static void mrcm_kick(struct mrcm_zone *z)
+static void mrcm_kick(void)
 {
-	writel(z->start, z->base + 4);
-	writel(z->len, z->base + 8);
+	writel(mrcm_start, mrcm_base + 4);
+	writel(mrcm_len, mrcm_base + 8);
 }
 
 static void mrcm_console_write(struct console *con, const char *s,
 			       unsigned int count)
 {
-	unsigned int i, k;
+	u32 ring = mrcm_size - PR_HEADER_SIZE;
+	unsigned int i;
 
-	for (k = 0; k < nzones; k++) {
-		struct mrcm_zone *z = &zones[k];
-		u32 ring = z->size - PR_HEADER_SIZE;
-
-		if (!ring)
-			continue;
+	if (!ring)
+		return;
 
-		for (i = 0; i < count; i++) {
-			if (z->len < ring) {
-				writeb(s[i], z->base + PR_HEADER_SIZE +
-				       ((z->start + z->len) % ring));
-				z->len++;
-			} else {
-				writeb(s[i], z->base + PR_HEADER_SIZE +
-				       z->start);
-				z->start = (z->start + 1) % ring;
-			}
+	for (i = 0; i < count; i++) {
+		if (mrcm_len < ring) {
+			writeb(s[i], mrcm_base + PR_HEADER_SIZE +
+			       ((mrcm_start + mrcm_len) % ring));
+			mrcm_len++;
+		} else {
+			writeb(s[i], mrcm_base + PR_HEADER_SIZE + mrcm_start);
+			mrcm_start = (mrcm_start + 1) % ring;
 		}
-		mrcm_kick(z);
 	}
+	mrcm_kick();
 }
 
 static struct console mrcm_console = {
 	.name	= "mrcm",
 	.write	= mrcm_console_write,
-	.flags	= CON_PRINTBUFFER,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED,
 	.index	= -1,
 };
 
-static void __init mrcm_locate_zone(void)
+/* ramoops.<name>=<value> from the command line; values are 0x-prefixed. */
+static bool __init mrcm_param(const char *name, unsigned long *val)
+{
+	char key[64];
+	const char *p = saved_command_line;
+	char *end;
+	size_t len;
+
+	snprintf(key, sizeof(key), "ramoops.%s=", name);
+	len = strlen(key);
+
+	while ((p = strstr(p, key))) {
+		if (p == saved_command_line || p[-1] == ' ') {
+			unsigned long long v = memparse(p + len, &end);
+
+			if (end == p + len)
+				return false;
+			*val = v;
+			return true;
+		}
+		p += len;
+	}
+	return false;
+}
+
+/* LK reserves the zones itself and appends them as mblock-N-<name>. */
+static bool __init mrcm_find_mblock(const char *name, u64 *paddr, u64 *size)
+{
+	struct device_node *rmem, *child;
+	bool found = false;
+
+	rmem = of_find_node_by_path("/reserved-memory");
+	if (!rmem)
+		return false;
+
+	for_each_child_of_node(rmem, child) {
+		const char *base = kbasename(child->full_name);
+
+		if (!strstr(base, name))
+			continue;
+		if (of_property_read_reg(child, 0, paddr, size))
+			continue;
+		found = *size != 0;
+		of_node_put(child);
+		break;
+	}
+
+	of_node_put(rmem);
+	return found;
+}
+
+static void __init mrcm_locate(void)
 {
 	struct device_node *np;
-	void __iomem *base;
-	u64 paddr, size;
-	u32 console_size = 0, pmsg_size = 0, ftrace_size = 0, i;
-	u64 dump_size;
+	unsigned long console_size = 0, pmsg_size = 0, ftrace_size = 0;
+	u64 paddr = 0, size = 0, dump_size;
 
 	np = of_find_compatible_node(NULL, NULL, "ramoops");
-	if (!np)
-		return;
+	if (np) {
+		u32 v;
 
-	if (of_property_read_reg(np, 0, &paddr, &size) || !size)
-		return;
+		of_property_read_reg(np, 0, &paddr, &size);
+		if (!of_property_read_u32(np, "console-size", &v))
+			console_size = v;
+		if (!of_property_read_u32(np, "pmsg-size", &v))
+			pmsg_size = v;
+		if (!of_property_read_u32(np, "ftrace-size", &v))
+			ftrace_size = v;
+		of_node_put(np);
+	}
 
-	of_property_read_u32(np, "console-size", &console_size);
-	of_property_read_u32(np, "pmsg-size", &pmsg_size);
-	of_property_read_u32(np, "ftrace-size", &ftrace_size);
+	/* This board passes the geometry on the command line (no DT node). */
+	if (!console_size)
+		mrcm_param("console_size", &console_size);
+	if (!pmsg_size)
+		mrcm_param("pmsg_size", &pmsg_size);
+	if (!ftrace_size)
+		mrcm_param("ftrace_size", &ftrace_size);
 
-	/* Same arithmetic as ramoops_init_prz(): console lives after dmesg. */
+	if (!paddr || !size) {
+		unsigned long a = 0, s = 0;
+
+		if (!mrcm_find_mblock("pstore", &paddr, &size) &&
+		    (!mrcm_param("mem_address", &a) ||
+		     !mrcm_param("mem_size", &s)))
+			return;
+		if (!paddr) {
+			paddr = a;
+			size = s;
+		}
+	}
+
+	/* Same arithmetic as ramoops_init_prz(): console lives after records. */
 	if (!console_size || size <= console_size)
 		return;
 	dump_size = size - console_size - pmsg_size - ftrace_size;
 	if (dump_size + console_size > size)
 		return;
 
-	base = of_iomap(np, 0);
-	if (!base)
+	mrcm_base = ioremap(paddr + dump_size, console_size);
+	if (!mrcm_base)
 		return;
+	mrcm_size = console_size;
+}
 
-	/*
-	 * Candidate offsets, in case this firmware orders the zones
-	 * differently from mainline: after dmesg (dump_size, mainline), at
-	 * +0x50000 (vendor 4.14 with two console zones) and at the very start.
-	 */
-	zones[nzones].base = (u8 __iomem *)base + dump_size;
-	zones[nzones].size = console_size;
-	nzones++;
-
-	if (size >= 0x90000) {
-		zones[nzones].base = (u8 __iomem *)base + 0x50000;
-		zones[nzones].size = console_size;
-		nzones++;
-	}
+/*
+ * Replay the printk ring buffer into the zone. register_console() with
+ * CON_PRINTBUFFER starts the new console at the oldest record still in the
+ * ring, and the next printk() flushes it; unregistering right away keeps us
+ * out of ramoops' way.
+ */
+static void __init mrcm_snapshot(const char *where)
+{
+	if (!mrcm_base)
+		return;
 
-	zones[nzones].base = (u8 __iomem *)base;
-	zones[nzones].size = console_size;
-	nzones++;
+	mrcm_start = 0;
+	mrcm_len = 0;
+	writel(PERSISTENT_RAM_SIG, mrcm_base);
+	mrcm_kick();
 
-	for (i = 0; i < nzones; i++) {
-		zones[i].start = 0;
-		zones[i].len = 0;
-		writel(PERSISTENT_RAM_SIG, zones[i].base);
-		mrcm_kick(&zones[i]);
-	}
+	register_console(&mrcm_console);
+	pr_info("snapshot at %s\n", where);
+	unregister_console(&mrcm_console);
 }
 
 /*
@@ -173,16 +251,24 @@ static void __init mrcm_stop_wdt(void)
 static int __init mrcm_init(void)
 {
 	mrcm_stop_wdt();
-	mrcm_locate_zone();
-	if (!nzones) {
-		pr_err("no ramoops console zone, disabled\n");
+	mrcm_locate();
+	if (!mrcm_base) {
+		pr_err("no ramoops console zone found, disabled (wdt stopped: %d)\n",
+		       mrcm_wdt_was_on);
 		return -ENODEV;
 	}
 
-	register_console(&mrcm_console);
-	pr_info("early RAM console, %u zone(s), %u bytes each (wdt stopped: %d)\n",
-		nzones, zones[0].size, mrcm_wdt_was_on);
-
+	pr_info("zone %u bytes, wdt stopped: %d\n", mrcm_size,
+		mrcm_wdt_was_on);
+	mrcm_snapshot("early_initcall");
 	return 0;
 }
 early_initcall(mrcm_init);
+
+/* Everything up to and including the ramoops console registration. */
+static int __init mrcm_snapshot_late(void)
+{
+	mrcm_snapshot("postcore_initcall_sync");
+	return 0;
+}
+postcore_initcall_sync(mrcm_snapshot_late);
