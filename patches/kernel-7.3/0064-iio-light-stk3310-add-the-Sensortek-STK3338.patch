From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonid <leonidy.1985@yandex.ru>
Date: Wed, 25 Nov 2026 12:38:49 +0300
Subject: [PATCH] iio: light: stk3310: add the Sensortek STK3338

Project series 0055: chip ID 0x5B and the sensortek,stk3338 compatible.
---
 drivers/iio/light/stk3310.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/iio/light/stk3310.c b/drivers/iio/light/stk3310.c
index 7c8a1d2b2..4d060d9cf 100644
--- a/drivers/iio/light/stk3310.c
+++ b/drivers/iio/light/stk3310.c
@@ -54,6 +54,7 @@
 #define STK3311S34_CHIP_ID_VAL			0x1E
 #define STK3311X_CHIP_ID_VAL			0x12
 #define STK3335_CHIP_ID_VAL			0x51
+#define STK3338_CHIP_ID_VAL			0x5B
 #define STK3310_PSINT_EN			0x01
 #define STK3310_PS_MAX_VAL			0xFFFF
 
@@ -102,6 +103,7 @@ static const u8 stk3310_chip_ids[] = {
 	STK3311X_CHIP_ID_VAL,
 	STK3311_CHIP_ID_VAL,
 	STK3335_CHIP_ID_VAL,
+	STK3338_CHIP_ID_VAL,
 };
 
 /* Estimate maximum proximity values with regard to measurement scale. */
@@ -788,6 +790,7 @@ static const struct of_device_id stk3310_of_match[] = {
 	{ .compatible = "sensortek,stk3310", },
 	{ .compatible = "sensortek,stk3311", },
 	{ .compatible = "sensortek,stk3335", },
+	{ .compatible = "sensortek,stk3338", },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, stk3310_of_match);
