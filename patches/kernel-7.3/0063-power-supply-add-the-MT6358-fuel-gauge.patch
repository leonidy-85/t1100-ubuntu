diff --git a/drivers/power/supply/mt6358-gauge.c b/drivers/power/supply/mt6358-gauge.c
new file mode 100644
index 000000000..f0fcc4c42
--- /dev/null
+++ b/drivers/power/supply/mt6358-gauge.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal MT6358 fuel-gauge port for the Fplus T1100 (MT6771/MT8788).
+ *
+ * The vendor driver (drivers/misc/mediatek/pmic/mt6358/v1/mt6358_gauge.c,
+ * Hadenix/android_kernel_alps-4.4) is a 90 KiB piece of the MTK battery
+ * framework: it talks to the PMIC through pmic_read/write_interface(), uses
+ * the vendor AUXADC API and exports a gauge_device for the userspace fuel
+ * gauge daemon.  None of that exists in mainline.
+ *
+ * This driver keeps only what is needed to report a stable state of charge:
+ *
+ *   - battery voltage from the PMIC BATADC channel, consumed through the
+ *     mainline MT6358 AUXADC/IIO driver
+ *     (drivers/iio/adc/mt6359-auxadc.c).  The BATADC is the BATSNS pin with
+ *     a 1/3 divider and a calibrated 15-bit ADC; it is much less sensitive to
+ *     the charger state than the MT6370 VBAT ADC used by mt6370-battery;
+ *   - instantaneous battery current from FGADC_CUR_CON0 (0x0d8a), decoded
+ *     with the same LSB/sign rules as the vendor driver.  The register is
+ *     reached through the parent PMIC regmap, the vendor pwrap calls are gone;
+ *   - the vendor battery0_profile_t2 table (100 points, room temperature)
+ *     maps open-circuit voltage to the discharged capacity and gives the
+ *     cell resistance for IR compensation.  The profile is passed from DT.
+ *
+ * OCV = VBAT - I * R(SOC), with I positive while charging.  The compensated
+ * OCV is converted to capacity by inverting the profile.  If the current
+ * cannot be read the driver falls back to the raw terminal voltage, and if
+ * the PMIC channel is unavailable mt6370-battery keeps using its OCV table.
+ *
+ * The regulator thresholds of t1100-power-guard (3.72/3.60 V) are untouched:
+ * the guard reads the MT6370 IIO channel directly, not this driver.
+ */
+
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/iio/consumer.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/types.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power/mt6358-gauge.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+
+#define MT6358_FGADC_CON1		0x0d0a
+#define MT6358_FG_CURRENT_OUT		0x0d8a
+
+/* FGADC_CON1 bits used by the vendor latch sequence. */
+#define MT6358_FG_SW_READ_PRE		BIT(0)
+#define MT6358_FG_SW_CLEAR		BIT(3)
+#define MT6358_FG_LATCHDATA_ST		BIT(15)
+
+#define MT6358_FG_POLL_US		1000
+#define MT6358_FG_TIMEOUT_US		20000
+
+/*
+ * Vendor conversion constants (mt6358_gauge.c):
+ *   UNIT_FGCURRENT = 381470, CAR_TO_REG... The intermediate value is scaled
+ *   by car_tune_value / 1000 and 100 / r_fg_value; both defaults come from
+ *   the stock DT (CAR_TUNE_VALUE = 100 -> 1000, R_FG_VALUE = 5 -> 50).
+ */
+#define MT6358_FG_CURRENT_LSB		381470
+#define MT6358_FG_CURRENT_DIV		100000
+#define MT6358_CAR_TUNE_DEFAULT		1000
+#define MT6358_R_FG_DEFAULT		50
+
+#define MT6358_GAUGE_CACHE_MS		2000
+
+struct mt6358_gauge_point {
+	u32 mah;		/* discharged capacity, 0.1 mAh */
+	u32 voltage;		/* OCV, 0.1 mV */
+	u32 resistance;		/* cell resistance, 0.1 mOhm */
+};
+
+struct mt6358_gauge {
+	struct device *dev;
+	struct regmap *regmap;
+	struct iio_channel *bat_adc;
+
+	struct mutex lock;	/* protects state and the cached update */
+	struct mt6358_gauge_state state;
+	unsigned long last_update;
+
+	u32 car_tune_value;
+	u32 r_fg_value;
+	bool no_current_compensation;
+
+	struct mt6358_gauge_point *profile;
+	unsigned int profile_len;
+	u32 qmax;		/* 0.1 mAh, last profile point */
+};
+
+static struct mt6358_gauge *gauge;
+
+static int mt6358_gauge_read_voltage(struct mt6358_gauge *g, int *mv)
+{
+	unsigned int realbits = g->bat_adc->channel->scan_type.realbits;
+	int raw, scale, scale2, ret;
+	s64 value;
+
+	ret = iio_read_channel_raw(g->bat_adc, &raw);
+	if (ret < 0)
+		return ret;
+
+	ret = iio_read_channel_scale(g->bat_adc, &scale, &scale2);
+	if (ret < 0)
+		return ret;
+
+	value = (s64)raw * scale;
+	if (ret == IIO_VAL_FRACTIONAL)
+		value = div_s64(value, scale2);
+	else if (ret != IIO_VAL_INT)
+		return -EINVAL;
+
+	/* The PMIC AUXADC reports the full-scale value in mV. */
+	*mv = div_s64(value, 1ULL << realbits);
+
+	return 0;
+}
+
+static int mt6358_gauge_read_current(struct mt6358_gauge *g, int *ma)
+{
+	unsigned int val;
+	s16 raw;
+	s64 cur;
+	int ret;
+
+	/*
+	 * FG_CURRENT_OUT is only refreshed by the vendor latch sequence
+	 * (SW_READ_PRE -> LATCHDATA_ST -> read -> SW_CLEAR).  A plain read
+	 * returns a stale zero on this PMIC; the sequence itself is safe and
+	 * was verified on the tablet with a debugfs test before being used
+	 * here.
+	 */
+	ret = regmap_write(g->regmap, MT6358_FGADC_CON1,
+			   MT6358_FG_SW_READ_PRE);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(g->regmap, MT6358_FGADC_CON1, val,
+				       val & MT6358_FG_LATCHDATA_ST,
+				       MT6358_FG_POLL_US,
+				       MT6358_FG_TIMEOUT_US);
+	if (ret)
+		goto out_clear;
+
+	ret = regmap_read(g->regmap, MT6358_FG_CURRENT_OUT, &val);
+	if (ret)
+		goto out_clear;
+
+	raw = (s16)val;
+	cur = (s64)raw * MT6358_FG_CURRENT_LSB;
+	cur = div_s64(cur, MT6358_FG_CURRENT_DIV);
+	cur = cur * 100 / g->r_fg_value;
+	cur = cur * g->car_tune_value / 1000;
+	/*
+	 * The vendor intermediate value is in 0.1 mA (UNIT_FGCURRENT is the
+	 * shunt LSB, not a full mA); the tablet's load-step test gave about
+	 * 0.76 mA per LSB, which matches this division.
+	 */
+	cur = div_s64(cur, 10);
+
+	/* A bogus sample must not move the state of charge by amps. */
+	if (cur < -10000 || cur > 10000) {
+		ret = -ERANGE;
+		goto out_clear;
+	}
+
+	*ma = cur;
+
+out_clear:
+	regmap_write(g->regmap, MT6358_FGADC_CON1, MT6358_FG_SW_CLEAR);
+	regmap_read_poll_timeout(g->regmap, MT6358_FGADC_CON1, val,
+				 !(val & MT6358_FG_LATCHDATA_ST),
+				 MT6358_FG_POLL_US, MT6358_FG_TIMEOUT_US);
+	regmap_write(g->regmap, MT6358_FGADC_CON1, 0);
+
+	return ret;
+}
+
+/*
+ * Find the profile segment for a given OCV (0.1 mV) and return the
+ * discharged capacity and resistance at that point.  OCV decreases with
+ * increasing mah, so the segment is searched from the low-voltage end.
+ */
+static void mt6358_gauge_profile_lookup(struct mt6358_gauge *g, int ocv,
+					u32 *mah, u32 *resistance)
+{
+	const struct mt6358_gauge_point *p = g->profile;
+	unsigned int i;
+
+	if (ocv >= p[0].voltage) {
+		*mah = p[0].mah;
+		*resistance = p[0].resistance;
+		return;
+	}
+
+	for (i = 1; i < g->profile_len; i++) {
+		if (ocv >= p[i].voltage) {
+			u32 dv = p[i - 1].voltage - p[i].voltage;
+			u32 dm = p[i].mah - p[i - 1].mah;
+
+			if (!dv) {
+				*mah = p[i].mah;
+			} else {
+				*mah = p[i].mah -
+				       (u32)((s64)(ocv - p[i].voltage) * dm / dv);
+			}
+			*resistance = p[i].resistance;
+			return;
+		}
+	}
+
+	*mah = p[g->profile_len - 1].mah;
+	*resistance = p[g->profile_len - 1].resistance;
+}
+
+static int mt6358_gauge_capacity(struct mt6358_gauge *g, int ocv_mv,
+				 int *capacity)
+{
+	u32 mah, resistance, soc;
+
+	/* The profile stores voltages in 0.1 mV, the driver works in mV. */
+	mt6358_gauge_profile_lookup(g, ocv_mv * 10, &mah, &resistance);
+	if (!g->qmax)
+		return -EINVAL;
+
+	mah = min(mah, g->qmax);
+	soc = 100 - DIV_ROUND_CLOSEST(mah * 100, g->qmax);
+	*capacity = clamp_t(int, soc, 0, 100);
+
+	return 0;
+}
+
+static int mt6358_gauge_update(struct mt6358_gauge *g)
+{
+	struct mt6358_gauge_state *st = &g->state;
+	u32 mah, resistance;
+	int vbat, cur_ma = 0, ocv, capacity;
+	int ret;
+
+	lockdep_assert_held(&g->lock);
+
+	if (st->valid && time_before(jiffies, g->last_update +
+				     msecs_to_jiffies(MT6358_GAUGE_CACHE_MS)))
+		return 0;
+
+	g->last_update = jiffies;
+
+	ret = mt6358_gauge_read_voltage(g, &vbat);
+	if (ret) {
+		st->valid = false;
+		return ret;
+	}
+
+	/* A missing current sample must not disable the voltage/capacity. */
+	if (!g->no_current_compensation &&
+	    mt6358_gauge_read_current(g, &cur_ma))
+		cur_ma = 0;
+
+	/* Two iterations are enough to settle R(SOC) on the profile curve. */
+	ocv = vbat;
+	capacity = 0;
+	mt6358_gauge_capacity(g, ocv, &capacity);
+	mt6358_gauge_profile_lookup(g, ocv * 10, &mah, &resistance);
+	ocv = vbat - div_s64((s64)cur_ma * (resistance / 10), 1000);
+	mt6358_gauge_capacity(g, ocv, &capacity);
+	mt6358_gauge_profile_lookup(g, ocv * 10, &mah, &resistance);
+	ocv = vbat - div_s64((s64)cur_ma * (resistance / 10), 1000);
+	mt6358_gauge_capacity(g, ocv, &capacity);
+
+	st->voltage_mv = vbat;
+	st->current_ma = cur_ma;
+	st->ocv_mv = ocv;
+	st->capacity = capacity;
+	st->valid = true;
+
+	return 0;
+}
+
+/**
+ * mt6358_gauge_get_state() - read the latest gauge sample.
+ * @state: destination, filled only on success.
+ *
+ * Returns 0 and a valid snapshot, -ENODEV before the gauge probed, or a
+ * negative error if the PMIC sample could not be read.
+ */
+int mt6358_gauge_get_state(struct mt6358_gauge_state *state)
+{
+	struct mt6358_gauge *g = READ_ONCE(gauge);
+	int ret;
+
+	if (!g)
+		return -ENODEV;
+
+	mutex_lock(&g->lock);
+	ret = mt6358_gauge_update(g);
+	if (!ret && g->state.valid)
+		*state = g->state;
+	else
+		ret = ret ?: -EAGAIN;
+	mutex_unlock(&g->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6358_gauge_get_state);
+
+static int mt6358_gauge_parse_profile(struct mt6358_gauge *g)
+{
+	struct device_node *np = g->dev->of_node;
+	struct mt6358_gauge_point *profile;
+	int count, ret, i;
+
+	count = of_property_count_elems_of_size(np, "mediatek,battery-profile-t2",
+						sizeof(u32));
+	if (count < 0)
+		return dev_err_probe(g->dev, count,
+				     "missing mediatek,battery-profile-t2\n");
+	if (count < 6 || count % 3)
+		return dev_err_probe(g->dev, -EINVAL,
+				     "battery profile must be a multiple of 3\n");
+
+	profile = devm_kcalloc(g->dev, count / 3, sizeof(*profile),
+			       GFP_KERNEL);
+	if (!profile)
+		return -ENOMEM;
+
+	ret = of_property_read_u32_array(np, "mediatek,battery-profile-t2",
+					 (u32 *)profile, count);
+	if (ret)
+		return dev_err_probe(g->dev, ret, "cannot read battery profile\n");
+
+	/* The DTS stores triplets; the array of structs is layout-compatible. */
+	g->profile = profile;
+	g->profile_len = count / 3;
+	g->qmax = profile[g->profile_len - 1].mah;
+	if (!g->qmax)
+		return dev_err_probe(g->dev, -EINVAL, "battery profile is empty\n");
+
+	for (i = 1; i < g->profile_len; i++) {
+		if (profile[i].mah < profile[i - 1].mah ||
+		    profile[i].voltage > profile[i - 1].voltage)
+			return dev_err_probe(g->dev, -EINVAL,
+					     "battery profile is not monotonic\n");
+	}
+
+	dev_info(g->dev, "battery profile: %u points, qmax %u (0.1 mAh)\n",
+		 g->profile_len, g->qmax);
+
+	return 0;
+}
+
+static int mt6358_gauge_probe(struct platform_device *pdev)
+{
+	struct mt6358_gauge *g;
+	int ret, mv, ma, capacity;
+	u32 val;
+
+	g = devm_kzalloc(&pdev->dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+
+	g->dev = &pdev->dev;
+	mutex_init(&g->lock);
+
+	/*
+	 * The MFD cell is a child of the MT6358 PMIC device; the regmap lives
+	 * on its parent (pwrap).  Try both, so the driver also works if the
+	 * PMIC device ever gets a regmap of its own.
+	 */
+	g->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!g->regmap && pdev->dev.parent->parent)
+		g->regmap = dev_get_regmap(pdev->dev.parent->parent, NULL);
+	if (!g->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "no parent PMIC regmap\n");
+
+	g->bat_adc = devm_iio_channel_get(&pdev->dev, "bat_adc");
+	if (IS_ERR(g->bat_adc))
+		return dev_err_probe(&pdev->dev, PTR_ERR(g->bat_adc),
+				     "no BATADC IIO channel\n");
+
+	ret = mt6358_gauge_parse_profile(g);
+	if (ret)
+		return ret;
+
+	g->car_tune_value = MT6358_CAR_TUNE_DEFAULT;
+	g->r_fg_value = MT6358_R_FG_DEFAULT;
+	/*
+	 * The stock DT stores CAR_TUNE_VALUE=100 and R_FG_VALUE=5; the vendor
+	 * driver scales both by 10 (car_tune 1000, r_fg 50).  Keep the DT
+	 * values compatible with the stock battery node.
+	 */
+	if (!of_property_read_u32(pdev->dev.of_node, "mediatek,car-tune-value",
+				  &val) && val)
+		g->car_tune_value = val * 10;
+	if (!of_property_read_u32(pdev->dev.of_node, "mediatek,r-fg-value",
+				  &val) && val)
+		g->r_fg_value = val * 10;
+	g->no_current_compensation =
+		of_property_read_bool(pdev->dev.of_node,
+				       "mediatek,no-current-compensation");
+
+	platform_set_drvdata(pdev, g);
+
+	mutex_lock(&g->lock);
+	g->last_update = 0;
+	ret = mt6358_gauge_update(g);
+	mutex_unlock(&g->lock);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "cannot read the gauge\n");
+
+	WRITE_ONCE(gauge, g);
+
+	mv = g->state.voltage_mv;
+	ma = g->state.current_ma;
+	capacity = g->state.capacity;
+	dev_info(&pdev->dev,
+		 "vbat %d mV, current %d mA, ocv %d mV, capacity %d%%\n",
+		 mv, ma, g->state.ocv_mv, capacity);
+
+	return 0;
+}
+
+static void mt6358_gauge_remove(struct platform_device *pdev)
+{
+	WRITE_ONCE(gauge, NULL);
+}
+
+static const struct of_device_id mt6358_gauge_of_match[] = {
+	{ .compatible = "mediatek,mt6358-gauge" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6358_gauge_of_match);
+
+static struct platform_driver mt6358_gauge_driver = {
+	.probe = mt6358_gauge_probe,
+	.remove = mt6358_gauge_remove,
+	.driver = {
+		.name = "mt6358-gauge",
+		.of_match_table = mt6358_gauge_of_match,
+	},
+};
+module_platform_driver(mt6358_gauge_driver);
+
+MODULE_DESCRIPTION("Minimal MT6358 fuel gauge (MT6771/MT8788)");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/power/mt6358-gauge.h b/include/linux/power/mt6358-gauge.h
new file mode 100644
index 000000000..0bae97367
--- /dev/null
+++ b/include/linux/power/mt6358-gauge.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_POWER_MT6358_GAUGE_H
+#define _LINUX_POWER_MT6358_GAUGE_H
+
+#include <linux/types.h>
+
+/**
+ * struct mt6358_gauge_state - snapshot of the MT6358 fuel gauge.
+ * @voltage_mv: terminal battery voltage (BATSNS), mV
+ * @ocv_mv:     IR-compensated open-circuit voltage, mV
+ * @current_ma: battery current, positive while charging, mA
+ * @capacity:   state of charge, 0..100 %
+ * @valid:      the sample was read successfully
+ */
+struct mt6358_gauge_state {
+	int voltage_mv;
+	int ocv_mv;
+	int current_ma;
+	int capacity;
+	bool valid;
+};
+
+#if IS_REACHABLE(CONFIG_MT6358_GAUGE)
+int mt6358_gauge_get_state(struct mt6358_gauge_state *state);
+#else
+static inline int mt6358_gauge_get_state(struct mt6358_gauge_state *state)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif /* _LINUX_POWER_MT6358_GAUGE_H */
