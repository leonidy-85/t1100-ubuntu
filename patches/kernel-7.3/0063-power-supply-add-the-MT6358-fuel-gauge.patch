 drivers/power/supply/Kconfig        |  14 +
 drivers/power/supply/Makefile       |   1 +
 drivers/power/supply/mt6358-gauge.c | 452 ++++++++++++++++++++++++++++
 include/linux/power/mt6358-gauge.h  |  32 ++
 5 files changed, 502 insertions(+)
 create mode 100644 drivers/power/supply/mt6358-gauge.c
 create mode 100644 include/linux/power/mt6358-gauge.h

