From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leonid <leonidy.1985@yandex.ru>
Date: Wed, 25 Nov 2026 12:38:49 +0300
Subject: [PATCH] soc: mediatek: regulator coupler: also cover MT6771 and
 MT8788

Project series 0058.
---
 drivers/soc/mediatek/mtk-regulator-coupler.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/mediatek/mtk-regulator-coupler.c b/drivers/soc/mediatek/mtk-regulator-coupler.c
index 0b6a28841..5aa5cb755 100644
--- a/drivers/soc/mediatek/mtk-regulator-coupler.c
+++ b/drivers/soc/mediatek/mtk-regulator-coupler.c
@@ -148,7 +148,9 @@ static int mediatek_regulator_coupler_init(void)
 	if (!of_machine_is_compatible("mediatek,mt8183") &&
 	    !of_machine_is_compatible("mediatek,mt8186") &&
 	    !of_machine_is_compatible("mediatek,mt8188") &&
-	    !of_machine_is_compatible("mediatek,mt8192"))
+	    !of_machine_is_compatible("mediatek,mt8192") &&
+	    !of_machine_is_compatible("mediatek,mt6771") &&
+	    !of_machine_is_compatible("mediatek,mt8788"))
 		return 0;
 
 	return regulator_coupler_register(&mediatek_coupler.coupler);
