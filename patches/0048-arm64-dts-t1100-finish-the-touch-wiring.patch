From 675178729acc47891503ea6369fd27ac80bb66f8 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Wed, 11 Nov 2026 19:42:49 +0300
Subject: [PATCH] arm64: dts: t1100: finish the touch wiring

 - touch_avdd is regulator-always-on: the GPIO163 load switch belongs to
   the regulator device, so without it any unbind of the touch driver cuts
   the digitizer's analog rail and every register read turns into 0x00;
 - EINT1 (GPIO1) gets its pull-up: mainline left the pad floating and a
   0.5 Hz stream of spurious edges appeared on the interrupt line;
 - touchscreen-inverted-x: measured on the panel, the controller reports
   1600 - x (a tap at x~133 came back as 1467, one at ~1552 as 48).
---
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index e63a1db67..f6770dda4 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -171,6 +171,13 @@ touch_avdd: regulator-touch-avdd {
 		gpio = <&pio 163 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		regulator-enable-ramp-delay = <5000>;
+		/*
+		 * Keep the switch closed for the whole boot: the line is owned
+		 * by this regulator device, so without always-on any unbind of
+		 * the touch driver (debugging, rebind) cuts the digitizer's
+		 * analog rail and every register read turns into 0x00.
+		 */
+		regulator-always-on;
 	};
 
 	/*
@@ -218,6 +225,21 @@ &uart0 {
  * MT6358 VLDO28. Mainline 6.12 only knows himax,hx83112b/hx83100a, so the
  * node does not bind yet; see refs/mt6771-next/patches/0f649f913f.
  */
+/*
+ * EINT1 (GPIO1) is the touch interrupt: the stock pinctrl registers it with a
+ * bias, mainline leaves the pad floating ("input bias disabled"), which is
+ * how a 0.5 Hz stream of spurious edges gets onto a line that the controller
+ * drives as a pulse.
+ */
+&pio {
+	touch_irq_pins: touch-irq-pins {
+		pins-eint {
+			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
+			bias-pull-up;
+		};
+	};
+};
+
 &i2c0 {
 	vbus-supply = <&i2c_vbus>;
 	status = "okay";
@@ -228,10 +250,14 @@ touchscreen@48 {
 
 		/* vendor: HX_INT_IS_EDGE = 1, IRQF_TRIGGER_FALLING */
 		interrupts-extended = <&pio 1 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq_pins>;
 		reset-gpios = <&pio 158 GPIO_ACTIVE_LOW>;
 
 		touchscreen-size-x = <1600>;
 		touchscreen-size-y = <2176>;
+		/* measured: the controller reports 1600 - x */
+		touchscreen-inverted-x;
 
 		/* VLDO28 -> GPIO163 load switch; the driver enables "vdd". */
 		vdd-supply = <&touch_avdd>;
-- 
2.53.0

