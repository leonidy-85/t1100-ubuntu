@@ -90,3 +90,6 @@ himax_touch@48 {
 		status = "disabled";
 	};
 };
+
+/* LK compatibility layer: must be included last (docs/lk-dtb-rules.md) */
+#include "mt6771-fplus-t1100-lk-compat.dtsi"
diff --git a/arch/arm64/boot/dts/mediatek/mt6771.dtsi b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
index d77c6fa77..f72965e6e 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
@@ -197,107 +197,23 @@ memory@40000000 {
 	};
 
 	/*
-	 * Reservation list as passed by LK/ATF in the live FDT, addresses are
-	 * fixed physical addresses (see refs/device/fdt-live.dts.gz and
-	 * refs/device/iomem.txt). Regions are kept reserved so that the
-	 * kernel never writes into ATF/SCP/SSPM, modem, VPU or the
-	 * bootloader framebuffer areas.
+	 * The node must exist (LK appends its own mblock-* children into it and
+	 * asserts if it is missing), but it must NOT contain static children:
+	 * their `reg` would overlap LK's reservations and LK spins forever in
+	 * reserved_memory_conflict_check.
 	 */
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
 		ranges;
-
-		ram_console@54400000 {
-			reg = <0 0x54400000 0 0x10000>;
-			no-map;
-		};
-
-		ramoops@54410000 {
-			compatible = "ramoops";
-			reg = <0 0x54410000 0 0xe0000>;
-			no-map;
-			record-size = <0x10000>;
-			console-size = <0x40000>;
-			pmsg-size = <0x10000>;
-		};
-
-		minirdump@544f0000 {
-			reg = <0 0x544f0000 0 0x10000>;
-			no-map;
-		};
-
-		atf-reserved@54600000 {
-			reg = <0 0x54600000 0 0x50000>;
-			no-map;
-		};
-
-		spm-reserved@77ff0000 {
-			reg = <0 0x77ff0000 0 0x10000>;
-			no-map;
-		};
-
-		/*
-		 * Keep the bootloader framebuffer out of the buddy allocator, but
-		 * do NOT mark it no-map: simpledrm has to ioremap it for fbcon.
-		 */
-		framebuffer@7cd80000 {
-			reg = <0 0x7cd80000 0 0x2e80000>;
-		};
-
-		items-reserved@7fc00000 {
-			reg = <0 0x7fc00000 0 0x200000>;
-			no-map;
-		};
-
-		sspm-reserved@7ff00000 {
-			reg = <0 0x7ff00000 0 0xc0000>;
-			no-map;
-		};
-
-		log-store@7ffc0000 {
-			reg = <0 0x7ffc0000 0 0x40000>;
-		};
-
-		ap-md-c-smem@86000000 {
-			reg = <0 0x86000000 0 0x1600000>;
-		};
-
-		ap-md-nc-smem@88000000 {
-			reg = <0 0x88000000 0 0x100000>;
-		};
-
-		md-mem-usage@8c000000 {
-			reg = <0 0x8c000000 0 0x10000000>;
-		};
-
-		scp-reserved@9cf00000 {
-			reg = <0 0x9cf00000 0 0x600000>;
-			no-map;
-		};
-
-		ccci-tag-mem@9d5e0000 {
-			reg = <0 0x9d5e0000 0 0x10000>;
-		};
-
-		vpu-binary@9d5f0000 {
-			reg = <0 0x9d5f0000 0 0x2a10000>;
-			no-map;
-		};
-
-		atf-log-reserved@bfe00000 {
-			reg = <0 0xbfe00000 0 0x40000>;
-			no-map;
-		};
-
-		dramc-rk0@bffff000 {
-			reg = <0 0xbffff000 0 0x1000>;
-			no-map;
-		};
-
-		dramc-rk1@13ffff000 {
-			reg = <1 0x3ffff000 0 0x1000>;
-			no-map;
-		};
 	};
+
+	/*
+	 * No static reserved-memory on purpose: MTK LK reserves the vendor regions
+	 * itself (ATF, TEE, SCP, SPM, SSPM, modem, VPU, framebuffer, ram_console,
+	 * ramoops) and appends them as mblock-N-* nodes. A static child whose `reg`
+	 * overlaps any of them makes LK spin in reserved_memory_conflict_check and
+	 * the board resets before the kernel is ever entered (see docs/lk-dtb-rules.md).
+	 * ramoops comes from the cmdline: ramoops.mem_address=0x54410000 ...
+	 */
 };
