+		irtx_pwm = "/mtk-lk-sink/irtx-pwm";
+		kd_camera_hw1 = "/mtk-lk-sink/kd-camera-hw1";
+		mt6370_pmu = "/mtk-lk-sink/mt6370-pmu";
+		mt6370_typec = "/mtk-lk-sink/mt6370-typec";
+		otg_iddig = "/mtk-lk-sink/otg-iddig";
+		reserved_memory = "/mtk-lk-sink/reserved-memory";
+		scp = "/mtk-lk-sink/scp";
+		touch = "/mtk-lk-sink/touch";
+		msdc1 = "/mtk-lk-sink/msdc1";
+		spi0 = "/mtk-lk-sink/spi0";
+		auxadc = "/mtk-lk-sink/auxadc";
+		md_auxadc = "/mtk-lk-sink/md-auxadc";
+		pmic_clock_buffer_ctrl = "/mtk-lk-sink/pmic-clock-buffer-ctrl";
+		i2c2 = "/mtk-lk-sink/i2c2";
+		i2c5 = "/mtk-lk-sink/i2c5";
+		i2c7 = "/mtk-lk-sink/i2c7";
+		i2c8 = "/mtk-lk-sink/i2c8";
+		i2c9 = "/mtk-lk-sink/i2c9";
+		i2c10 = "/mtk-lk-sink/i2c10";
+		i2c11 = "/mtk-lk-sink/i2c11";
+		gpio_usage_mapping = "/mtk-lk-sink/gpio-usage-mapping";
+		gpio = "/gpio@10005000";
+		msdc1_ins = "/mtk-lk-sink/msdc1-ins";
+		rt9465_slave_chr = "/mtk-lk-sink/rt9465-slave-chr";
+		subpmic_pmu_eint = "/mtk-lk-sink/subpmic-pmu-eint";
+		tcpc_pd = "/mtk-lk-sink/tcpc-pd";
+		dsi_te = "/mtk-lk-sink/dsi-te";
+		main_pmic = "/mtk-lk-sink/main-pmic";
+		md1_sim1_hot_plug_eint = "/mtk-lk-sink/md1-sim1-hot-plug-eint";
+		mt_pmic_vcama1_ldo_reg = "/mtk-lk-sink/mt-pmic-vcama1-ldo-reg";
+		mt_pmic_vcama2_ldo_reg = "/mtk-lk-sink/mt-pmic-vcama2-ldo-reg";
