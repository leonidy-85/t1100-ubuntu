From 547600fded45fb37ab8c4c029a065e979b50c888 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Thu, 29 Oct 2026 21:31:54 +0300
Subject: [PATCH t1100 6/6] arm64: dts: mt6771: satisfy MTK LK's device-tree
 requirements

The board reset-looped before the kernel ever ran: LK asserts/hangs while
preparing the DT.  Fixes, per the reverse-engineered rules in
docs/lk-dtb-rules.md (same SoC, planet-community/pennyos):

  - add a generated LK compatibility layer that resolves every vendor dtbo
    __fixups__ label via /__symbols__, provides /gpio@10005000, /odm and a
    'mediatek,scp' node (status disabled);
  - keep /reserved-memory but drop all static children: LK reserves the
    vendor regions itself and a static overlap makes it spin forever.

Verified offline with the vendor dtbo: fdtoverlay applies, merged tree has
mediatek,scp, no reserved-memory overlap.  On hardware the board now stays
up instead of reset-looping.
---
 .../mt6771-fplus-t1100-lk-compat.dtsi         | 216 ++++++++++++++++++
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  |   3 +
 arch/arm64/boot/dts/mediatek/mt6771.dtsi      | 110 ++-------
 3 files changed, 232 insertions(+), 97 deletions(-)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100-lk-compat.dtsi

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100-lk-compat.dtsi b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100-lk-compat.dtsi
new file mode 100644
index 000000000..b2d4ac944
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100-lk-compat.dtsi
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * GENERATED by tools/gen-lk-compat-dtsi.py - do not edit by hand.
+ *
+ * MediaTek LK (Fplus T1100) compatibility layer, generated from dtbo_a.
+ * Include this LAST from the board .dts. What LK demands of the appended DTB
+ * (each one is an ASSERT or while(1) in LK when violated):
+ *
+ *  1. The vendor `dtbo` overlay must apply: /__symbols__ must resolve every
+ *     label in the overlay's __fixups__, and each target needs a phandle.
+ *  2. /chosen/bootargs must exist.
+ *  3. A node with compatible "mediatek,scp" must exist.
+ *  4. /reserved-memory must exist, and no child with a static `reg` may
+ *     overlap a region LK reserved itself (ATF, TEE, SSPM, SPM, SCP, modem,
+ *     framebuffer...). LK appends those as mblock-N-* nodes on its own.
+ *  5. /memory and /chosen must exist (LK rewrites reg/bootargs/initrd).
+ */
+
+/ {
+
+	lk_chosen: chosen { };
+
+	/* LK reads LED/backlight config from /odm/led@N (vendor overlay fills it) */
+	lk_odm: odm { };
+
+	/* LK applies gpio_init_default from here (vendor overlay fills it) */
+	lk_gpio: gpio@10005000 {
+		reg = <0 0x10005000 0 0x1000>;
+	};
+
+	/* No compatible: the kernel never creates devices at or below this node. */
+	mtk-lk-sink {
+		/* forces dtc to emit a phandle for every overlay target */
+		lk-phandle-anchors = <&lk_odm
+			&lk_pio
+			&lk_accdet
+			&lk_apuart0
+			&lk_audgpio
+			&lk_lk_charger
+			&lk_charger
+			&lk_chosen
+			&lk_consys
+			&lk_i2c0
+			&lk_i2c1
+			&lk_i2c3
+			&lk_i2c4
+			&lk_i2c6
+			&lk_irtx_pwm
+			&lk_kd_camera_hw1
+			&lk_mt6370_pmu
+			&lk_mt6370_typec
+			&lk_otg_iddig
+			&lk_reserved_memory
+			&lk_scp
+			&lk_touch
+			&lk_msdc1
+			&lk_spi0
+			&lk_auxadc
+			&lk_md_auxadc
+			&lk_pmic_clock_buffer_ctrl
+			&lk_i2c2
+			&lk_i2c5
+			&lk_i2c7
+			&lk_i2c8
+			&lk_i2c9
+			&lk_i2c10
+			&lk_i2c11
+			&lk_gpio_usage_mapping
+			&lk_gpio
+			&lk_msdc1_ins
+			&lk_rt9465_slave_chr
+			&lk_subpmic_pmu_eint
+			&lk_tcpc_pd
+			&lk_dsi_te
+			&lk_main_pmic
+			&lk_md1_sim1_hot_plug_eint
+			&lk_mt_pmic_vcama1_ldo_reg
+			&lk_mt_pmic_vcama2_ldo_reg
+			&lk_mt_pmic_vsim1_ldo_reg
+			&lk_mt_pmic_vsim2_ldo_reg
+			&lk_mt_pmic_vcamd_ldo_reg
+			&lk_mt_pmic_vcamio_ldo_reg
+			&lk_mt_pmic_vldo28_ldo_reg
+			&lk_keypad>;
+
+		lk_pio: pio {};
+		lk_accdet: accdet {};
+		lk_apuart0: apuart0 {};
+		lk_audgpio: audgpio {};
+		lk_lk_charger: lk-charger {};
+		lk_charger: charger {};
+		lk_consys: consys {};
+		lk_i2c0: i2c0 {
+			id = <0>;
+		};
+		lk_i2c1: i2c1 {
+			id = <1>;
+		};
+		lk_i2c3: i2c3 {
+			id = <3>;
+		};
+		lk_i2c4: i2c4 {
+			id = <4>;
+		};
+		lk_i2c6: i2c6 {
+			id = <6>;
+		};
+		lk_irtx_pwm: irtx-pwm {};
+		lk_kd_camera_hw1: kd-camera-hw1 {};
+		lk_mt6370_pmu: mt6370-pmu {};
+		lk_mt6370_typec: mt6370-typec {};
+		lk_otg_iddig: otg-iddig {};
+		lk_reserved_memory: reserved-memory {};
+		lk_scp: scp {
+			compatible = "mediatek,scp";
+			status = "disabled";
+		};
+		lk_touch: touch {};
+		lk_msdc1: msdc1 {};
+		lk_spi0: spi0 {};
+		lk_auxadc: auxadc {};
+		lk_md_auxadc: md-auxadc {};
+		lk_pmic_clock_buffer_ctrl: pmic-clock-buffer-ctrl {};
+		lk_i2c2: i2c2 {
+			id = <2>;
+		};
+		lk_i2c5: i2c5 {
+			id = <5>;
+		};
+		lk_i2c7: i2c7 {
+			id = <7>;
+		};
+		lk_i2c8: i2c8 {
+			id = <8>;
+		};
+		lk_i2c9: i2c9 {
+			id = <9>;
+		};
+		lk_i2c10: i2c10 {
+			id = <10>;
+		};
+		lk_i2c11: i2c11 {
+			id = <11>;
+		};
+		lk_gpio_usage_mapping: gpio-usage-mapping {};
+		lk_msdc1_ins: msdc1-ins {};
+		lk_rt9465_slave_chr: rt9465-slave-chr {};
+		lk_subpmic_pmu_eint: subpmic-pmu-eint {};
+		lk_tcpc_pd: tcpc-pd {};
+		lk_dsi_te: dsi-te {};
+		lk_main_pmic: main-pmic {};
+		lk_md1_sim1_hot_plug_eint: md1-sim1-hot-plug-eint {};
+		lk_mt_pmic_vcama1_ldo_reg: mt-pmic-vcama1-ldo-reg {};
+		lk_mt_pmic_vcama2_ldo_reg: mt-pmic-vcama2-ldo-reg {};
+		lk_mt_pmic_vsim1_ldo_reg: mt-pmic-vsim1-ldo-reg {};
+		lk_mt_pmic_vsim2_ldo_reg: mt-pmic-vsim2-ldo-reg {};
+		lk_mt_pmic_vcamd_ldo_reg: mt-pmic-vcamd-ldo-reg {};
+		lk_mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg {};
+		lk_mt_pmic_vldo28_ldo_reg: mt-pmic-vldo28-ldo-reg {};
+		lk_keypad: keypad {};
+	};
+
+	__symbols__ {
+		odm = "/odm";
+		pio = "/mtk-lk-sink/pio";
+		accdet = "/mtk-lk-sink/accdet";
+		apuart0 = "/mtk-lk-sink/apuart0";
+		audgpio = "/mtk-lk-sink/audgpio";
+		lk_charger = "/mtk-lk-sink/lk-charger";
+		charger = "/mtk-lk-sink/charger";
+		chosen = "/chosen";
+		consys = "/mtk-lk-sink/consys";
