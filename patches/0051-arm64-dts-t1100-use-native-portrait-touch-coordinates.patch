From 68a1888e4b09a0d700ba1e91de1aa59478ba5bb9 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Thu, 12 Nov 2026 05:35:46 +0300
Subject: [PATCH] arm64: dts: t1100: use native portrait touch coordinates

The controller reports coordinates in the panel's native portrait
orientation (1600x2176).  KWin applies the 90-degree output transform
itself, so inverting or swapping the axes in the kernel rotates the touch
input twice: the pointer lands in the wrong corner even though the raw
evdev coordinates look right.

Remove touchscreen-inverted-x (added by 0048) and
touchscreen-swapped-x-y (added by 0050); keep the native coordinates and
let KWin do the rotation.  Tested on boot_touch6: touches in the four
corners of the visible area land in the matching corners.
---
 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index d7253a2..bd0a015 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -246,10 +246,10 @@
 		reset-gpios = <&pio 158 GPIO_ACTIVE_LOW>;
 		touchscreen-size-x = <1600>;
 		touchscreen-size-y = <2176>;
-		/* measured: the controller reports 1600 - x */
-		touchscreen-inverted-x;
-		/* panel used in landscape: swap the touch axes after the X inversion */
-		touchscreen-swapped-x-y;
+		/*
+		 * The controller reports native portrait coordinates; KWin applies
+		 * the 90-degree output transform itself.
+		 */
 
 		/* VLDO28 -> GPIO163 load switch; the driver enables "vdd". */
 		vdd-supply = <&touch_avdd>;
-- 
2.53.0

