+static void vcodec_dump_vdec_state(const char *tag)
+{
+	/*
+	 * Do not touch the VLD block here.  Reading VLD registers while the
+	 * decoder is idle/stuck hangs the SMI bus on this board (verified
+	 * twice from userspace and once from this timeout path).
+	 */
+	pr_info("[VCODEC][DUMP] %s GCON=%08x MISC28=%08x MISCa4=%08x MISC14=%08x\n",
+		tag,
+		VDO_HW_READ(KVA_VDEC_GCON_BASE),
+		VDO_HW_READ(KVA_VDEC_MISC_BASE + 0x28),
+		VDO_HW_READ(KVA_VDEC_MISC_BASE + 0xa4),
+		VDO_HW_READ(KVA_VDEC_MISC_BASE + 0x14));
+}
+
