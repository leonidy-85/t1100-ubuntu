 	VDO_HW_WRITE(KVA_VDEC_MISC_BASE+41*4,
-		VDO_HW_READ(KVA_VDEC_MISC_BASE + 41*4) | 0x11);
+		VDO_HW_READ(KVA_VDEC_MISC_BASE + 41*4) | 0x10011);
 	VDO_HW_WRITE(KVA_VDEC_MISC_BASE+41*4,
 		VDO_HW_READ(KVA_VDEC_MISC_BASE + 41*4) & ~0x10);
 
@@ -1208,6 +1223,24 @@
 }
 
 
+static int vcodec_poll_dec_done(unsigned int timeout_ms)
+{
+	unsigned int i;
+	unsigned int s;
+
+	for (i = 0; i < timeout_ms && i < 1000; i++) {
+		s = VDO_HW_READ(KVA_VDEC_MISC_BASE + 0xa4);
+		if (s & 0x10000) {
+			pr_info("[VCODEC] poll dec done after %u ms MISCa4=%08x\n",
+				i, s);
+			dec_isr();
+			return 1;
+		}
+		usleep_range(1000, 2000);
+	}
+	return 0;
+}
