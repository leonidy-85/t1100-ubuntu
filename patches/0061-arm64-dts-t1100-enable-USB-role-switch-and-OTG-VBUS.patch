From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Андрей Маркин <py6on@yandex.ru>
Date: Fri, 13 Nov 2026 02:30:00 +0300
Subject: [PATCH] arm64: dts: t1100: enable USB role switch and OTG VBUS

The MT6370 provides the 5 V OTG boost, and mtu3 can switch between
peripheral and host once the T-PHY follows the USB role.  Describe the
PHY <-> controller graph link, keep peripheral as the default role so
RNDIS stays available, and wire the MT6370 OTG regulator as vbus-supply.

Local provenance: tested on FPlus T1100 with the adomerle T-PHY software
role switch; host mode enumerates a USB flash drive, dynamic host->device
switching remains unstable and is not used.
---
 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts | 39 +++++++++++++++++----
 1 file changed, 29 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index 000000000000..000000000000 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -375,6 +375,13 @@
 				      <&mt6370_adc MT6370_CHAN_IBUS>,
 				      <&mt6370_adc MT6370_CHAN_IBAT>;
 
+			mt6370_otg_vbus: usb-otg-vbus-regulator {
+				regulator-name = "mt6370-usb-otg-vbus";
+				regulator-min-microvolt = <4350000>;
+				regulator-max-microvolt = <5800000>;
+				regulator-min-microamp = <500000>;
+				regulator-max-microamp = <3000000>;
+			};
 		};
 
 		/*
@@ -689,18 +696,28 @@
 };
 
 /*
- * USB: the port is USB 2.0 only on this board (no SuperSpeed pairs), and the
- * data role is fixed to peripheral so that the kernel exposes a UDC and the
- * userspace can bring up an RNDIS/CDC-Ether gadget - the only interactive
- * channel we have until a rootfs boots on its own.
+ * USB: the port is USB 2.0 only on this board (no SuperSpeed pairs).
+ * Keep peripheral as the default role so the RNDIS/CDC-Ether gadget stays
+ * available; software role switching in the T-PHY allows switching to host
+ * at runtime. The Type-C TCPC is still disabled and does not drive VBUS, so
+ * host mode currently needs a self-powered device/hub.
  */
 &ssusb {
 	status = "okay";
-	dr_mode = "peripheral";
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 	vusb33-supply = <&mt6358_vusb_reg>;
+	vbus-supply = <&mt6370_otg_vbus>;
 	maximum-speed = "high-speed";
 	mediatek,u3p-dis-msk = <1>;
 	wakeup-source;
+
+	port {
+		ssusb_ep: endpoint {
+			remote-endpoint = <&u2port0_ep>;
+		};
+	};
 };
 
 &usb_host {
@@ -710,7 +727,14 @@
 
 &u2port0 {
 	mediatek,pre-emphasis = <3>;
+	mediatek,software-role-switch;
 	status = "okay";
+
+	port {
+		u2port0_ep: endpoint {
+			remote-endpoint = <&ssusb_ep>;
+		};
+	};
 };
 
