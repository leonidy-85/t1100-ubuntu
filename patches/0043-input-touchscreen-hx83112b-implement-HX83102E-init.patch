From a0e343d40aaeae5a1ffdcbe84d75ceca8c50ec25 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Wed, 11 Nov 2026 16:50:47 +0300
Subject: [PATCH] input: touchscreen: hx83112b: implement the HX83102E init and
 frame path

Follow docs/touch-hx83102e.md (v2, from the disassembled vendor driver):

 - Frame path: the 83102E slot is a plain register burst read of the 8-bit
   sub-address 0x30 (0xA9A450), not the generic path that first writes 0x11.
   Use himax_bus_read() instead of regmap_raw_read(): regmap always puts a
   four-byte register on the wire, which lands in the AHB window instead.

 - sense_on (0xA9A068): AHB write 0x9000005c = 0, 10 ms, then the pin
   reset (5 ms low, 50 ms settle) and poll 0x900000a8 for 0x05.  The chip
   spends its whole init in save mode and only starts reporting after this.
   Verified on the board: with the chip put into save mode by hand
   (AHB 0x9000005c = 0xa5 -> reads back 0x87) the interrupts stop
   completely, and this probe brings back both 0x5c = 0 and the reports.

 - AHB write is ONE i2c transaction of nine bytes (sub 0x00, address LE32,
   data LE32), as hx83102_register_write() does; add the helper for it.

 - Checksum: accept the vendor rule as well - a 16-bit sum over the bytes
   up to the first zero byte - because the report block is zero-terminated.

Measured after this change (boot_ubuntu34): one report per interrupt,
idle frame is 14 x "00 03 00 00" (sum 0x2a), a frame read between two
reports returns zeros (the block is consumed), and no tap changes it:
the controller reports, but does not see the finger yet.
---
 drivers/input/touchscreen/himax_hx83112b.c | 131 ++++++++++++++++++++-
 1 file changed, 125 insertions(+), 6 deletions(-)

diff --git a/drivers/input/touchscreen/himax_hx83112b.c b/drivers/input/touchscreen/himax_hx83112b.c
index aef70f5cf..e43c29b3b 100644
--- a/drivers/input/touchscreen/himax_hx83112b.c
+++ b/drivers/input/touchscreen/himax_hx83112b.c
@@ -24,6 +24,7 @@
 #include <linux/mutex.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
 
 #define HIMAX_MAX_POINTS		10
 
@@ -63,6 +64,7 @@ static_assert(sizeof(struct himax_event) == 56);
 struct himax_ts_data;
 struct himax_chip {
 	u32 id;
+	bool sense_on;
 	int (*check_id)(struct himax_ts_data *ts);
 	int (*read_events)(struct himax_ts_data *ts, struct himax_event *event,
 			   size_t length);
@@ -289,13 +291,28 @@ static bool himax_verify_checksum(struct himax_ts_data *ts,
 	for (i = 0; i < sizeof(*event); i++)
 		checksum += data[i];
 
-	if ((checksum & 0x00ff) != 0) {
-		dev_err_ratelimited(&ts->client->dev,
-				    "Wrong event checksum: %04x\n", checksum);
-		return false;
+	if ((checksum & 0x00ff) == 0)
+		return true;
+
+	/*
+	 * The vendor validation for this family is not the plain byte sum of
+	 * all 56: it is a 16-bit sum over the bytes up to the first zero byte
+	 * (the report block is zero-terminated).  Accept a frame that passes
+	 * either rule; a frame that passes neither is only noise.
+	 */
+	{
+		u16 sum16 = 0;
+
+		for (i = 0; i < sizeof(*event) && data[i] != 0x00; i++)
+			sum16 += data[i];
+
+		if (sum16 == 0)
+			return true;
 	}
 
-	return true;
+	dev_err_ratelimited(&ts->client->dev,
+			    "Wrong event checksum: %04x\n", checksum);
+	return false;
 }
 
 static int himax_read_events(struct himax_ts_data *ts,
@@ -305,12 +322,107 @@ static int himax_read_events(struct himax_ts_data *ts,
 			       length);
 }
 
+/*
+ * HX83102E (slot 0xA9A450 in the vendor driver): a plain register burst read
+ * of the 8-bit sub-address 0x30, no 0x11 pointer reset (that belongs to the
+ * generic callback used by the other ICs).
+ */
+static int hx83102e_read_events(struct himax_ts_data *ts,
+				struct himax_event *event, size_t length)
+{
+	return himax_bus_read(ts, 0x30, event, length);
+}
+
 static int hx83100a_read_events(struct himax_ts_data *ts,
 				struct himax_event *event, size_t length)
 {
 	return himax_bus_read(ts, HX83100A_REG_FW_EVENT_STACK, event, length);
 };
 
+/*
+ * Single-byte write to an 8-bit sub-address (the vendor's himax_bus_write
+ * with a one-byte payload).  regmap cannot be used for this: with
+ * val_bits = 32 it always puts four bytes on the wire.
+ */
+static int himax_bus_write_u8(struct himax_ts_data *ts, u8 sub, u8 val)
+{
+	u8 buf[2] = { sub, val };
+	struct i2c_msg msg = {
+		.addr = ts->client->addr,
+		.len = sizeof(buf),
+		.buf = buf,
+	};
+
+	if (i2c_transfer(ts->client->adapter, &msg, 1) != 1)
+		return -EIO;
+
+	return 0;
+}
+
+/*
+ * AHB write: one i2c transaction, sub-address 0x00, then the 32-bit AHB
+ * address and the 32-bit value, both little-endian
+ * (himax_mcu_register_write -> hx83102_register_write):
+ *
+ *     W 00 <addr LE4> <data LE4>
+ */
+static int himax_ahb_write(struct himax_ts_data *ts, u32 addr, u32 val)
+{
+	u8 buf[9];
+	struct i2c_msg msg = {
+		.addr = ts->client->addr,
+		.len = sizeof(buf),
+		.buf = buf,
+	};
+
+	buf[0] = 0x00;
+	put_unaligned_le32(addr, &buf[1]);
+	put_unaligned_le32(val, &buf[5]);
+
+	if (i2c_transfer(ts->client->adapter, &msg, 1) != 1)
+		return -EIO;
+
+	return 0;
+}
+
+/*
+ * hx83102e_sense_on(): the controller spends its whole init in save mode and
+ * only starts reporting after "AHB 0x9000005c = 0", 10 ms, then a pin reset
+ * and the FW reload that follows it.  Without this the event stack at 0x30
+ * reads back all zero while ICID and the FW status look perfectly healthy.
+ */
+static int himax_sense_on(struct himax_ts_data *ts)
+{
+	struct device *dev = &ts->client->dev;
+	u32 st = 0;
+	int i, error;
+
+	/* himax_mcu_burst_enable() runs first in the vendor sequence */
+	himax_bus_write_u8(ts, 0x13, 0x31);
+	himax_bus_write_u8(ts, 0x0d, 0x10);
+
+	error = himax_ahb_write(ts, 0x9000005c, 0x00000000);
+	if (error)
+		return error;
+	msleep(10);
+
+	/* himax_mcu_pin_reset(): 5 ms low, then wait for the FW */
+	gpiod_set_value_cansleep(ts->gpiod_rst, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ts->gpiod_rst, 0);
+	usleep_range(50000, 50100);
+
+	for (i = 0; i < 50; i++) {
+		if (!himax_bus_read(ts, 0x900000a8, &st, sizeof(st)) &&
+		    (st & 0xff) == 0x05)
+			return 0;
+		msleep(10);
+	}
+
+	dev_warn(dev, "sense on: FW did not report reload (0x%08x)\n", st);
+	return -ETIMEDOUT;
+}
+
 static int himax_handle_input(struct himax_ts_data *ts)
 {
 	int error;
@@ -431,6 +543,12 @@ static int himax_probe(struct i2c_client *client)
 			return error;
 	}
 
+	if (ts->chip->sense_on) {
+		error = himax_sense_on(ts);
+		if (error)
+			return error;
+	}
+
 	error = himax_input_register(ts);
 	if (error)
 		return error;
@@ -493,8 +611,9 @@ static const struct himax_chip hx83100a_chip = {
  */
 static const struct himax_chip hx83102e_chip = {
 	.id = 0x83102e,
+	.sense_on = true,
 	.check_id = himax_check_product_id,
-	.read_events = himax_read_events,
+	.read_events = hx83102e_read_events,
 };
 
 static const struct himax_chip hx83112b_chip = {
-- 
2.53.0

