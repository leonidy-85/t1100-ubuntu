From 9d385e70e00ae67f3010aaa4a6af56f50a58e6af Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Mon, 2 Nov 2026 21:00:55 +0300
Subject: [PATCH] arm64: dts: t1100: keep the LCM DVDD rail and its I2C
 shifters on

GPIO55 is not only the panel DVDD switch: the vendor ODM node
(refs/device/fdt-live.dts.gz, odm/lcm, dvdd-gpios = <&pio 55>) and the
board comment above /odm both describe it as the rail that feeds the
I2C level shifters, so nothing on i2c0..6 enumerates while it is off.
Today the rail only survives because LK turns it on and the command
line carries regulator_ignore_unused.

Mark the fixed regulator boot-on and always-on, like the vendor tree
which never gates it. This also makes it safe for the panel driver to
claim dvdd as a supply: ->unprepare() must not be able to cut I2C to
the IT6112 bridge that drives the panel.
---
 arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index b7bc60dbf..926ee0558 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -127,13 +127,21 @@ i2c_vbus: regulator-i2c-vbus {
 		regulator-boot-on;
 	};
 
-	/* LCM DVDD switch, GPIO55 (stock odm/lcm: dvdd-gpios = <&pio 55>). */
+	/*
+	 * LCM DVDD switch, GPIO55 (stock odm/lcm: dvdd-gpios = <&pio 55>).
+	 * The vendor tree never gates this rail: besides the panel DVDD it also
+	 * feeds the I2C level shifters, so i2c0..6 stop enumerating as soon as
+	 * it is off. Keep it on; ->prepare()/->unprepare() of the panel must not
+	 * be able to cut I2C to the IT6112 bridge itself.
+	 */
 	panel_dvdd: regulator-dvdd-panel {
 		compatible = "regulator-fixed";
 		regulator-name = "vreg_panel_dvdd";
 		regulator-enable-ramp-delay = <10>;
 		gpio = <&pio 55 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
 	};
 
 	/* Main rail feeding the MT6358 bucks on this board. */
-- 
