From 586cb030128c0dc2d17f99f4bd4500dc22602ec7 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Fri, 30 Oct 2026 17:47:12 +0300
Subject: [PATCH t1100 12/19] arm64: dts: t1100: register every MT6358 rail and
 the MFG power domains

Two independent defects kept eMMC, USB and the whole MM stack out of the
kernel:

 * vgpu/vsram_gpu were tied together with regulator-coupled-with. The
   generic coupler only accepts always-on regulators
   (drivers/regulator/core.c: "Coupling of a non always-on regulator is
   unimplemented"), so mt6358_regulator_probe() failed on VGPU with
   -EOPNOTSUPP and *no* MT6358 rail was registered. Everything that needs
   VEMC/VIO18/VUSB/VGPU then deferred forever. Drop the coupling and let
   panfrost order the rails itself: mali-supply = VGPU, sram-supply =
   VSRAM_GPU, exactly as in refs/affenull-mt6771 (the MT6771 mainline
   port that runs on this SoC).

 * The two MFG power domains carry MTK_SCPD_DOMAIN_SUPPLY, and since 6.12
   mtk-pm-domains looks the supply up in the domain node itself. Only
   power-domain@3 (MFG) had domain-supply, so scpsys_probe() failed on
   power-domain@2 (MFG_ASYNC) and the power-controller never registered -
   mutex, ovl, rdma, dsi, larb*, smi, pwm and mfgcfg all deferred.
   mt8183-kukui.dtsi uses MFG_ASYNC=vSram_gpu / MFG=vGPU on the same PMIC.

Also re-enable msdc0 (eMMC), msdc1, ssusb (dr_mode=peripheral, for the RNDIS
gadget) and the xhci node, and mark the rails the vendor 4.14 driver refuses
to disable (VDRAM2, VBIF28, VAUX18, VIO28, VAUD28) as always-on: mainline's
regulator_late_cleanup() switches off any enabled rail without a consumer,
and VDRAM2 is the LPDDR4X 1.1 V rail while VBIF28 is the DRAM interface
bias - cutting them freezes the SoC before anything can be printed.

The GPU itself stays disabled: nothing in the eMMC/USB/KDE path needs MFG.

Signed-off-by: bringup <bringup@t1100.local>
---
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 63 ++++++++++++++++++-
 1 file changed, 60 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index a75445bd6..988f8a3a3 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -368,15 +368,44 @@ &usb_host {
 
 &u2port0 {
 	mediatek,pre-emphasis = <3>;
+	status = "okay";
 };
 
 /*
  * GPU: Mali-G72 MP3, identical core to MT8183, so panfrost binds through
- * "mediatek,mt8183b-mali". VGPU comes from the MT6358 buck, coupled to
- * VSRAM_GPU as on the reference port.
+ * "mediatek,mt8183b-mali". VGPU is the buck that feeds the shader cores,
+ * VSRAM_GPU its SRAM rail; panfrost enables sram first and raises VGPU
+ * afterwards (panfrost_regulator_init()), which is why the two rails are
+ * described as separate supplies instead of being tied together with
+ * regulator-coupled-with. The generic coupler only accepts *always-on*
+ * regulators (drivers/regulator/core.c: "Coupling of a non always-on
+ * regulator is unimplemented"), and mt6358_regulator_probe() aborts on the
+ * first rail it cannot register - one -ENOTSUPP for VGPU therefore removed
+ * *every* MT6358 rail, which is what kept eMMC, USB and the whole MM stack
+ * in deferred probe. Same wiring as refs/affenull-mt6771 (MT6771 upstream
+ * port) and mt8183-kukui.dtsi.
+ *
+ * Still off: enabling the GPU powers up MFG, which is not needed for
+ * eMMC/USB/KDE bring-up and is the only consumer that writes the MFG
+ * registers nobody has verified on MT6771 yet.
  */
 &gpu {
 	mali-supply = <&mt6358_vgpu_reg>;
+	sram-supply = <&mt6358_vsram_gpu_reg>;
+	status = "disabled";
+};
+
+/*
+ * The two MFG power domains carry MTK_SCPD_DOMAIN_SUPPLY, and since 6.12
+ * mtk-pm-domains looks the regulator up in the *domain* node itself
+ * (drivers/pmdomain/mediatek/mtk-pm-domains.c, "Find regulator in current
+ * power domain node"). Without the property the lookup fails and
+ * scpsys_probe() returns an error, so the power-controller never registers -
+ * and then mutex, ovl, rdma, dsi, larb*, smi, pwm and mfgcfg all defer
+ * forever. mt8183-kukui.dtsi uses exactly this assignment on the same PMIC.
+ */
+&mfg_async {
+	domain-supply = <&mt6358_vsram_gpu_reg>;
 };
 
 &mfg {
@@ -394,11 +423,39 @@ &mt6358_vsram_gpu_reg {
 	regulator-always-on;
 };
 
-/* LPDDR4X 1.1 V rail. */
+/*
+ * Rails the bootloader leaves enabled and that must never be switched off by
+ * the kernel. The evidence is the vendor driver itself: in the stock 4.14 boot
+ * log (refs/stock-mt6771.dts era) mt6358 refuses to disable VDRAM1, VCORE,
+ * VPROC12, VS2, VMODEM, VS1, VDRAM2, VIO18, VSRAM_OTHERS, VXO22, VAUX18,
+ * VBIF28, VSRAM_PROC12, VIO28, VA12 and VAUD28
+ * ("mt6358_regulator_disable:VDRAM2 should not be disable.(use_count=0)").
+ * mt6358.dtsi in mainline already marks most of them always-on; the five
+ * missing ones are listed here. VDRAM2 is the LPDDR4X 1.1 V rail and VBIF28
+ * the DRAM interface bias - mainline's regulator_late_cleanup() disables any
+ * enabled rail that has no consumer in DT, and cutting either of those two
+ * freezes the SoC before anything can be printed.
+ */
 &mt6358_vdram2_reg {
 	regulator-always-on;
 };
 
+&mt6358_vbif28_reg {
+	regulator-always-on;
+};
+
+&mt6358_vaux18_reg {
+	regulator-always-on;
+};
+
+&mt6358_vio28_reg {
+	regulator-always-on;
+};
+
+&mt6358_vaud28_reg {
+	regulator-always-on;
+};
+
 &mt6358regulator {
 	vsys-ldo1-supply = <&reg_vsys>;
 	vsys-ldo2-supply = <&reg_vsys>;
-- 
2.53.0

