From c893a141424489f1e85c4a47610ffc53fda66dd5 Mon Sep 17 00:00:00 2001
From: bringup <bringup@t1100.local>
Date: Mon, 2 Nov 2026 21:01:23 +0300
Subject: [PATCH] arm64: dts: t1100: enable the DSI0 display path and the
 IT6112 panel

With the panel driver in place the only thing missing for CRTC 0 is
dsi0: mediatek-drm does not describe the pipeline in DT, it walks the
static mt8183 main path (drivers/gpu/drm/mediatek/mtk_drm_drv.c:143)

  OVL0 -> OVL_2L0 -> RDMA0 -> COLOR0 -> CCORR -> AAL0 -> GAMMA ->
  DITHER0 -> DSI0

and refuses to create a CRTC as soon as one of those nodes is not
available (mtk_crtc_create(): "Not creating crtc %d because component
%d is disabled or missing"). All of them come from mt8183.dtsi and are
enabled there; only dsi0 carries status = "disabled". That is exactly
the failure in the last boot log (component 14 = DDP_COMPONENT_DSI0,
then component 10 = DPI0 for the unused ext path, then "Need at least
one OVL device").

So: enable dsi0 (and spell out mipi_tx0, which is already enabled by
default), and enable panel@56 on i2c3. The panel registers its DSI
peripheral on dsi0 through the graph, which is what makes mtk_dsi add
its component (mtk_dsi_host_attach() -> component_add()), i.e. no panel
means no CRTC at all.

Nothing else is needed: the clock tree, the power domain
(MT8183_POWER_DOMAIN_DISP via scpsys), the larb/iommu port ids, the
mmsys routing table, the disp-mutex and the GCE client regions are all
inherited from mt8183.dtsi and already bind on this board.

Existing i2c3 users stay as they are: the IT66121 HDMI bridge has no
driver in 6.12 and is not described.
---
 .../boot/dts/mediatek/mt6771-fplus-t1100.dts  | 29 +++++++++++++------
 1 file changed, 20 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
index e948e27ed..ac89c50fa 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-fplus-t1100.dts
@@ -216,11 +216,11 @@ touchscreen@48 {
 };
 
 /*
- * I2C3: IT6112 MIPI-DSI to LVDS bridge for the panel (@0x56) and the
- * IT66121 HDMI bridge (@0x4c). Both need drivers that 6.12 does not have
- * (the IT6112 one is a WIP patch in refs/it6112 and
- * refs/mt6771-next/patches/083d4e7fa2), so the bus is enabled but the
- * devices are not.
+ * I2C3: IT6112 MIPI-DSI to dual-DSI bridge for the panel (@0x56) and the
+ * IT66121 HDMI bridge (@0x4c). Only the panel is described: its driver
+ * registers the DSI peripheral on dsi0 and the MIPI RX half of the bridge as
+ * a dummy client at 0x5e on this same adapter. The IT66121 has no driver in
+ * 6.12 and stays out.
  */
 &i2c3 {
 	vbus-supply = <&i2c_vbus>;
@@ -230,7 +230,7 @@ panel: panel@56 {
 		compatible = "boe,tv110xum-lb2-it6112";
 		reg = <0x56>;
 
-		status = "disabled";
+		status = "okay";
 
 		width-mm = <166>;
 		height-mm = <226>;
@@ -623,10 +623,21 @@ home {
 };
 
 /*
- * Display is described but switched off: mmsys/ovl/rdma/dsi/mipi_tx0 nodes
- * come from mt8183.dtsi, and the only missing piece for 1600x2176 DSI output
- * is the IT6112 panel driver. Enable dsi0 together with panel@56.
+ * Display: mmsys/ovl/rdma/color/ccorr/aal/gamma/dither/dsi/mipi_tx0 all come
+ * from mt8183.dtsi and only dsi0 is disabled there, so the whole static
+ * mt8183 main path (OVL0 -> OVL_2L0 -> RDMA0 -> COLOR0 -> CCORR -> AAL0 ->
+ * GAMMA -> DITHER0 -> DSI0) is already described. Enabling dsi0 is what makes
+ * mediatek-drm create CRTC 0; the connector comes from panel@56, which
+ * registers its DSI peripheral on this host.
  */
+&mipi_tx0 {
+	status = "okay";
+};
+
+&dsi0 {
+	status = "okay";
+};
+
 &dsi_out {
 	remote-endpoint = <&panel_in>;
 };
-- 
2.53.0

