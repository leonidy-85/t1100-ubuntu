# Kconfig fragment: Fplus T1100 (MT6771) bring-up kernel with real drivers.
#
# This is the "second stage" fragment: unlike the first boot-chain test it
# enables the actual hardware the tablet needs to reach userspace (clocks,
# pinctrl, PMIC, eMMC, USB, IOMMU, DRM, GPU). It is applied on top of the
# arm64 defconfig with:
#
#   ARCH=arm64 scripts/kconfig/merge_config.sh -O build/full \
#       build/full/.config configs/t1100.fragment
#   make ARCH=arm64 ... olddefconfig
#
# and the resulting .config is what configs/t1100_defconfig (savedefconfig
# format) reproduces one-to-one.
#
# Everything is built in (=y, not =m): there are no modules in the initramfs
# and no rootfs yet, so a deferred/module driver is an invisible driver.

# --- platform ---------------------------------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=10

# --- clocks, power, pinctrl (MT8183 drivers, see docs/bringup-log.md) -------
CONFIG_COMMON_CLK_MT8183=y
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_INFRACFG=y
CONFIG_PINCTRL_MT8183=y
CONFIG_PINCTRL_MTK=y

# --- PMIC (MT6358 behind pwrap) --------------------------------------------
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_REGULATOR=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_GPIO=y
# uinput: инъекция ввода для автопроверок на живой сессии (ydotool). Нужен,
# чтобы отделить «шейдерный» таймаут панофроста от гонки с devfreq: клик по
# play без него не сделать (wtype не работает — KWin без virtual-keyboard-v1).
# См. docs/panfrost-plan.md, раздел 18.11.
CONFIG_INPUT_UINPUT=y

# --- storage (eMMC boot device + microSD) ----------------------------------
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y

# squashfs: нужен snapd (Ubuntu 26.04 ставит firefox/chromium только как
# snap). Образы snap сжаты xz/zstd, а не gzip: без этих декомпрессоров
# mount падает с «wrong fs type, bad option, bad superblock on /dev/loop0»
# (проверено, docs/browser.md). Патч действует после пересборки ядра.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y

# --- I2C / GPIO -------------------------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y
CONFIG_GPIOLIB=y

# --- console / ramoops ------------------------------------------------------
# No UART is routed on this tablet: the log channel is ramoops in RAM
# (read back from Aurora/recovery via /sys/fs/pstore).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MEDIATEK_WATCHDOG=y

# --- USB: peripheral only, so that userspace can bring up RNDIS ------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ECM=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_USBNET=y

# --- IOMMU / SMI (m4u + larb0..6) ------------------------------------------
CONFIG_MTK_IOMMU=y
CONFIG_MTK_SMI=y

# --- display + GPU ----------------------------------------------------------
# DRM_MEDIATEK is needed for the DSI path; DRM_PANFROST for the Mali-G72.
# Note: the IT6112 panel driver is not in mainline (dsi0/panel stay disabled
# in the DTS until it is ported), but the drivers are built in now.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_PANFROST=y
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# --- initramfs / devtmpfs ---------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- deliberately off -------------------------------------------------------
# SVS writes DVFS/PMIC registers from efuse calibration of unknown MT6771
# layout; CCI devfreq and mediatek-cpufreq have no MT6771 support in 6.12;
# simpledrm is replaced by real DRM/KMS.
# CONFIG_MTK_SVS is not set
# CONFIG_ARM_MEDIATEK_CCI_DEVFREQ is not set
# CONFIG_DRM_SIMPLEDRM is not set

# --- display: panel power (MT6370 DSV) + IT6112/BOE panel (phase 2) ----------
# VPOS/VNEG for the LCM come from the MT6370 DSV regulators; the panel itself is
# a BOE TV110XUM-LB2 behind an ITE IT6112 MIPI-DSI bridge (i2c3 0x56/0x5e).
CONFIG_MFD_MT6370=y
CONFIG_REGULATOR_MT6370=y
CONFIG_DRM_PANEL_IT6112_BOE_TV110XUM_LB2=y

# --- bring-up debug: userspace access to SoC registers ----------------------
# devmem access is needed to inspect the DSI/RDMA/OVL registers while the
# display pipeline does not produce a picture; STRICT_DEVMEM stays off so that
# io-mapped (non-RAM) ranges are readable.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- battery charging: MT6370 charger + Type-C (sink only) -------------------
# The vendor kernel charges through the MT6370 charger and a vendor charging
# framework; mainline has mt6370-charger + tcpci_mt6370. Without the ADC cell
# the charger driver defers forever (it gets VBUS/IBUS/IBAT via IIO), and with
# TYPEC=m (no modules in the image) the tcpm stack cannot be built in.
CONFIG_CHARGER_MT6370=y
CONFIG_MEDIATEK_MT6370_ADC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6370=y

# --- fuel gauge: minimal MT6358 port (patches/0072) --------------------------
# The stock MT6358 gauge is not in mainline.  The MT6359 AUXADC driver also
# covers MT6358 and exposes BATADC (BATSNS/3) through IIO; the gauge driver
# reads that channel and the FGADC current register through the PMIC regmap.
# Without MEDIATEK_MT6359_AUXADC the gauge defers and mt6370-battery keeps its
# OCV fallback.
CONFIG_MEDIATEK_MT6359_AUXADC=y
CONFIG_MT6358_GAUGE=y

# --- input: Himax HX83102E in-cell touch controller (i2c0 0x48) --------------
# The panel's digitizer is a Himax HX83102E (ICID 0x83102e read over the AHB
# window at 0x900000d0), which is register-compatible with the hx83112b
# driver. Without the driver the i2c client 0-0048 exists but nothing binds.
CONFIG_TOUCHSCREEN_HIMAX_HX83112B=y

# --- sensors: InvenSense ICM-42607-P (accel + gyro, i2c1 0x68) ---------------
# The ICM-42607-P has its own register map (DEVICE_CONFIG at 0x01, not 0x11)
# and is not supported by inv_icm42600. Patch 0054 backports the upstream
# inv_icm42607 driver. The driver is built in: the image has no /lib/modules.
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_INV_ICM42607_I2C=y

# --- sensors: Sensortek STK3338 light + proximity (i2c1 0x57) ----------------
# mainline stk3310 knows STK3013/3310/3311/3335 but not the STK3338 (PID 0x5B
# at register 0x3E); patch 0055 adds the ID and the DT compatible.
CONFIG_STK3310=y

# --- audio: MT6358 codec + speaker amp (machine driver from patch 0056) -----
# The MT6771 audio block at 0x11220000 is driven by the mt8183 AFE driver;
# playback goes through the MT6358 DAC and the external analog speaker amp
# (GPIO159). Route setup lives in rootfs-overlay UCM (mt6771-mt6358).
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT8183=y
CONFIG_SND_SOC_MT6358=y
CONFIG_SND_SOC_MT6771_MT6358=y

# --- CPU DVFS: use mtk-cpufreq, not cpufreq-dt -------------------------------
# MT6771 has the MT8183-style CPU DVFS controller; the board DTS supplies the
# OPP tables and proc/sram regulators. cpufreq-dt must stay off: it registers
# first and changes the CPU clock without touching vproc/vsram (undervolt hang).
CONFIG_ARM_MEDIATEK_CPUFREQ=y
# CONFIG_CPUFREQ_DT is not set
# MTK thermal: the MT6771 controller is MT8183-compatible, but the efuse
# calibration is not decoded yet (driver uses its defaults). The board DTS
# exposes only the CPU zone with 80/90/115 C trips.
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y

# --- Waydroid / Android container -------------------------------------------
# Binderfs and PSI are bool: they require the kernel Image, not modules.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=m
# Waydroid network: bridge/veth + NAT; nftables is the current default.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m

# --- USB Wi-Fi adapters (host mode; built-in CONSYS is not supported) --------
# Common mainline USB Wi-Fi drivers. Firmware comes from linux-firmware; for
# MT7601U/RT2870/RTL8XXXU, Ubuntu ships .zst firmware, so decompress it in the
# rootfs (or enable CONFIG_FW_LOADER_COMPRESS_ZSTD in a future image).
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_MT7601U=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT73USB=y
CONFIG_RT2500USB=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y
