# Minimal arm64 kernel for the T1100 boot-chain test: only console/pstore/
# initramfs support, no drivers, no modules. Goal: an Image small enough to
# rule out "lk refuses to decompress/execute a 39 MB image".
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_EFI=n
CONFIG_MODULES=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 maxcpus=1 panic=10 pstore.backend=ramoops loglevel=7"
CONFIG_PANIC_TIMEOUT=10
