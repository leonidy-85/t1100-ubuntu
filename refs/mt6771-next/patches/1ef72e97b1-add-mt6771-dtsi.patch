From 1ef72e97b1bf52beb86c4cc6cd18fb115a897d8b Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <me@adomerle.pw>
Date: Sat, 9 Aug 2025 21:55:23 +0400
Subject: [PATCH] arm64: dts: mediatek: Add MT6771

Signed-off-by: Arseniy Velikanov <me@adomerle.pw>
---
 arch/arm64/boot/dts/mediatek/mt6771.dtsi | 41 ++++++++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6771.dtsi

diff --git a/arch/arm64/boot/dts/mediatek/mt6771.dtsi b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
new file mode 100644
index 00000000000000..403fa0fed09f60
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+#include "mt8183.dtsi"
+/* cpuidle & cpufreq are broken with android firmware */
+/ {
+	compatible = "mediatek,mt6771";
+	cpus {
+		cpu@0 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@1 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@2 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@3 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@100 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@101 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@102 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		cpu@103 {
+			/delete-property/ cpu-idle-states;
+			/delete-property/ operating-points-v2;
+		};
+		/delete-node/ idle-states;
+	};
+};
