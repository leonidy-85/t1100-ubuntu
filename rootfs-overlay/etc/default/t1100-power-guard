# Настройки t1100-power-guard (страховка от глубокого разряда батареи).
# Пороги - в милливольтах (батарея 4.35 В, ~8 Ач; топливомера в mainline нет).
# Калибровка по вендорскому gauge из recovery (06.11): 3.693 В = 10 %,
# поэтому 3.6 В на выключение - это ещё ~5 % запаса, а не «в ноль».

# Ниже этого напряжения и при N подряд замерах - poweroff.
VBAT_LOW_MV=3600

# Ниже этого - предупреждение в journal (не чаще раза в 15 минут).
VBAT_WARN_MV=3720

# Выше этого метка "выключено по низкому заряду" снимается.
VBAT_OK_MV=4000

# Сколько подряд замеров (раз в минуту) нужно ниже порога.
# На зарядке порог ожидания умножается на 3.
SAMPLES=3

# Ток заряда, мкА. 0 = не трогать: с 13.11 лимиты ставит t1100-charge.service
# (профиль hub: IAICR 2500 мА, ICHG 2000 мА), а страховка только следит за vbat.
# Иначе два юнита перетирают друг друга (guard поднимал ICHG до 2 А и IAICR до 900 мА).
ICHRG_UA=0

# Лимит входного тока (IAICR), мкА. Пусто = не трогать (лимит ставит
# t1100-charge.service). Диапазон 100000..3250000, шаг 50000.
IAICR_UA=

# Яркость подсветки в процентах. Пусто = не трогать.
# На время фазы 2 (панель чёрная, светит на 100%) имеет смысл 0..30.
BRIGHTNESS_PERCENT=
