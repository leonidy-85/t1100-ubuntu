# Настройки t1100-charge.sh (лимиты зарядки MT6370 на Fplus T1100).
# Единицы — мкА (как в sysfs). Диапазоны чипа и шаги см. refs/charge-mt6370.md.

# --- профиль auto (применяется юнитом t1100-charge.service на загрузке) ---
# Ток в батарею: 2 А — вендорское значение (стоковый DTB, ichg = 0x1e8480);
# ровно его же пишет t1100-power-guard, поэтому юниты не спорят.
AUTO_ICHG_UA=2000000
# Лимит входа: 900 мА — проверено на железе (вход ≈750 мА / 3.5 Вт, в батарею
# ≈400 мА, STATUS 13.11 (18)). Вендорский дефолт регистра — 500 мА.
# Для заведомо мощного порта можно поднять до 1500000..2000000 и проверить
# фактом: t1100-charge.sh set --iaicr 1500.
AUTO_IAICR_UA=900000

# --- профиль pd (t1100-charge.sh pd) — под PD-контракт 9 В/2 А -----------
# Потолки, выше которых не идём даже если источник предлагает больше:
# 2 А входа (18 Вт при 9 В) и 2 А в батарею. Выше 2.5 А заряда без паспорта
# батареи не лезем (мягкий предел в скрипте, обходится --force).
PD_IAICR_CAP_UA=2000000
PD_ICHG_CAP_UA=2000000

# --- профиль hub (t1100-charge.sh hub) — планшет -> порт powered hub --------
# Порт self-powered хаба по BC1.2 отдаёт SDP (500 мА), драйвер MT6370 при этом
# IAICR НЕ меняет (см. refs/charge-mt6370.md): лимит остаётся тем, что записали
# мы. 900 мА проверены на железе (вход ≈750 мА / 3.5 Вт, в батарею ≈400 мА) и
# дают положительный баланс при работающей Ubuntu. Максимум ищется замерами
# tools/host/charge-sweep.sh; найденное значение вписать сюда.
HUB_IAICR_UA=900000
HUB_ICHG_UA=2000000

# --- профиль wall (t1100-charge.sh wall) — обычный зарядный адаптер --------
# Вендорские 2 А входа и 2 А в батарею; годится только для уверенного DCP.
WALL_IAICR_UA=2000000
WALL_ICHG_UA=2000000
