# Переприменить профиль заряда при каждом подключении кабеля.
#
# Зачем: IAICR/ICHG живут в регистрах MT6370 и переживают отключение, но после
# probe драйвера ICHG = 900 мА, а t1100-power-guard/ручные эксперименты могут
# оставить другие значения. Политику сайта (профиль auto) навешиваем заново на
# каждый attach — это идемпотентно и дёшево.
#
# online=1 бывает только у mt6370-charger (у mt6370-battery такого атрибута
# нет), поэтому правило не задевает батарею.
ACTION=="change", SUBSYSTEM=="power_supply", ATTR{online}=="1", \
	ENV{SYSTEMD_WANTS}+="t1100-charge-replug.service"
