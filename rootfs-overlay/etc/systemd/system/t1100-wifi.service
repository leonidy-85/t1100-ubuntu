[Unit]
Description=T1100 internal Wi-Fi (CONSYS MT6631) bring-up
Documentation=file:///usr/share/doc/t1100/wifi-port-log.md
After=systemd-modules-load.service
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# wmt_drv powers CONSYS and downloads the ROMv4 patches over BTIF/STP; the
# wlan module only registers its callback, then the ioctl starts WLAN_PROBE.
ExecStart=/sbin/modprobe wmt_drv t1100_quiet_ms=100
ExecStart=/sbin/modprobe wlan_drv_gen3 t1100_probe=0 t1100_rom_patch_mcif=0 t1100_pwr_on_done=1 t1100_readback=0 t1100_ready_rx=0 t1100_mcr_dump=0
ExecStart=/usr/local/sbin/t1100-wifi-func-on
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
