[Unit]
Description=T1100: keep USB (RNDIS/SSH) alive, no runtime autosuspend
Documentation=https://gitflic.ru/project/py6on/t1100-ubuntu
# Раньше здесь были Wants/After=sys-subsystem-usb.device: на этой плате такого
# device-юнита нет (мы gadget, а не хост), job висел вечно и юнит оставался
# inactive с "Job: N". Держим только udev-settle и небольшую паузу.
After=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/t1100-charge.sh keepalive
SyslogIdentifier=t1100-usb-keepalive

[Install]
WantedBy=multi-user.target
