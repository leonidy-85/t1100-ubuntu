[Unit]
Description=T1100: keep USB (RNDIS/SSH) alive, no runtime autosuspend
Documentation=https://gitflic.ru/project/py6on/t1100-ubuntu
After=systemd-udev-settle.service sys-subsystem-usb.device
Wants=sys-subsystem-usb.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/t1100-charge.sh keepalive
# Устройства появляются позже; повторяем один раз, чтобы не гонять юнит в цикле.
ExecStartPost=-/bin/sh -c 'sleep 5; /usr/local/bin/t1100-charge.sh keepalive'
SyslogIdentifier=t1100-usb-keepalive

[Install]
WantedBy=multi-user.target
