#!/usr/bin/env python3
import os
import select
import socket

PATHS = ("/dev/socket/logdw", "/dev/socket/logd")

sockets = []
for p in PATHS:
    try:
        os.unlink(p)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.bind(p)
    os.chmod(p, 0o666)
    sockets.append(s)

while True:
    ready, _, _ = select.select(sockets, [], [], 5)
    for s in ready:
        try:
            s.recv(8192)
        except OSError:
            pass
