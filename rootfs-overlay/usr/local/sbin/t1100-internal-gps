#!/bin/sh
# Internal MT6771 GPS: vendor mnld + gps.default HAL + NMEA socket bridge.
set -u
modprobe gps_drv

# Drop a stray HAL client from a previous manual run; two clients fight over
# mnld and make the GPS firmware assert.
pkill -f '^/system/bin/gps_hal_test' 2>/dev/null || true

mkdir -p /data/vendor/gps /data/vendor/log/gps /data/agps_supl /opt/bionic/data

mountpoint -q /opt/bionic/dev || mount --bind /dev /opt/bionic/dev
mountpoint -q /opt/bionic/proc || mount --bind /proc /opt/bionic/proc
mountpoint -q /opt/bionic/sys || mount --bind /sys /opt/bionic/sys
mountpoint -q /opt/bionic/data || mount --bind /data /opt/bionic/data

# After the bind mount /dev is devtmpfs again, so recreate the Android
# socket directory there (fake logd listens on /dev/socket/logd*).
mkdir -p /dev/socket

for _ in $(seq 1 25); do
    [ -S /dev/socket/logdw ] && break
    sleep 0.2
done

start_mnld() {
    pgrep -f '^/system/bin/mnld' >/dev/null 2>&1 && return 0
    chroot /opt/bionic /system/bin/sh -c \
        'export LD_LIBRARY_PATH=/vendor/lib:/system/lib:/vendor/lib/hw; exec /system/bin/mnld' \
        >>/tmp/mnld-internal.log 2>&1 &
}

start_mnld

# mnld can exit while CONSYS is still powering up after a cold boot; keep a
# supervisor so one early exit does not leave the HAL hanging forever.
(
    while :; do
        start_mnld
        sleep 5
    done
) &

# Wait until mnld survives a few seconds before starting the HAL.
for _ in $(seq 1 60); do
    if pgrep -f '^/system/bin/mnld' >/dev/null 2>&1; then
        pid=$(pgrep -f '^/system/bin/mnld' | head -n 1)
        sleep 3
        [ "$pid" = "$(pgrep -f '^/system/bin/mnld' | head -n 1)" ] && break
    else
        sleep 1
    fi
done

chroot /opt/bionic /system/bin/sh -c \
    'export LD_LIBRARY_PATH=/vendor/lib:/system/lib:/vendor/lib/hw; exec /system/bin/gps_hal_test' \
    | exec /usr/local/sbin/t1100-nmea-socket-batch
