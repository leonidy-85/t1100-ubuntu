#!/usr/bin/env python3
"""Paint the boot splash into /dev/fb0 before the session starts.

The kernel brings up the panel late (mediatek-drm ~12 s after boot) and the
console does not take over the framebuffer, so the screen stays black until
Phosh starts.  This runs before getty@tty1, waits for /dev/fb0 and blits the
splash once; the compositor replaces it when the session comes up.
"""
import os
import sys
import time

from PIL import Image

FB = "/dev/fb0"
SRC = "/usr/share/t1100/splash.png"
SYS = "/sys/class/graphics/fb0"


def rd(name, default):
    try:
        with open(os.path.join(SYS, name)) as f:
            return f.read().strip()
    except OSError:
        return default


def main():
    for _ in range(600):
        if os.path.exists(FB) and rd("virtual_size", "") != "":
            break
        time.sleep(0.1)
    else:
        return 0

    w, h = (int(v) for v in rd("virtual_size", "1600,2176").split(","))
    bpp = int(rd("bits_per_pixel", "32"))
    if bpp != 32:
        sys.stderr.write("unsupported bpp %d\n" % bpp)
        return 1

    img = Image.open(SRC).convert("RGB")
    if img.size != (w, h):
        img = img.resize((w, h), Image.LANCZOS)
    raw = img.tobytes("raw", "BGRX")

    try:
        with open(os.path.join(SYS, "blank"), "w") as f:
            f.write("0\n")
    except OSError:
        pass

    fd = os.open(FB, os.O_WRONLY)
    try:
        stride = int(rd("stride", str(w * 4)))
        row = w * 4
        for y in range(h):
            os.pwrite(fd, raw[y * row:(y + 1) * row], y * stride)
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
