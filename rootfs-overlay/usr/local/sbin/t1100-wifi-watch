#!/bin/sh
# Re-probe the WLAN function if wlan0 disappeared.
#
# The MT6631 firmware can assert and trigger a "whole chip reset"; wlan_drv_gen3
# then unregisters wlan0 and does not create a new netdev by itself.  A new
# WMT_OPID_WLAN_PROBE (t1100-wifi-func-on) brings it back, so restart the
# bring-up unit while the module is still loaded.
set -u

[ -e /sys/class/net/wlan0 ] && exit 0

logger -t t1100-wifi-watch "wlan0 is missing, re-probing WLAN function"
systemctl restart t1100-wifi.service

[ -e /sys/class/net/wlan0 ] || {
    logger -t t1100-wifi-watch "wlan0 still missing after re-probe"
    exit 1
}
